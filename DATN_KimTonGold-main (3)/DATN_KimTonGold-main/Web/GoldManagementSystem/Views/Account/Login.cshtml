@model GoldManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng Nhập - Hệ Thống Quản Lý Vàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
        (function() {
            var lang = localStorage.getItem("preferredLanguage") || "vi";
            document.documentElement.lang = lang;
            if (lang === "en") {
                document.documentElement.classList.add("lang-loading");
            }
        })();
    </script>
    <style>
        html.lang-loading [data-i18n] {
            opacity: 0 !important;
        }
    </style>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen p-4" style="font-family: 'Inter', sans-serif;">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
        <div class="p-8">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-yellow-500 mb-1">KIM<span class="text-slate-900">TON</span></h2>
                <p class="text-slate-500 text-sm" data-i18n data-i18n-vi="Đăng nhập bằng email hoặc số điện thoại" data-i18n-en="Sign in with email or phone number">Đăng nhập bằng email hoặc số điện thoại</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-600 p-3 rounded-lg text-sm mb-6 border border-red-100"></div>
            }

            @if (ViewBag.AccountLockedMessage != null)
            {
                <div class="bg-amber-50 text-amber-800 p-3 rounded-lg text-sm mb-6 border border-amber-200">@ViewBag.AccountLockedMessage</div>
            }

            @if (ViewBag.VerificationInfoMessage != null && Model?.RequiresVerification != true)
            {
                <div class="mb-6 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-700">
                    @ViewBag.VerificationInfoMessage
                </div>
            }

            @if (Model?.RequiresVerification == true)
            {
                <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-4 text-sm text-slate-700">
                    <p class="font-semibold text-slate-900">Bước 2: Xác nhận đăng nhập</p>
                    <p class="mt-1">Mã xác nhận đã được gửi tới kênh bạn chọn. Chỉ khi nhập đúng mã, hệ thống mới hoàn tất đăng nhập.</p>
                    <p class="mt-2 text-sm font-medium text-emerald-700">@Model.VerificationDestinationDisplay</p>
                </div>

                @if (ViewBag.VerificationInfoMessage != null)
                {
                    <div class="mb-6 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-700">
                        @ViewBag.VerificationInfoMessage
                    </div>
                }

                <form asp-action="VerifyLogin" method="post">
                    <input asp-for="VerificationFlowId" type="hidden" />
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div class="space-y-4">
                        <div>
                            <label asp-for="VerificationCode" class="block text-sm font-medium text-slate-700 mb-1">Mã xác nhận</label>
                            <input asp-for="VerificationCode" autocomplete="one-time-code"
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                   placeholder="Nhập 6 chữ số" />
                            <span asp-validation-for="VerificationCode" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div class="grid gap-3 sm:grid-cols-3">
                            <button type="submit" class="w-full py-3 bg-yellow-500 text-slate-900 font-bold rounded-xl shadow-md shadow-yellow-500/20 hover:bg-yellow-400 hover:shadow-yellow-400/40 transition-all active:scale-[0.98]">
                                Xác nhận đăng nhập
                            </button>

                            <button type="submit"
                                    asp-action="ResendLoginCode"
                                    formnovalidate
                                    class="w-full py-3 bg-white text-slate-700 font-semibold rounded-xl border border-slate-200 hover:border-yellow-300 hover:text-slate-900 hover:bg-yellow-50 transition-all active:scale-[0.98]">
                                Cấp lại mã mới
                            </button>

                            <button type="submit"
                                    asp-action="CancelLoginVerification"
                                    formnovalidate
                                    class="w-full py-3 bg-white text-rose-700 font-semibold rounded-xl border border-rose-200 hover:border-rose-300 hover:bg-rose-50 transition-all active:scale-[0.98]">
                                Hủy xác nhận
                            </button>
                        </div>

                        <a asp-action="Login" class="block text-center text-sm font-medium text-blue-600 hover:text-blue-800">
                            Quay lại nhập thông tin đăng nhập
                        </a>
                    </div>
                </form>
            }
            else
            {
                <form asp-action="Login" method="post">
                    <input asp-for="VerificationChannel" type="hidden" value="phone" />
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div class="space-y-5">
                        <div>
                            <label asp-for="Identifier" class="block text-sm font-medium text-slate-700 mb-1" data-i18n data-i18n-vi="Gmail hoặc Số Điện Thoại" data-i18n-en="Email or phone number">Gmail hoặc Số Điện Thoại</label>
                            <input asp-for="Identifier" autocomplete="username"
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                   placeholder="nhanvien@gold.vn hoặc 09xxxxxxxx" />
                            <span asp-validation-for="Identifier" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label asp-for="Password" class="block text-sm font-medium text-slate-700" data-i18n data-i18n-vi="Mật Khẩu" data-i18n-en="Password">Mật Khẩu</label>
                                <a href="#" class="text-xs text-blue-600 hover:text-blue-800 font-medium" data-i18n data-i18n-vi="Quên mật khẩu?" data-i18n-en="Forgot password?">Quên mật khẩu?</a>
                            </div>
                            <div class="relative">
                                <input asp-for="Password" autocomplete="current-password"
                                       id="login-password-input"
                                       class="w-full px-4 py-3 pr-20 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                       placeholder="••••••••" />
                                <button type="button"
                                        id="login-password-toggle"
                                        class="absolute inset-y-0 right-3 my-2 rounded-lg px-3 text-xs font-semibold text-slate-500 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-yellow-400"
                                        aria-controls="login-password-input"
                                        aria-label="Hiện mật khẩu">
                                    Hiện
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-sm font-semibold text-slate-800">Xác nhận đăng nhập</p>
                            <p class="mt-2 text-sm text-slate-600">Hệ thống sẽ ưu tiên gửi mã xác nhận 6 số tới số điện thoại đã liên kết. Nếu tài khoản chưa có số điện thoại, mã sẽ được gửi tới email.</p>
                            <p class="mt-2 text-sm text-slate-600">Tài khoản nội bộ như Nhân viên, Quản lí, Chủ chi nhánh và Admin sẽ được duy trì đăng nhập tự động sau lần xác nhận đầu tiên.</p>
                        </div>

                        <div class="flex items-center">
                            <input asp-for="RememberMe" class="w-4 h-4 text-yellow-500 border-slate-300 rounded focus:ring-yellow-400">
                            <label asp-for="RememberMe" class="ml-2 text-sm text-slate-600" data-i18n data-i18n-vi="Ghi nhớ đăng nhập" data-i18n-en="Remember me">Ghi nhớ đăng nhập</label>
                        </div>

                        <button type="submit" class="w-full py-3 bg-yellow-500 text-slate-900 font-bold rounded-xl shadow-md shadow-yellow-500/20 hover:bg-yellow-400 hover:shadow-yellow-400/40 transition-all active:scale-[0.98]" data-i18n data-i18n-vi="Đăng Nhập" data-i18n-en="Login">
                            Đăng Nhập
                        </button>

                        <p class="text-center text-xs text-slate-500 mt-4">
                            Hệ thống chỉ hoàn tất đăng nhập sau khi bạn xác nhận mã gửi tới số điện thoại hoặc email của tài khoản.
                        </p>
                    </div>
                </form>
            }
        </div>
        <div class="bg-slate-50 p-6 text-center border-t border-slate-100 rounded-b-3xl">
            <p class="text-sm text-slate-600">
                <span data-i18n data-i18n-vi="Lần đầu truy cập?" data-i18n-en="First time here?">Lần đầu truy cập?</span>
                <a href="/Account/Register" class="font-semibold text-blue-600 hover:text-blue-800" data-i18n data-i18n-vi="Tạo tài khoản ngay" data-i18n-en="Create an account">Tạo tài khoản ngay</a>
            </p>
        </div>
    </div>
    <a href="/" class="fixed top-4 left-4 p-2 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors" title="Trở về Trang Chủ">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
    </a>
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/site.js"></script>
    <script>
        (function () {
            var passwordInput = document.getElementById("login-password-input");
            var toggleButton = document.getElementById("login-password-toggle");

            if (!passwordInput || !toggleButton) {
                return;
            }

            function syncToggleLabel() {
                var isVisible = passwordInput.type === "text";
                var isEnglish = document.documentElement.lang === "en";
                var label = isVisible
                    ? (isEnglish ? "Hide" : "Ẩn")
                    : (isEnglish ? "Show" : "Hiện");
                var ariaLabel = isVisible
                    ? (isEnglish ? "Hide password" : "Ẩn mật khẩu")
                    : (isEnglish ? "Show password" : "Hiện mật khẩu");

                toggleButton.textContent = label;
                toggleButton.setAttribute("aria-label", ariaLabel);
                toggleButton.setAttribute("title", ariaLabel);
            }

            toggleButton.addEventListener("click", function () {
                passwordInput.type = passwordInput.type === "password" ? "text" : "password";
                syncToggleLabel();
            });

            syncToggleLabel();
        })();
    </script>
</body>
</html>
