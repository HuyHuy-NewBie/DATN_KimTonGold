@model GoldManagementSystem.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
    var maxBirthDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="dashboard-card profile-shell">
    <section class="profile-shell__hero">
        <div>
            <p class="profile-shell__eyebrow" data-i18n data-i18n-vi="Tài khoản của tôi" data-i18n-en="My account">Tài khoản của tôi</p>
            <h1 data-i18n data-i18n-vi="Thông tin cá nhân" data-i18n-en="Profile information">Thông tin cá nhân</h1>
            <p data-i18n data-i18n-vi="Bạn có thể cập nhật họ tên, ngày sinh và bổ sung email hoặc số điện thoại ngay tại đây. Nếu lúc đăng ký bạn chỉ nhập một kênh liên hệ, hãy thêm kênh còn lại ở form bên dưới. Các thay đổi nhạy cảm sẽ cần xác nhận để đảm bảo an toàn cho tài khoản." data-i18n-en="You can update your name, birthday, and add an email or phone number here. If you signed up with only one contact method, add the other one in the form below. Sensitive changes still require confirmation to keep your account secure.">Bạn có thể cập nhật họ tên, ngày sinh và bổ sung email hoặc số điện thoại ngay tại đây. Nếu lúc đăng ký bạn chỉ nhập một kênh liên hệ, hãy thêm kênh còn lại ở form bên dưới. Các thay đổi nhạy cảm sẽ cần xác nhận để đảm bảo an toàn cho tài khoản.</p>
        </div>

        <div class="profile-shell__summary">
            <span data-i18n data-i18n-vi="Liên hệ hiện tại" data-i18n-en="Current contact">Liên hệ hiện tại</span>
            <strong>@(Model.PhoneNumber ?? Model.Email ?? "Chưa có thông tin liên hệ")</strong>
            <small data-i18n data-i18n-vi="Tài khoản cần ít nhất email hoặc số điện thoại để đăng nhập và nhận xác nhận." data-i18n-en="The account needs at least an email or phone number for sign-in and verification.">Tài khoản cần ít nhất email hoặc số điện thoại để đăng nhập và nhận xác nhận.</small>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger"></div>
    }

    <form asp-action="Profile" method="post" class="profile-form profile-form--compact">
        <label class="admin-field profile-field">
            <span data-i18n data-i18n-vi="Gmail" data-i18n-en="Gmail">Gmail</span>
            <input asp-for="Email" type="email" autocomplete="email" class="admin-input" />
            <small class="profile-field__hint" data-i18n data-i18n-vi="Bạn có thể thêm email nếu trước đó chỉ dùng số điện thoại. Nếu đổi email, hệ thống sẽ gửi mã xác nhận 6 số tới email mới." data-i18n-en="You can add an email if you previously used only a phone number. If you change the email, the system will send a 6-digit code to the new address.">Bạn có thể thêm email nếu trước đó chỉ dùng số điện thoại. Nếu đổi email, hệ thống sẽ gửi mã xác nhận 6 số tới email mới.</small>
            <span asp-validation-for="Email" class="profile-field__error"></span>
        </label>

        <label class="admin-field profile-field">
            <span data-i18n data-i18n-vi="Họ và tên" data-i18n-en="Full name">Họ và tên</span>
            <input asp-for="FullName" autocomplete="name" class="admin-input" />
            <span asp-validation-for="FullName" class="profile-field__error"></span>
        </label>

        <label class="admin-field profile-field">
            <span data-i18n data-i18n-vi="Số điện thoại" data-i18n-en="Phone number">Số điện thoại</span>
            <input asp-for="PhoneNumber" type="tel" autocomplete="tel" class="admin-input" />
            <small class="profile-field__hint" data-i18n data-i18n-vi="Bạn có thể thêm số điện thoại nếu trước đó chỉ dùng email. Khi đổi số điện thoại, hệ thống sẽ gửi mã xác nhận 6 số trực tiếp tới số mới." data-i18n-en="You can add a phone number if you previously used only email. When you change the phone number, the system sends a 6-digit verification code directly to the new number.">Bạn có thể thêm số điện thoại nếu trước đó chỉ dùng email. Khi đổi số điện thoại, hệ thống sẽ gửi mã xác nhận 6 số trực tiếp tới số mới.</small>
            <span asp-validation-for="PhoneNumber" class="profile-field__error"></span>
        </label>

        <label class="admin-field profile-field">
            <span data-i18n data-i18n-vi="Ngày sinh" data-i18n-en="Date of birth">Ngày sinh</span>
            <input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" max="@maxBirthDate" class="admin-input" />
            <small class="profile-field__hint" data-i18n data-i18n-vi="Chạm vào ô để mở lịch và chọn ngày sinh." data-i18n-en="Tap the field to open the calendar and choose your birthday.">Chạm vào ô để mở lịch và chọn ngày sinh.</small>
            <span asp-validation-for="DateOfBirth" class="profile-field__error"></span>
        </label>

        <div class="profile-form__actions">
            <button type="submit" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Lưu thay đổi" data-i18n-en="Save changes">Lưu thay đổi</button>
            <a href="/" class="admin-button admin-button--ghost" data-i18n data-i18n-vi="Quay về trang chủ" data-i18n-en="Back to home">Quay về trang chủ</a>
        </div>
    </form>

    @if (Model.HasPendingEmailChange)
    {
        <section class="admin-section profile-pending">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Đổi email" data-i18n-en="Email change">Đổi email</p>
                    <h2 data-i18n data-i18n-vi="Yêu cầu đang chờ xác nhận" data-i18n-en="Pending confirmation">Yêu cầu đang chờ xác nhận</h2>
                </div>
            </div>
            <p class="profile-pending__text" data-i18n data-i18n-vi="Hệ thống đã gửi mã xác nhận 6 số tới email mới. Email tài khoản chỉ thay đổi sau khi bạn nhập đúng mã." data-i18n-en="A 6-digit verification code has been sent to the new email address. Your account email will only change after you enter the correct code.">Hệ thống đã gửi mã xác nhận 6 số tới email mới. Email tài khoản chỉ thay đổi sau khi bạn nhập đúng mã.</p>
            <div class="profile-pending__meta">
                <span data-i18n data-i18n-vi="Email mới đang chờ" data-i18n-en="Pending new email">Email mới đang chờ</span>
                <strong>@Model.PendingEmailDisplay</strong>
            </div>

            <form asp-action="ConfirmEmailChange" method="post" class="profile-verify-form">
                <label class="admin-field profile-field">
                    <span data-i18n data-i18n-vi="Mã xác nhận email" data-i18n-en="Email verification code">Mã xác nhận email</span>
                    <input asp-for="EmailVerificationCode" autocomplete="one-time-code" class="admin-input" />
                </label>
                <div class="admin-action-group">
                    <button type="submit" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Xác nhận email mới" data-i18n-en="Confirm new email">Xác nhận email mới</button>
                    <button type="submit"
                            asp-action="CancelEmailChange"
                            formnovalidate
                            class="admin-button admin-button--ghost"
                            data-i18n
                            data-i18n-vi="Hủy xác nhận"
                            data-i18n-en="Cancel verification">
                        Hủy xác nhận
                    </button>
                </div>
            </form>
        </section>
    }

    @if (Model.HasPendingPhoneChange)
    {
        <section class="admin-section profile-pending">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Đổi số điện thoại" data-i18n-en="Phone update">Đổi số điện thoại</p>
                    <h2 data-i18n data-i18n-vi="Nhập mã xác nhận" data-i18n-en="Enter verification code">Nhập mã xác nhận</h2>
                </div>
            </div>
            <p class="profile-pending__text" data-i18n data-i18n-vi="Hệ thống đã gửi mã xác nhận tới số điện thoại mới. Chỉ khi nhập đúng mã, số điện thoại tài khoản mới được cập nhật." data-i18n-en="The system sent a verification code to the new phone number. Your phone number will only update after the correct code is entered.">Hệ thống đã gửi mã xác nhận tới số điện thoại mới. Chỉ khi nhập đúng mã, số điện thoại tài khoản mới được cập nhật.</p>
            <div class="profile-pending__meta">
                <span data-i18n data-i18n-vi="Số điện thoại mới đang chờ" data-i18n-en="Pending new phone">Số điện thoại mới đang chờ</span>
                <strong>@Model.PendingPhoneDisplay</strong>
            </div>

            <form asp-action="ConfirmPhoneChange" method="post" class="profile-verify-form">
                <label class="admin-field profile-field">
                    <span data-i18n data-i18n-vi="Mã xác nhận" data-i18n-en="Verification code">Mã xác nhận</span>
                    <input asp-for="PhoneVerificationCode" autocomplete="one-time-code" class="admin-input" />
                </label>
                <div class="admin-action-group">
                    <button type="submit" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Xác nhận số điện thoại" data-i18n-en="Confirm phone number">Xác nhận số điện thoại</button>
                    <button type="submit"
                            asp-action="CancelPhoneChange"
                            formnovalidate
                            class="admin-button admin-button--ghost"
                            data-i18n
                            data-i18n-vi="Hủy xác nhận"
                            data-i18n-en="Cancel verification">
                        Hủy xác nhận
                    </button>
                </div>
            </form>
        </section>
    }
</div>
