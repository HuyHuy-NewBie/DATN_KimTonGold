@model GoldManagementSystem.Models.Product
@{
    ViewData["Title"] = "Xác nhận đặt hàng";
    const string fallbackImageUrl = "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1200&q=80";
    var imageUrl = Model.GalleryImages.Any() ? Model.GalleryImages.First() : fallbackImageUrl;
    var activeBranches = ViewBag.ActiveBranches as IEnumerable<GoldManagementSystem.Models.Branch> ?? Enumerable.Empty<GoldManagementSystem.Models.Branch>();
    var isDiamond = Model.IsDiamondProduct || (!string.IsNullOrWhiteSpace(Model.DiamondShape) && Model.DiamondCarat.HasValue);
}

<div class="dashboard-card profile-shell">
    <section class="profile-shell__hero">
        <div>
            <p class="profile-shell__eyebrow">
                <a href="/Products/Details/@Model.Id" class="hover:underline" data-i18n data-i18n-vi="← Quay lại chi tiết sản phẩm" data-i18n-en="← Back to details">← Quay lại chi tiết sản phẩm</a>
            </p>
            <h1 data-i18n data-i18n-vi="Xác Nhận Đặt Hàng" data-i18n-en="Confirm Order">Xác Nhận Đặt Hàng</h1>
            <p data-i18n data-i18n-vi="Vui lòng kiểm tra lại thông tin sản phẩm và cung cấp thông tin liên hệ để chúng tôi chuẩn bị đơn hàng tốt nhất cho bạn." data-i18n-en="Please review the product details and provide your contact information so we can prepare your order.">Vui lòng kiểm tra lại thông tin sản phẩm và cung cấp thông tin liên hệ để chúng tôi chuẩn bị đơn hàng tốt nhất cho bạn.</p>
        </div>
    </section>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger"></div>
    }

    <div class="checkout-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem;">
        <!-- Left: Checkout Form -->
        <div class="checkout-form-section">
            <h3 class="checkout-section-title" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;" data-i18n data-i18n-vi="Thông tin nhận hàng" data-i18n-en="Receiver Information">Thông tin nhận hàng</h3>
            <form asp-action="PlaceOrder" method="post" class="profile-form" style="max-width: 100%;">
                <input type="hidden" name="productId" value="@Model.Id" />

                <label class="admin-field profile-field">
                    <span data-i18n data-i18n-vi="Họ tên người nhận" data-i18n-en="Receiver's name">Họ tên người nhận</span>
                    <input type="text" name="customerName" value="@ViewBag.CustomerName" class="admin-input" required />
                    <span class="profile-field__error" data-valmsg-for="customerName"></span>
                </label>

                <label class="admin-field profile-field">
                    <span data-i18n data-i18n-vi="Số điện thoại" data-i18n-en="Phone number">Số điện thoại</span>
                    <input type="tel" name="customerPhone" value="@ViewBag.CustomerPhone" class="admin-input" required />
                    <span class="profile-field__error" data-valmsg-for="customerPhone"></span>
                </label>

                <label class="admin-field profile-field">
                    <span data-i18n data-i18n-vi="Chi nhánh nhận sản phẩm" data-i18n-en="Pickup branch">Chi nhánh nhận sản phẩm</span>
                    <select name="branchId" class="admin-input" required style="background-color: var(--brand-white); height: 48px; padding-inline: 1rem;">
                        @foreach (var branch in activeBranches)
                        {
                            if (branch.Id == Model.BranchId)
                            {
                                <option value="@branch.Id" selected>@branch.BranchName (@branch.Address)</option>
                            }
                            else
                            {
                                <option value="@branch.Id">@branch.BranchName (@branch.Address)</option>
                            }
                        }
                    </select>
                    <small class="profile-field__hint" data-i18n data-i18n-vi="Chúng tôi đề xuất chi nhánh có sẵn sản phẩm. Bạn có thể chọn chi nhánh khác nếu muốn nhận ở địa điểm thuận tiện hơn." data-i18n-en="We suggest the branch where the item is available. You can change to a different branch for convenience.">Chúng tôi đề xuất chi nhánh có sẵn sản phẩm. Bạn có thể chọn chi nhánh khác nếu muốn nhận ở địa điểm thuận tiện hơn.</small>
                </label>

                <div class="checkout-actions" style="margin-top: 2rem;">
                    <button type="submit" class="admin-button admin-button--primary" style="width: 100%; height: 50px; font-size: 0.95rem;" data-i18n data-i18n-vi="Xác Nhận Đặt Hàng" data-i18n-en="Place Order">Xác Nhận Đặt Hàng</button>
                    <a href="/Products/Details/@Model.Id" class="admin-button admin-button--ghost" style="width: 100%; text-align: center; margin-top: 0.5rem;" data-i18n data-i18n-vi="Hủy" data-i18n-en="Cancel">Hủy</a>
                </div>
            </form>
        </div>

        <!-- Right: Product Detail Card -->
        <div class="checkout-summary-section" style="background: var(--brand-blush); border-radius: var(--radius-card); padding: 2rem; border: 1px solid var(--brand-line); align-self: start;">
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;" data-i18n data-i18n-vi="Tóm tắt đơn hàng" data-i18n-en="Order Summary">Tóm tắt đơn hàng</h3>
            <div style="display: flex; gap: 1.25rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--brand-line);">
                <div style="width: 80px; height: 80px; border-radius: 12px; overflow: hidden; background: #fff; border: 1px solid var(--brand-line); flex-shrink: 0;">
                    <img src="@imageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='@fallbackImageUrl';" />
                </div>
                <div>
                    <h4 style="font-size: 1rem; font-weight: 600; margin: 0 0 0.25rem;" data-auto-i18n>@Model.Name</h4>
                    <p style="font-size: 0.8rem; color: var(--brand-muted); margin: 0;" data-auto-i18n>@Model.Category / @Model.GoldType</p>
                    <p style="font-size: 0.8rem; color: var(--brand-muted); margin: 0.25rem 0 0;">
                        <span data-i18n data-i18n-vi="Trọng lượng: " data-i18n-en="Weight: ">Trọng lượng: </span>
                        <strong>@(isDiamond ? (Model.DiamondCarat.HasValue ? $"{Model.DiamondCarat:0.##} ct" : $"{Model.DiamondSize:0.#} ly") : $"{Model.Weight:0.0} chỉ")</strong>
                    </p>
                </div>
            </div>

            <div style="display: grid; gap: 0.75rem; font-size: 0.9rem;">
                <div style="display: flex; justify-content: space-between;">
                    <span data-i18n data-i18n-vi="Giá bán tạm tính" data-i18n-en="Estimated Price">Giá bán tạm tính</span>
                    <strong>@((Model.SellPrice - Model.ProcessingFee).ToString("N0")) ₫</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span data-i18n data-i18n-vi="Phí chế tác (Tiền công)" data-i18n-en="Processing Fee">Phí chế tác (Tiền công)</span>
                    <strong>@Model.ProcessingFee.ToString("N0") ₫</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding-top: 1rem; border-top: 1px dashed var(--brand-line); font-size: 1.1rem; color: var(--brand-pink-primary);">
                    <span style="font-weight: 600;" data-i18n data-i18n-vi="Tổng cộng" data-i18n-en="Total Amount">Tổng cộng</span>
                    <strong style="font-size: 1.25rem;">@Model.SellPrice.ToString("N0") ₫</strong>
                </div>
            </div>

            <div style="margin-top: 1.5rem; padding: 1rem; background: var(--brand-white); border-radius: 12px; border: 1px solid var(--brand-soft-line); font-size: 0.8rem; color: var(--brand-muted); line-height: 1.5;">
                <p style="margin: 0; font-weight: 600; color: var(--brand-ink); margin-bottom: 0.25rem;" data-i18n data-i18n-vi="Lưu ý đặt hàng online:" data-i18n-en="Online ordering notice:">Lưu ý đặt hàng online:</p>
                <ul style="margin: 0; padding-left: 1rem;">
                    <li data-i18n data-i18n-vi="Đơn đặt hàng trực tuyến sẽ được giữ tại chi nhánh tối đa 3 ngày kể từ khi xác nhận." data-i18n-en="Online orders will be held at the branch for a maximum of 3 days after confirmation.">Đơn đặt hàng trực tuyến sẽ được giữ tại chi nhánh tối đa 3 ngày kể từ khi xác nhận.</li>
                    <li data-i18n data-i18n-vi="Giá sản phẩm thực tế có thể dao động nhẹ theo thị trường vàng tại thời điểm thanh toán." data-i18n-en="Actual price may fluctuate slightly according to the gold market rate at the time of payment.">Giá sản phẩm thực tế có thể dao động nhẹ theo thị trường vàng tại thời điểm thanh toán.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
