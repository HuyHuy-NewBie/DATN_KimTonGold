@{
    ViewData["Title"] = "Bảng Giá Vàng / Bạc Hôm Nay";
}
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false }
    }
</script>
@using GoldManagementSystem.Models

<div class="bg-gray-50 min-h-screen py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-900 uppercase tracking-widest relative pb-4">
                Bảng Giá Vàng & Bạc Khảo Sát
                <span class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-yellow-500"></span>
            </h1>
            <p class="mt-4 text-gray-500">Dữ liệu được cập nhật tự động từ GiaVangKimTon.com - Tỷ giá mới nhất trong tháng</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <!-- 1. Bảng Giá Vàng Trực Tiếp -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-yellow-50 flex items-center gap-2">
                    <svg class="w-6 h-6 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4z"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Tỷ Giá Vàng Hôm Nay</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-3 font-semibold">Loại Vàng</th>
                                <th class="px-6 py-3 font-semibold">Mua Vào</th>
                                <th class="px-6 py-3 font-semibold">Bán Ra</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @foreach (var rate in ViewBag.GoldRates)
                            {
                                <tr class="hover:bg-yellow-50/50 transition">
                                    <td class="px-6 py-4 font-semibold text-gray-800">@rate.Symbol</td>
                                    <td class="px-6 py-4 font-medium text-green-600">@rate.BuyPrice.ToString("N0") ₫</td>
                                    <td class="px-6 py-4 font-medium text-red-600">@rate.SellPrice.ToString("N0") ₫</td>
                                </tr>
                            }
                            @if(((List<MarketHistory>)ViewBag.GoldRates).Count == 0)
                            {
                                <tr><td colspan="3" class="px-6 py-8 text-center text-gray-400">Đang chờ cập nhật dữ liệu...</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Biểu Đồ Vàng -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Biểu Đồ Vàng (30 Ngày)</h2>
                </div>
                <div class="p-4 flex-grow relative h-64">
                    <canvas id="goldChart"></canvas>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- 3. Bảng Giá Bạc Trực Tiếp -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-gray-100 flex items-center gap-2">
                    <svg class="w-6 h-6 text-gray-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zM6.5 9a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm7 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm-2.5 4a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" clip-rule="evenodd"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Tỷ Giá Bạc Hôm Nay</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-3 font-semibold">Loại Bạc</th>
                                <th class="px-6 py-3 font-semibold">Mua Vào</th>
                                <th class="px-6 py-3 font-semibold">Bán Ra</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @foreach (var rate in ViewBag.SilverRates)
                            {
                                <tr class="hover:bg-gray-50/80 transition">
                                    <td class="px-6 py-4 font-semibold text-gray-800">@rate.Symbol</td>
                                    <td class="px-6 py-4 font-medium text-green-600">@rate.BuyPrice.ToString("N0") ₫</td>
                                    <td class="px-6 py-4 font-medium text-red-600">@rate.SellPrice.ToString("N0") ₫</td>
                                </tr>
                            }
                            @if(((List<MarketHistory>)ViewBag.SilverRates).Count == 0)
                            {
                                <tr><td colspan="3" class="px-6 py-8 text-center text-gray-400">Đang chờ cập nhật dữ liệu...</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Biểu Đồ Bạc -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Biểu Đồ Bạc (30 Ngày)</h2>
                </div>
                <div class="p-4 flex-grow relative h-64">
                    <canvas id="silverChart"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const prepareChartData = (historyList) => {
            if (!historyList || historyList.length === 0) return { labels: [], datasets: [] };
            
            // Lấy labels là các mốc thời gian duy nhất
            const timestamps = [...new Set(historyList.map(h => new Date(h.Timestamp).toLocaleDateString('vi-VN')))];
            
            // Lấy danh sách các loại (Vàng SJC, Vàng 24K...)
            const types = [...new Set(historyList.map(h => h.Symbol))];
            
            const colors = ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#8b5cf6', '#ec4899', '#14b8a6'];
            
            const datasets = types.map((type, idx) => {
                const dataPoints = timestamps.map(time => {
                    const found = historyList.find(h => new Date(h.Timestamp).toLocaleDateString('vi-VN') === time && h.Symbol === type);
                    return found ? found.SellPrice : null;
                });
                
                return {
                    label: type + ' (Bán ra)',
                    data: dataPoints,
                    borderColor: colors[idx % colors.length],
                    backgroundColor: colors[idx % colors.length],
                    tension: 0.3,
                    borderWidth: 2,
                    pointRadius: 3,
                    spanGaps: true
                };
            });
            
            return { labels: timestamps, datasets: datasets };
        };

        const rawGoldHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HistoryGold));
        const rawSilverHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HistorySilver));

        const goldData = prepareChartData(rawGoldHistory);
        const silverData = prepareChartData(rawSilverHistory);

        // Render Vàng
        const ctxGold = document.getElementById('goldChart').getContext('2d');
        new Chart(ctxGold, {
            type: 'line',
            data: goldData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
                },
                scales: {
                    y: { beginAtZero: false, ticks: { callback: function(value) { return value.toLocaleString() + 'đ'; } } }
                }
            }
        });

        // Render Bạc
        const ctxSilver = document.getElementById('silverChart').getContext('2d');
        new Chart(ctxSilver, {
            type: 'line',
            data: silverData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
                },
                scales: {
                    y: { beginAtZero: false, ticks: { callback: function(value) { return value.toLocaleString() + 'đ'; } } }
                }
            }
        });
    });
</script>
