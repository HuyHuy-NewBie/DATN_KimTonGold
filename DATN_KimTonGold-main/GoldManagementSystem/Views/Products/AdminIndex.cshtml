@model IEnumerable<GoldManagementSystem.Models.Product>
@using System.Linq
@{
    const string fallbackImageUrl = "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=640&q=80";
    var adminTitle = ViewBag.CatalogAdminTitle as string ?? "Quản lý sản phẩm";
    var adminDescription = ViewBag.CatalogAdminDescription as string ?? "Theo dõi tồn kho và thông tin sản phẩm.";
    var createLink = ViewBag.CatalogAdminCreateLink as string ?? "/Products/Create";
    var basePath = ViewBag.CatalogAdminBasePath as string ?? "/Products/AdminIndex";
    var eyebrow = ViewBag.CatalogAdminEyebrow as string ?? "Danh mục sản phẩm";
    var addLabel = ViewBag.CatalogAdminAddLabel as string ?? "Thêm sản phẩm";
    var searchPlaceholder = ViewBag.CatalogSearchPlaceholder as string ?? "Tìm tên, trạng thái, chi nhánh...";
    var isDiamondAdmin = ViewBag.IsDiamondAdmin != null && (bool)ViewBag.IsDiamondAdmin;
    ViewData["Title"] = adminTitle;

    (string Vi, string En, string Modifier) GetStatusMeta(string status)
    {
        return status switch
        {
            "Còn hàng" => ("Còn hàng", "In stock", "success"),
            "Hết hàng" => ("Hết hàng", "Out of stock", "danger"),
            "Mới" => ("Mới", "New", "info"),
            "Bán chạy" => ("Bán chạy", "Best seller", "warning"),
            _ => (status, status, "neutral")
        };
    }
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--split">
        <div>
            <p class="admin-hero__eyebrow">@eyebrow</p>
            <h1>@adminTitle</h1>
            <p class="admin-hero__text">@adminDescription</p>
        </div>

        <div class="admin-hero__actions">
            <form method="get" action="@basePath" class="admin-search-form">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="@searchPlaceholder" />
                <button type="submit" class="admin-button admin-button--secondary" data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</button>
            </form>
            <a href="@createLink" class="admin-button admin-button--primary">@addLabel</a>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-panel__body admin-panel__body--tight">
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="admin-panel__body">
        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Bộ lọc nhanh" data-i18n-en="Quick filters">Bộ lọc nhanh</p>
                    <h2 data-i18n data-i18n-vi="Tìm và lọc sản phẩm" data-i18n-en="Search and filter products">Tìm và lọc sản phẩm</h2>
                </div>
            </div>

            <form method="get" action="@basePath" class="admin-filter-grid admin-filter-grid--products">
                <label class="admin-field admin-field--product-search">
                    <span data-i18n data-i18n-vi="Tên sản phẩm" data-i18n-en="Product name">Tên sản phẩm</span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" maxlength="30" placeholder="VD: Nhẫn vàng 24k..." />
                </label>

                <label class="admin-field">
                    <span data-i18n data-i18n-vi="Danh mục" data-i18n-en="Category">Danh mục</span>
                    @Html.DropDownList("category", ViewBag.Categories as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                </label>

                <label class="admin-field">
                    <span data-i18n data-i18n-vi="Chất liệu" data-i18n-en="Material">Chất liệu</span>
                    @Html.DropDownList("goldType", ViewBag.GoldTypes as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                </label>

                <label class="admin-field">
                    <span data-i18n data-i18n-vi="Chi nhánh" data-i18n-en="Branch">Chi nhánh</span>
                    @Html.DropDownList("branchId", ViewBag.Branches as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                </label>

                @if (isDiamondAdmin)
                {
                    <label class="admin-field">
                        <span>Shape</span>
                        @Html.DropDownList("diamondShape", ViewBag.DiamondShapes as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                    </label>
                    <label class="admin-field">
                        <span>Cut</span>
                        @Html.DropDownList("diamondCut", ViewBag.DiamondCuts as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                    </label>
                    <label class="admin-field">
                        <span>Color</span>
                        @Html.DropDownList("diamondColor", ViewBag.DiamondColors as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                    </label>
                    <label class="admin-field">
                        <span>Clarity</span>
                        @Html.DropDownList("diamondClarity", ViewBag.DiamondClarities as SelectList, "-- Tất cả --", new { @class = "admin-select" })
                    </label>
                }

                <div class="admin-filter-actions">
                    <button type="submit" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Lọc sản phẩm" data-i18n-en="Apply filters">Lọc sản phẩm</button>
                    <a href="@basePath" class="admin-button admin-button--ghost" data-i18n data-i18n-vi="Xóa bộ lọc" data-i18n-en="Clear filters">Xóa bộ lọc</a>
                </div>
            </form>
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Kho dữ liệu" data-i18n-en="Inventory data">Kho dữ liệu</p>
                    <h2 data-i18n data-i18n-vi="Danh sách sản phẩm hiện có" data-i18n-en="Current products">Danh sách sản phẩm hiện có</h2>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-shell">
                    <table class="data-table data-table--products">
                        <thead>
                            <tr>
                                <th data-i18n data-i18n-vi="Ảnh" data-i18n-en="Image">Ảnh</th>
                                <th data-i18n data-i18n-vi="Sản phẩm" data-i18n-en="Product">Sản phẩm</th>
                                <th data-i18n data-i18n-vi="Chất liệu" data-i18n-en="Material">Chất liệu</th>
                                <th data-i18n data-i18n-vi="Khối lượng" data-i18n-en="Weight">Khối lượng</th>
                                @if (isDiamondAdmin)
                                {
                                    <th>4C</th>
                                }
                                <th data-i18n data-i18n-vi="Giá bán" data-i18n-en="Sell price">Giá bán</th>
                                <th data-i18n data-i18n-vi="Chi nhánh" data-i18n-en="Branch">Chi nhánh</th>
                                <th data-i18n data-i18n-vi="Trạng thái" data-i18n-en="Status">Trạng thái</th>
                                <th data-i18n data-i18n-vi="Thao tác" data-i18n-en="Actions">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var status = GetStatusMeta(item.Status);
                                var primaryImage = item.GalleryImages.FirstOrDefault() ?? fallbackImageUrl;
                                <tr>
                                    <td class="data-table__thumb-cell">
                                        <span class="data-table__product-thumb">
                                            <img src="@primaryImage"
                                                 alt="@item.Name"
                                                 loading="lazy"
                                                 onerror="this.onerror=null;this.src='@fallbackImageUrl';" />
                                        </span>
                                    </td>
                                    <td>
                                        <div class="data-table__stack">
                                            <strong data-auto-i18n>@item.Name</strong>
                                            <span data-auto-i18n>@item.Category</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <span>@item.Description</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-chip status-chip--neutral" data-auto-i18n>@item.GoldType</span>
                                    </td>
                                    <td>
                                        @(item.DiamondCarat.HasValue ? $"{item.DiamondCarat:0.##} ct" : $"{item.Weight:0.#} chỉ")
                                    </td>
                                    @if (isDiamondAdmin)
                                    {
                                        <td>
                                            <div class="data-table__stack">
                                                <span>@item.DiamondShape</span>
                                                <span>@item.DiamondCut / @item.DiamondColor / @item.DiamondClarity</span>
                                            </div>
                                        </td>
                                    }
                                    <td class="data-table__accent">@item.SellPrice.ToString("N0") ₫</td>
                                    <td data-auto-i18n>@(item.Branch?.BranchName ?? "--")</td>
                                    <td>
                                        <span class="status-chip status-chip--@status.Modifier"
                                              data-i18n
                                              data-i18n-vi="@status.Vi"
                                              data-i18n-en="@status.En">
                                            @status.Vi
                                        </span>
                                    </td>
                                    <td>
                                        <div class="admin-action-group">
                                            <a href="/Products/Edit/@item.Id" class="admin-icon-button admin-icon-button--soft" title="Sửa">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.2-7.8a2 2 0 1 1 2.83 2.83L11.83 17H9v-2.83l8.8-8.97Z" />
                                                </svg>
                                            </a>
                                            <a href="/Products/Details/@item.Id" class="admin-icon-button" title="Xem">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.46 12C3.73 7.94 7.52 5 12 5s8.27 2.94 9.54 7c-1.27 4.06-5.06 7-9.54 7s-8.27-2.94-9.54-7Z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                                                </svg>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-card">
                    <h3 data-i18n data-i18n-vi="Không tìm thấy sản phẩm nào" data-i18n-en="No products found">Không tìm thấy sản phẩm nào</h3>
                    <p data-i18n data-i18n-vi="Hãy thử đổi bộ lọc hoặc thêm sản phẩm mới vào hệ thống." data-i18n-en="Try changing the filters or add a new product to the system.">Hãy thử đổi bộ lọc hoặc thêm sản phẩm mới vào hệ thống.</p>
                </div>
            }
        </section>
    </div>
</div>
