@model IEnumerable<GoldManagementSystem.Models.Product>
@using System
@using System.Linq
@{
    var pageTitle = ViewBag.PageTitle as string ?? "Tất Cả Sản Phẩm";
    var collectionType = ViewBag.CollectionType as string ?? "All";
    var submitAction = ViewBag.SubmitAction as string ?? "Index";
    var products = (Model ?? Enumerable.Empty<GoldManagementSystem.Models.Product>()).ToList();
    var highlightNewPriority = ViewBag.HighlightNewPriority != null && (bool)ViewBag.HighlightNewPriority;
    var isNewCollection = string.Equals(collectionType, "New", StringComparison.OrdinalIgnoreCase);
    var isDiamondCollection = ViewBag.IsDiamondCollection != null && (bool)ViewBag.IsDiamondCollection;
    var basePath = string.Equals(submitAction, "Index", StringComparison.OrdinalIgnoreCase)
        ? "/Products"
        : $"/Products/{submitAction}";
    var currentCategory = Context.Request.Query["category"].ToString();
    int? currentBranchId = ViewBag.CurrentBranchId is int branchIdValue ? branchIdValue : null;
    var branchQuery = currentBranchId.HasValue && currentBranchId.Value > 0
        ? $"branchId={currentBranchId.Value}"
        : string.Empty;
    var branchQueryPrefix = string.IsNullOrWhiteSpace(branchQuery) ? string.Empty : $"?{branchQuery}";
    var branchQuerySuffix = string.IsNullOrWhiteSpace(branchQuery) ? string.Empty : $"&{branchQuery}";
    var heroFallbackImage = "data:image/svg+xml," + Uri.EscapeDataString("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 780'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#f8dbe1'/><stop offset='100%' stop-color='#efe9df'/></linearGradient></defs><rect width='1600' height='780' fill='url(#g)'/><circle cx='260' cy='180' r='170' fill='rgba(255,255,255,0.5)'/><circle cx='1340' cy='540' r='220' fill='rgba(255,255,255,0.42)'/><circle cx='980' cy='170' r='90' fill='rgba(255,255,255,0.3)'/></svg>");
    var heroFallbackScript = $"this.onerror=null;const picture=this.closest('picture');if(picture){{picture.querySelectorAll('source').forEach(source => source.remove());}}this.src='{heroFallbackImage}';";
    ViewData["Title"] = pageTitle;

    // Sử dụng chung dữ liệu banner từ trang chủ để đảm bảo hiển thị đồng bộ
    var heroSlides = isDiamondCollection
        ? new[]
        {
            new { Title = "Kim cương tuyển chọn", Image = "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=1600&q=80", MobileImage = "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=900&q=80", Link = "/Products/Diamond" },
            new { Title = "Chuẩn 4C minh bạch", Image = "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1600&q=80", MobileImage = "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=900&q=80", Link = "/Products/Diamond?diamondCut=Excellent" },
            new { Title = "Thiết kế gắn đá tinh xảo", Image = "https://images.unsplash.com/photo-1543295204-8e6d1ce24f2c?auto=format&fit=crop&w=1600&q=80", MobileImage = "https://images.unsplash.com/photo-1543295204-8e6d1ce24f2c?auto=format&fit=crop&w=900&q=80", Link = "/Products/Diamond?category=Nhẫn Kim Cương" }
        }
        : new[]
        {
            new { Title = "Khoảnh khắc yêu thương", Image = "https://cdn.hstatic.net/files/200000103143/file/2880x1040_ab05f545eadc4e18b5adba948f40a5b0.jpg", MobileImage = "https://cdn.hstatic.net/files/200000103143/file/1000x600_71cb8eb81e8646f49921feeb7fe1b8cb.jpg", Link = "/Products" },
            new { Title = "Tự hào vẻ đẹp riêng", Image = "https://cdn.hstatic.net/files/200000103143/file/2880x1040_a6969acbfde44c41871ee40477d79747.jpg", MobileImage = "https://cdn.hstatic.net/files/200000103143/file/banner_mobile_1000x600_f9d26181efe04625b479c45cf057f5b9.jpg", Link = "/Products/Gold" },
            new { Title = "Khắc dấu ấn riêng", Image = "https://cdn.hstatic.net/files/200000103143/file/banner_revise.jpg", MobileImage = "https://cdn.hstatic.net/files/200000103143/file/banner_mobile_revise.jpg", Link = "/Products?searchString=Khắc" }
        };

    var quickChips = isDiamondCollection
        ? new[]
        {
            new { Label = "Tất cả", Link = $"{basePath}{branchQueryPrefix}", IsActive = string.IsNullOrWhiteSpace(currentCategory) },
            new { Label = "Nhẫn kim cương", Link = $"{basePath}?category=Nhẫn Kim Cương{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Nhẫn Kim Cương", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Bông tai", Link = $"{basePath}?category=Bông Tai Kim Cương{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Bông Tai Kim Cương", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Dây chuyền", Link = $"{basePath}?category=Dây Chuyền Kim Cương{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Dây Chuyền Kim Cương", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Viên rời", Link = $"{basePath}?category=Kim Cương Viên{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Kim Cương Viên", StringComparison.OrdinalIgnoreCase) }
        }
        : new[]
        {
            new { Label = "Tất cả", Link = isNewCollection ? $"/Products{branchQueryPrefix}" : $"{basePath}{branchQueryPrefix}", IsActive = string.IsNullOrWhiteSpace(currentCategory) && !isNewCollection },
            new { Label = "Mới", Link = $"/Products/New{branchQueryPrefix}", IsActive = isNewCollection },
            new { Label = "Nhẫn cưới", Link = $"{basePath}?category=Nhẫn Cưới{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Nhẫn Cưới", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Dây chuyền", Link = $"{basePath}?category=Dây Chuyền{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Dây Chuyền", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Lắc tay", Link = $"{basePath}?category=Lắc Tay{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Lắc Tay", StringComparison.OrdinalIgnoreCase) },
            new { Label = "Hoa tai", Link = $"{basePath}?category=Bông Tai{branchQuerySuffix}", IsActive = string.Equals(currentCategory, "Bông Tai", StringComparison.OrdinalIgnoreCase) }
        };
}

<section class="home-stage">
    <div class="home-stage__inner">
        <div class="home-stage__frame" data-carousel="home-stage">
            <div class="home-stage__rail">
                @for (var index = 0; index < heroSlides.Length; index++)
                {
                    var slide = heroSlides[index];
                    <article class="home-stage__slide @(index == 0 ? "is-active" : string.Empty)">
                        <picture>
                            <source srcset="@slide.MobileImage" media="(max-width: 767px)" />
                            <img src="@slide.Image" alt="@slide.Title" loading="eager" fetchpriority="high" onerror="@heroFallbackScript" />
                        </picture>
                        <a href="@slide.Link" class="home-stage__clickzone" aria-label="@slide.Title"></a>
                    </article>
                }
            </div>

            <div class="home-stage__bullets">
                @for (var index = 0; index < heroSlides.Length; index++)
                {
                    <button type="button"
                            class="@(index == 0 ? "is-active" : string.Empty)"
                            data-carousel-bullet
                            aria-label="Chuyển hero @(index + 1)"></button>
                }
            </div>
        </div>
    </div>
</section>

<section class="collection-shell">
    <div class="collection-shell__inner">

        <div class="collection-meta">
            <div class="collection-meta__chips">
                @foreach (var chip in quickChips)
                {
                    <a href="@chip.Link" class="collection-chip @(chip.IsActive ? "is-active" : string.Empty)" data-auto-i18n>@chip.Label</a>
                }
            </div>
            <div class="collection-meta__stats">
                <span data-i18n data-i18n-vi="Hiển thị" data-i18n-en="Showing">Hiển thị</span>
                <strong>@products.Count</strong>
                <span data-i18n data-i18n-vi="sản phẩm" data-i18n-en="products">sản phẩm</span>
            </div>
        </div>

        @if (highlightNewPriority)
        {
            <div class="collection-highlight">
                <strong data-i18n data-i18n-vi="Ưu tiên sản phẩm mới." data-i18n-en="New arrivals first.">Ưu tiên sản phẩm mới.</strong>
                <span data-i18n data-i18n-vi="Các sản phẩm trạng thái &quot;Mới&quot; được hiển thị trước, những sản phẩm còn lại vẫn xuất hiện ngay bên dưới." data-i18n-en="Products marked as &quot;New&quot; are shown first, while the rest remain available just below.">Các sản phẩm trạng thái "Mới" được hiển thị trước, những sản phẩm còn lại vẫn xuất hiện ngay bên dưới.</span>
            </div>
        }

        @if (isDiamondCollection)
        {
            <!-- ===== DIAMOND FILTER PANEL ===== -->
                var shapes = new[]
                {
                    new { Value = "Round",    Label = "Tròn",        Icon = "M12 2a10 10 0 1 1 0 20A10 10 0 0 1 12 2z" },
                    new { Value = "Princess", Label = "Vuông",      Icon = "M4 4h16v16H4z" },
                    new { Value = "Oval",     Label = "Oval",        Icon = "M12 3C8.13 3 5 7.03 5 12s3.13 9 7 9 7-4.03 7-9-3.13-9-7-9z" },
                    new { Value = "Emerald",  Label = "Emerald",     Icon = "M5 6h14l2 3-9 10L3 9z" },
                    new { Value = "Cushion",  Label = "Cushion",     Icon = "M6 4h12a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z" },
                    new { Value = "Pear",     Label = "Pear",        Icon = "M12 2C9 2 6 5 6 9c0 4 6 13 6 13s6-9 6-13c0-4-3-7-6-7z" },
                    new { Value = "Marquise", Label = "Marquise",    Icon = "M12 3L3 12l9 9 9-9z" },
                    new { Value = "Heart",    Label = "Heart",       Icon = "M12 21C12 21 3 14 3 8.5A5.5 5.5 0 0 1 12 5.5 5.5 5.5 0 0 1 21 8.5C21 14 12 21 12 21z" }
                };

                var colorList = new[] { "D","E","F","G","H","I","J" };
                var cutList   = new[] { "Excellent","Very Good","Good" };
                var clarityList = new[] { "IF","VVS1","VVS2","VS1","VS2","SI1","SI2" };

                string curShape   = ViewBag.CurrentDiamondShape   as string ?? "";
                string curCut     = ViewBag.CurrentDiamondCut     as string ?? "";
                string curColor   = ViewBag.CurrentDiamondColor   as string ?? "";
                string curClarity = ViewBag.CurrentDiamondClarity as string ?? "";
                decimal curMinCarat = ViewBag.CurrentMinCarat   is decimal minca ? minca : 0.17m;
                decimal curMaxCarat = ViewBag.CurrentMaxCarat   is decimal maxca ? maxca : 5.00m;
                decimal curMinPrice = ViewBag.CurrentMinPrice   is decimal minp  ? minp  : 0m;
                decimal curMaxPrice = ViewBag.CurrentMaxPrice   is decimal maxp  ? maxp  : 500000000m;
                decimal curMinSize  = ViewBag.CurrentMinSize    is decimal mins  ? mins  : 0m;
                decimal curMaxSize  = ViewBag.CurrentMaxSize    is decimal maxs  ? maxs  : 20m;

                int colorMin = string.IsNullOrEmpty(curColor)   ? 0 : Array.IndexOf(colorList, curColor);
                int colorMax = colorMin == 0 && string.IsNullOrEmpty(curColor) ? colorList.Length - 1 : colorMin;
                int cutMin   = string.IsNullOrEmpty(curCut)     ? 0 : Array.IndexOf(cutList, curCut);
                int cutMax   = cutMin == 0 && string.IsNullOrEmpty(curCut) ? cutList.Length - 1 : cutMin;
                int clarMin  = string.IsNullOrEmpty(curClarity) ? 0 : Array.IndexOf(clarityList, curClarity);
                int clarMax  = clarMin == 0 && string.IsNullOrEmpty(curClarity) ? clarityList.Length - 1 : clarMin;
                if (colorMin < 0) { colorMin = 0; colorMax = colorList.Length - 1; }
                if (cutMin   < 0) { cutMin   = 0; cutMax   = cutList.Length - 1; }
                if (clarMin  < 0) { clarMin  = 0; clarMax  = clarityList.Length - 1; }
            <div class="df-panel" id="diamond-filter-panel">
                <form method="get" action="@basePath" id="df-form">
                    @if (currentBranchId.HasValue && currentBranchId.Value > 0)
                    {
                        <input type="hidden" name="branchId" value="@currentBranchId.Value" />
                    }
                    <!-- hidden real inputs submitted to server -->
                    <input type="hidden" name="diamondShape"   id="df-shape-val"   value="@curShape" />
                    <input type="hidden" name="diamondColor"   id="df-color-val"   value="@curColor" />
                    <input type="hidden" name="diamondCut"     id="df-cut-val"     value="@curCut" />
                    <input type="hidden" name="diamondClarity" id="df-clarity-val" value="@curClarity" />
                    <input type="hidden" name="minCarat"       id="df-minCarat-val" value="@(curMinCarat > 0.17m ? curMinCarat.ToString("0.00") : "")" />
                    <input type="hidden" name="maxCarat"       id="df-maxCarat-val" value="@(curMaxCarat < 5m    ? curMaxCarat.ToString("0.00") : "")" />
                    <input type="hidden" name="minPrice"       id="df-minPrice-val" value="@(curMinPrice > 0     ? curMinPrice.ToString("0")    : "")" />
                    <input type="hidden" name="maxPrice"       id="df-maxPrice-val" value="@(curMaxPrice < 500000000m ? curMaxPrice.ToString("0") : "")" />

                    <!-- SHAPE ROW -->
                    <div class="df-section">
                        <div class="df-section__head">
                            <span class="df-section__title">Hình dáng</span>
                        </div>
                        <div class="df-shapes">
                            @foreach (var sh in shapes)
                            {
                                <button type="button"
                                        class="df-shape-btn @(string.Equals(curShape, sh.Value, StringComparison.OrdinalIgnoreCase) ? "is-active" : "")"
                                        data-shape="@sh.Value">
                                    <span class="df-shape-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="@sh.Icon"/>
                                        </svg>
                                    </span>
                                    <span class="df-shape-label">@sh.Label</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="df-sliders-grid">
                        <!-- CARAT -->
                        <div class="df-section">
                            <div class="df-section__head">
                                <span class="df-section__title">Carat</span>
                                <span class="df-section__range" id="df-carat-display">@curMinCarat.ToString("0.00") – @curMaxCarat.ToString("0.00") ct</span>
                            </div>
                            <div class="df-track-wrap">
                                <div class="df-track" id="df-carat-track"></div>
                                <input class="df-range df-range--lo" type="range" id="df-carat-lo" min="17" max="500" step="1" value="@((int)(curMinCarat * 100))" />
                                <input class="df-range df-range--hi" type="range" id="df-carat-hi" min="17" max="500" step="1" value="@((int)(curMaxCarat * 100))" />
                            </div>
                        </div>

                        <!-- COLOR -->
                        <div class="df-section">
                            <div class="df-section__head">
                                <span class="df-section__title">Màu sắc</span>
                                <span class="df-section__range" id="df-color-display">
                                    @(string.IsNullOrEmpty(curColor) ? $"{colorList[0]} – {colorList[colorList.Length-1]}" : curColor)
                                </span>
                            </div>
                            <div class="df-track-wrap">
                                <div class="df-track" id="df-color-track"></div>
                                <input class="df-range df-range--lo" type="range" id="df-color-lo" min="0" max="@(colorList.Length-1)" step="1" value="@colorMin" />
                                <input class="df-range df-range--hi" type="range" id="df-color-hi" min="0" max="@(colorList.Length-1)" step="1" value="@colorMax" />
                            </div>
                            <div class="df-tick-row">
                                @foreach (var c in colorList) { <span>@c</span> }
                            </div>
                        </div>

                        <!-- CUT -->
                        <div class="df-section">
                            <div class="df-section__head">
                                <span class="df-section__title">Chế tác (Cut)</span>
                                <span class="df-section__range" id="df-cut-display">
                                    @(string.IsNullOrEmpty(curCut) ? $"{cutList[0]} – {cutList[cutList.Length-1]}" : curCut)
                                </span>
                            </div>
                            <div class="df-track-wrap">
                                <div class="df-track" id="df-cut-track"></div>
                                <input class="df-range df-range--lo" type="range" id="df-cut-lo" min="0" max="@(cutList.Length-1)" step="1" value="@cutMin" />
                                <input class="df-range df-range--hi" type="range" id="df-cut-hi" min="0" max="@(cutList.Length-1)" step="1" value="@cutMax" />
                            </div>
                            <div class="df-tick-row">
                                @foreach (var c in cutList) { <span>@c</span> }
                            </div>
                        </div>

                        <!-- CLARITY -->
                        <div class="df-section">
                            <div class="df-section__head">
                                <span class="df-section__title">Độ tinh khiết</span>
                                <span class="df-section__range" id="df-clarity-display">
                                    @(string.IsNullOrEmpty(curClarity) ? $"{clarityList[0]} – {clarityList[clarityList.Length-1]}" : curClarity)
                                </span>
                            </div>
                            <div class="df-track-wrap">
                                <div class="df-track" id="df-clarity-track"></div>
                                <input class="df-range df-range--lo" type="range" id="df-clarity-lo" min="0" max="@(clarityList.Length-1)" step="1" value="@clarMin" />
                                <input class="df-range df-range--hi" type="range" id="df-clarity-hi" min="0" max="@(clarityList.Length-1)" step="1" value="@clarMax" />
                            </div>
                            <div class="df-tick-row">
                                @foreach (var c in clarityList) { <span>@c</span> }
                            </div>
                        </div>

                        <!-- PRICE -->
                        <div class="df-section df-section--price">
                            <div class="df-section__head">
                                <span class="df-section__title">Giá tiền</span>
                                <span class="df-section__range" id="df-price-display">@curMinPrice.ToString("N0")đ – @curMaxPrice.ToString("N0")đ</span>
                            </div>
                            <div class="df-track-wrap">
                                <div class="df-track" id="df-price-track"></div>
                                <input class="df-range df-range--lo" type="range" id="df-price-lo" min="0" max="500000000" step="1000000" value="@curMinPrice" />
                                <input class="df-range df-range--hi" type="range" id="df-price-hi" min="0" max="500000000" step="1000000" value="@curMaxPrice" />
                            </div>
                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="df-actions">
                        <a href="@($"{basePath}{branchQueryPrefix}")" class="df-reset-btn" id="df-reset">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                                <path d="M3 3v5h5"/>
                            </svg>
                            Làm mới bộ lọc
                        </a>
                        <button type="submit" class="df-apply-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                            </svg>
                            Lọc sản phẩm
                        </button>
                    </div>
                </form>
            </div>

            <script>
            (function(){
                // ── Helpers ──────────────────────────────────────────────────────
                function pct(val, min, max){ return ((val - min) / (max - min)) * 100; }
                function fmt(n){ return new Intl.NumberFormat('vi-VN').format(n); }

                // ── Shape buttons ────────────────────────────────────────────────
                var shapeBtns = document.querySelectorAll('.df-shape-btn');
                var shapeVal  = document.getElementById('df-shape-val');
                shapeBtns.forEach(function(btn){
                    btn.addEventListener('click', function(){
                        var already = btn.classList.contains('is-active');
                        shapeBtns.forEach(function(b){ b.classList.remove('is-active'); });
                        if(!already){
                            btn.classList.add('is-active');
                            shapeVal.value = btn.dataset.shape;
                        } else {
                            shapeVal.value = '';
                        }
                    });
                });

                // ── Generic dual-range slider ─────────────────────────────────
                function initRange(opts){
                    var loEl    = document.getElementById(opts.loId);
                    var hiEl    = document.getElementById(opts.hiId);
                    var track   = document.getElementById(opts.trackId);
                    var display = document.getElementById(opts.displayId);
                    var loHid   = opts.loHidden ? document.getElementById(opts.loHidden) : null;
                    var hiHid   = opts.hiHidden ? document.getElementById(opts.hiHidden) : null;

                    function update(){
                        var lo = parseFloat(loEl.value);
                        var hi = parseFloat(hiEl.value);
                        if(lo > hi){ var t=lo; lo=hi; hi=t; }
                        var min = parseFloat(loEl.min);
                        var max = parseFloat(loEl.max);
                        var l = pct(lo, min, max);
                        var r = pct(hi, min, max);
                        track.style.left  = l + '%';
                        track.style.width = (r - l) + '%';
                        if(display) display.textContent = opts.format(lo, hi);
                        if(loHid) loHid.value = opts.hidFormat ? opts.hidFormat(lo, 'lo') : lo;
                        if(hiHid) hiHid.value = opts.hidFormat ? opts.hidFormat(hi, 'hi') : hi;
                    }

                    loEl.addEventListener('input', function(){
                        if(parseFloat(loEl.value) > parseFloat(hiEl.value)) hiEl.value = loEl.value;
                        update();
                    });
                    hiEl.addEventListener('input', function(){
                        if(parseFloat(hiEl.value) < parseFloat(loEl.value)) loEl.value = hiEl.value;
                        update();
                    });
                    update();
                }

                var colorLabels   = ['D','E','F','G','H','I','J'];
                var cutLabels     = ['Excellent','Very Good','Good'];
                var clarityLabels = ['IF','VVS1','VVS2','VS1','VS2','SI1','SI2'];

                // Carat
                initRange({
                    loId:'df-carat-lo', hiId:'df-carat-hi',
                    trackId:'df-carat-track', displayId:'df-carat-display',
                    loHidden:'df-minCarat-val', hiHidden:'df-maxCarat-val',
                    format: function(lo,hi){ return (lo/100).toFixed(2)+' – '+(hi/100).toFixed(2)+' ct'; },
                    hidFormat: function(v,side){
                        var dec = (v/100).toFixed(2);
                        if(side==='lo' && parseFloat(dec)<=0.17) return '';
                        if(side==='hi' && parseFloat(dec)>=5.00) return '';
                        return dec;
                    }
                });

                // Color
                initRange({
                    loId:'df-color-lo', hiId:'df-color-hi',
                    trackId:'df-color-track', displayId:'df-color-display',
                    format: function(lo,hi){
                        if(lo===0 && hi===colorLabels.length-1) return colorLabels[0]+' – '+colorLabels[colorLabels.length-1];
                        if(lo===hi) return colorLabels[lo];
                        return colorLabels[lo]+' – '+colorLabels[hi];
                    },
                    hidFormat: function(v,side){
                        if(side==='lo'){
                            document.getElementById('df-color-val').value = '';
                            return '';
                        }
                        var lo = parseInt(document.getElementById('df-color-lo').value);
                        var hi = parseInt(document.getElementById('df-color-hi').value);
                        if(lo===0 && hi===colorLabels.length-1){ document.getElementById('df-color-val').value=''; return ''; }
                        if(lo===hi){ document.getElementById('df-color-val').value=colorLabels[lo]; }
                        else { document.getElementById('df-color-val').value=colorLabels[lo]+'–'+colorLabels[hi]; }
                        return '';
                    }
                });
                // separate color update
                ['df-color-lo','df-color-hi'].forEach(function(id){
                    document.getElementById(id).addEventListener('input', function(){
                        var lo = parseInt(document.getElementById('df-color-lo').value);
                        var hi = parseInt(document.getElementById('df-color-hi').value);
                        if(lo===0 && hi===colorLabels.length-1){ document.getElementById('df-color-val').value=''; return; }
                        if(lo===hi) document.getElementById('df-color-val').value=colorLabels[lo];
                        else document.getElementById('df-color-val').value=colorLabels[lo];
                    });
                });

                // Cut
                initRange({
                    loId:'df-cut-lo', hiId:'df-cut-hi',
                    trackId:'df-cut-track', displayId:'df-cut-display',
                    format: function(lo,hi){
                        if(lo===0 && hi===cutLabels.length-1) return cutLabels[0]+' – '+cutLabels[cutLabels.length-1];
                        if(lo===hi) return cutLabels[lo];
                        return cutLabels[lo]+' – '+cutLabels[hi];
                    }
                });
                ['df-cut-lo','df-cut-hi'].forEach(function(id){
                    document.getElementById(id).addEventListener('input', function(){
                        var lo = parseInt(document.getElementById('df-cut-lo').value);
                        var hi = parseInt(document.getElementById('df-cut-hi').value);
                        if(lo===0 && hi===cutLabels.length-1){ document.getElementById('df-cut-val').value=''; return; }
                        document.getElementById('df-cut-val').value = cutLabels[lo];
                    });
                });

                // Clarity
                initRange({
                    loId:'df-clarity-lo', hiId:'df-clarity-hi',
                    trackId:'df-clarity-track', displayId:'df-clarity-display',
                    format: function(lo,hi){
                        if(lo===0 && hi===clarityLabels.length-1) return clarityLabels[0]+' – '+clarityLabels[clarityLabels.length-1];
                        if(lo===hi) return clarityLabels[lo];
                        return clarityLabels[lo]+' – '+clarityLabels[hi];
                    }
                });
                ['df-clarity-lo','df-clarity-hi'].forEach(function(id){
                    document.getElementById(id).addEventListener('input', function(){
                        var lo = parseInt(document.getElementById('df-clarity-lo').value);
                        var hi = parseInt(document.getElementById('df-clarity-hi').value);
                        if(lo===0 && hi===clarityLabels.length-1){ document.getElementById('df-clarity-val').value=''; return; }
                        document.getElementById('df-clarity-val').value = clarityLabels[lo];
                    });
                });

                // Price
                initRange({
                    loId:'df-price-lo', hiId:'df-price-hi',
                    trackId:'df-price-track', displayId:'df-price-display',
                    loHidden:'df-minPrice-val', hiHidden:'df-maxPrice-val',
                    format: function(lo,hi){ return fmt(lo)+'đ – '+fmt(hi)+'đ'; },
                    hidFormat: function(v,side){
                        if(side==='lo' && v<=0) return '';
                        if(side==='hi' && v>=500000000) return '';
                        return v;
                    }
                });
            })();
            </script>
        }
        else
        {
            <div class="collection-filter-card">
                <form method="get" action="@basePath" class="collection-toolbar">
                    @if (currentBranchId.HasValue && currentBranchId.Value > 0)
                    {
                        <input type="hidden" name="branchId" value="@currentBranchId.Value" />
                    }
                    <div class="collection-toolbar__field collection-toolbar__field--category">
                        <label for="category" data-i18n data-i18n-vi="Danh mục" data-i18n-en="Category">Danh mục</label>
                        @Html.DropDownList("category", ViewBag.Categories as SelectList, "-- Tất cả danh mục --", new { @class = "", id = "category" })
                    </div>

                    <div class="collection-toolbar__field collection-toolbar__field--material">
                        <label for="goldType" data-i18n data-i18n-vi="Chất liệu" data-i18n-en="Material">Chất liệu</label>
                        @Html.DropDownList("goldType", ViewBag.GoldTypes as SelectList, "-- Tất cả chất liệu --", new { @class = "", id = "goldType" })
                    </div>

                    <div class="collection-toolbar__field collection-toolbar__field--search">
                        <label for="searchString" data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</label>
                        <input id="searchString" type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Bạn cần tìm gì?" data-i18n data-i18n-attr="placeholder" data-i18n-vi="Bạn cần tìm gì?" data-i18n-en="What are you looking for?" />
                    </div>

                    <div class="collection-toolbar__actions-group">
                        <button type="submit" class="btn-solid" data-i18n data-i18n-vi="Lọc sản phẩm" data-i18n-en="Filter products">Lọc sản phẩm</button>
                        <a href="@($"{basePath}{branchQueryPrefix}")" class="btn-solid" data-i18n data-i18n-vi="Đặt lại" data-i18n-en="Reset">Đặt lại</a>
                    </div>
                </form>
            </div>
        }

        @if (products.Any())
        {
            <div class="collection-grid">
                @foreach (var product in products)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <h2 data-i18n data-i18n-vi="Không tìm thấy sản phẩm phù hợp" data-i18n-en="No matching products found">Không tìm thấy sản phẩm phù hợp</h2>
                <p data-i18n data-i18n-vi="Hãy thử thay đổi bộ lọc hoặc quay lại toàn bộ bộ sưu tập để khám phá thêm những thiết kế phù hợp với bạn." data-i18n-en="Try adjusting the filters or return to the full collection to discover more designs that match your taste.">Hãy thử thay đổi bộ lọc hoặc quay lại toàn bộ bộ sưu tập để khám phá thêm những thiết kế phù hợp với bạn.</p>
                <a href="@basePath" class="btn-solid" data-i18n data-i18n-vi="Xem lại toàn bộ" data-i18n-en="See all products">Xem lại toàn bộ</a>
            </div>
        }
    </div>
</section>
