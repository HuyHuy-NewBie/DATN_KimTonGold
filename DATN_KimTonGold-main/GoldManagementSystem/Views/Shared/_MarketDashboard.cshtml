@{
    var variant = (ViewData["MarketDashboardVariant"] as string ?? "compact").ToLowerInvariant();
    var isExpanded = variant == "expanded";
    var endpoint = Url.Action("MarketPrices", "Home") ?? "/Home/MarketPrices";
}

<div class="market-board market-board--@variant"
     data-market-board
     data-market-endpoint="@endpoint"
     data-market-variant="@variant">
    <div class="market-board__status" data-market-status>
        Đang tải bảng giá vàng và bạc...
    </div>

    <div class="market-board__grid">
        <div class="market-board__column market-board__column--silver">
            <article class="market-card" data-market-card="silver-spot"></article>
            <article class="market-card" data-market-card="silver-pulse"></article>
        </div>

        <div class="market-board__column market-board__column--gold">
            <article class="market-card" data-market-card="gold-spot"></article>
            <article class="market-card" data-market-card="gold-pulse"></article>
        </div>
    </div>

    @if (isExpanded)
    {
        <div class="market-board__details">
            <article class="market-detail" data-market-detail="silver"></article>
            <article class="market-detail" data-market-detail="gold"></article>
        </div>
    }
</div>
