@model GoldManagementSystem.Models.ViewModels.SupplierManagementViewModel
@using GoldManagementSystem.Models
@using System.Linq

@{
    ViewData["Title"] = "Quản lý nhà cung cấp";

    var supplierTypes = new[]
    {
        "Vàng",
        "Bạc",
        "Kim cương",
        "Đá quý",
        "Phụ kiện / hộp đựng",
        "Gia công / sửa chữa"
    };

    var paymentTerms = new[] { 0, 7, 15, 30, 45, 60, 90 };

    var banks = new[]
    {
        "Vietcombank",
        "VietinBank",
        "BIDV",
        "Agribank",
        "Techcombank",
        "ACB",
        "MB Bank",
        "Sacombank",
        "VPBank",
        "TPBank",
        "Khác"
    };
    decimal CalculateSupplierOrderDebt(
    SupplierPurchaseOrder order)
    {
        var acceptedValue =
            order?.Receipts?.Sum(
                receipt => receipt.TotalAcceptedValue)
            ?? 0m;

        var paidAmount =
            order?.Payments?.Sum(
                payment => payment.Amount)
            ?? 0m;

        var debt = acceptedValue - paidAmount;

        return debt > 0 ? debt : 0m;
    }

    decimal CalculateSupplierDebt(
        Supplier supplier)
    {
        return supplier?.PurchaseOrders?
            .Sum(CalculateSupplierOrderDebt)
            ?? 0m;
    }

    bool HasOpenPurchaseOrder(
        Supplier supplier)
    {
        return supplier?.PurchaseOrders?.Any(order =>
            order.Status
                != SupplierPurchaseOrder.StatusReceived
            && order.Status
                != SupplierPurchaseOrder.StatusCancelled)
            ?? false;
    }
    var activeSupplierCount = Model.Suppliers.Count(supplier => supplier.IsActive);
    var inactiveSupplierCount = Model.Suppliers.Count - activeSupplierCount;
}

<div class="dashboard-card dashboard-card--flush admin-panel supplier-management-page supplier-directory-page">
    <section class="admin-hero admin-hero--split supplier-hero supplier-directory-hero">
        <div>
            <p class="admin-hero__eyebrow">Quản lý đối tác</p>
            <h1>Quản lý nhà cung cấp</h1>
            <p class="admin-hero__text">
                Lưu trữ và tra cứu hồ sơ nhà cung cấp, thông tin liên hệ,
                nhóm hàng cung ứng và điều khoản thanh toán.
            </p>
        </div>

        <div class="admin-hero__actions">
            <button type="button"
                    class="admin-button admin-button--primary"
                    data-open-modal="supplierCreateModal">
                + Thêm nhà cung cấp
            </button>
        </div>
    </section>

    <div class="admin-panel__body supplier-directory-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <section class="admin-stats-grid supplier-directory-stats" aria-label="Tổng quan nhà cung cấp">
            <article class="admin-stat-card admin-stat-card--gold">
                <div class="admin-stat-card__content">
                    <p>Tổng nhà cung cấp</p>
                    <strong>@Model.Suppliers.Count</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--green">
                <div class="admin-stat-card__content">
                    <p>Đang hợp tác</p>
                    <strong>@activeSupplierCount</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--rose">
                <div class="admin-stat-card__content">
                    <p>Tạm ngưng</p>
                    <strong>@inactiveSupplierCount</strong>
                </div>
            </article>
        </section>

        <section class="admin-section supplier-directory-card" id="supplier-list">
            <div class="admin-section__header supplier-directory-heading">
                <div>
                    <p class="admin-section__eyebrow">Danh sách nhà cung cấp</p>
                    <h2>Hồ sơ đang quản lý</h2>
                </div>

                <span class="status-chip status-chip--info" id="supplierResultCount">
                    @Model.Suppliers.Count kết quả
                </span>
            </div>

            <div class="supplier-directory-toolbar">
                <label class="admin-field supplier-directory-toolbar__search">
                    <span>Tìm kiếm</span>
                    <input type="search"
                           id="supplierSearchInput"
                           placeholder="Tên NCC, người liên hệ, SĐT, email, mã số thuế..." />
                </label>

                <label class="admin-field">
                    <span>Trạng thái</span>
                    <select id="supplierStatusFilter" class="admin-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active">Đang hợp tác</option>
                        <option value="inactive">Tạm ngưng</option>
                    </select>
                </label>

                <div class="supplier-directory-toolbar__actions">
                    <button type="button"
                            id="supplierClearFilterButton"
                            class="admin-button admin-button--ghost">
                        Xóa lọc
                    </button>
                </div>
            </div>

            <div class="table-shell supplier-directory-table-shell">
                <table class="data-table supplier-directory-table">
                    <thead>
                        <tr>
                            <th>Nhà cung cấp</th>
                            <th>Liên hệ</th>
                            <th>Nhóm cung ứng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Suppliers.Any())
                        {
                            foreach (var supplier in Model.Suppliers)
                            {
                                var supplierSearchText = $"{supplier.Name} {supplier.ContactPerson} {supplier.Phone} {supplier.Email} {supplier.TaxCode} {supplier.SupplierType}";
                                var supplierStatus = supplier.IsActive ? "active" : "inactive";
                                var initial = string.IsNullOrWhiteSpace(supplier.Name)
                                    ? "N"
                                    : supplier.Name.Trim().Substring(0, 1).ToUpperInvariant();
                                var supplierDebt =
                                    CalculateSupplierDebt(supplier);

                                var hasOpenPurchaseOrder =
                                    HasOpenPurchaseOrder(supplier);

                                var canStopCooperation =
                                    supplier.IsActive
                                    && supplierDebt <= 0
                                    && !hasOpenPurchaseOrder;
                                <tr class="supplier-data-row"
                                    data-supplier-search="@supplierSearchText"
                                    data-supplier-status="@supplierStatus">
                                    <td>
                                        <div class="supplier-profile-cell">
                                            <span class="supplier-profile-avatar">@initial</span>
                                            <div class="data-table__stack">
                                                <strong>@supplier.Name</strong>
                                                <span>MST: @supplier.TaxCode</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@supplier.ContactPerson</strong>
                                            <span>@supplier.Phone</span>
                                            <span>@(string.IsNullOrWhiteSpace(supplier.Email) ? "Chưa cập nhật email" : supplier.Email)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="supplier-type-list">
                                            @foreach (var type in (supplier.SupplierType ?? string.Empty)
                                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                .Select(item => item.Trim()))
                                            {
                                                <span>@type</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (supplier.IsActive)
                                        {
                                            <span class="status-chip status-chip--success">Đang hợp tác</span>
                                        }
                                        else
                                        {
                                            <span class="status-chip status-chip--neutral">Tạm ngưng</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="admin-action-group supplier-directory-actions">
                                            <button type="button"
                                                    class="admin-button admin-button--secondary"
                                                    data-open-modal="supplierDetailModal-@supplier.Id">
                                                Xem
                                            </button>

                                            <button type="button"
                                                    class="admin-button admin-button--primary"
                                                    data-open-modal="supplierEditModal-@supplier.Id">
                                                Sửa
                                            </button>

                                            @if (canStopCooperation)
                                            {
                                                <form asp-action="ToggleSupplierStatus"
                                                    asp-controller="Admin"
                                                    method="post"
                                                    onsubmit="return confirm(
                                                        'Bạn có chắc muốn ngưng hợp tác với nhà cung cấp này?'
                                                    );">

                                                    <input type="hidden"
                                                        name="supplierId"
                                                        value="@supplier.Id" />

                                                    <button type="submit"
                                                            class="admin-button admin-button--danger">
                                                        Ngưng hợp tác
                                                    </button>
                                                </form>
                                            }
                                            else if (!supplier.IsActive)
                                            {
                                                <form asp-action="ToggleSupplierStatus"
                                                    asp-controller="Admin"
                                                    method="post"
                                                    onsubmit="return confirm(
                                                        'Bạn có muốn hợp tác lại với nhà cung cấp này?'
                                                    );">

                                                    <input type="hidden"
                                                        name="supplierId"
                                                        value="@supplier.Id" />

                                                    <button type="submit"
                                                            class="admin-button admin-button--secondary">
                                                        Hợp tác lại
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state-card supplier-empty-state">
                                        <h3>Chưa có nhà cung cấp</h3>
                                        <p>Nhấn “Thêm nhà cung cấp” để tạo hồ sơ đầu tiên.</p>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="supplierNoResultRow" hidden>
                            <td colspan="5">
                                <div class="empty-state-card supplier-empty-state">
                                    <h3>Không tìm thấy nhà cung cấp phù hợp</h3>
                                    <p>Hãy thử đổi từ khóa hoặc trạng thái lọc.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<div class="supplier-modal" id="supplierCreateModal" aria-hidden="true">
    <div class="supplier-modal__backdrop" data-close-modal></div>

    <div class="supplier-modal__dialog supplier-modal__dialog--medium">
        <div class="supplier-modal__header">
            <div>
                <p class="admin-section__eyebrow">Hồ sơ nhà cung cấp</p>
                <h2>Thêm nhà cung cấp</h2>
                <p>Nhập các thông tin cần thiết để tạo hồ sơ mới.</p>
            </div>

            <button type="button"
                    class="supplier-modal__close"
                    data-close-modal
                    aria-label="Đóng">
                ×
            </button>
        </div>

        <form asp-action="CreateSupplier"
              asp-controller="Admin"
              method="post"
              class="admin-form-grid supplier-form-grid"
              id="supplierCreateForm">
            <label class="admin-field">
                <span>Tên nhà cung cấp *</span>
                <input type="text" name="Name" required maxlength="180" minlength="3" />
            </label>

            <label class="admin-field">
                <span>Mã số thuế *</span>
                <input type="text"
                       name="TaxCode"
                       required
                       inputmode="numeric"
                       maxlength="13"
                       pattern="(\d{10}|\d{13})"
                       data-digits-only />
            </label>

            <label class="admin-field">
                <span>Người liên hệ *</span>
                <input type="text" name="ContactPerson" required maxlength="120" minlength="2" />
            </label>

            <label class="admin-field">
                <span>Số điện thoại *</span>
                <input type="text"
                       name="Phone"
                       required
                       inputmode="numeric"
                       maxlength="10"
                       pattern="0\d{9}"
                       data-digits-only />
            </label>

            <label class="admin-field">
                <span>Email</span>
                <input type="email" name="Email" maxlength="150" />
            </label>

            <label class="admin-field">
                <span>Số ngày công nợ</span>
                <select name="PaymentTermDays" class="admin-select">
                    @foreach (var term in paymentTerms)
                    {
                        <option value="@term">@(term == 0 ? "Thanh toán ngay" : $"{term} ngày")</option>
                    }
                </select>
            </label>

            <div class="admin-field admin-field--wide">
                <span>Nhóm cung ứng *</span>
                <div class="supplier-checkbox-grid">
                    @foreach (var type in supplierTypes)
                    {
                        <label>
                            @if (type == "Vàng")
                            {
                                <input type="checkbox" name="SupplierTypes" value="@type" checked />
                            }
                            else
                            {
                                <input type="checkbox" name="SupplierTypes" value="@type" />
                            }
                            @type
                        </label>
                    }
                </div>
            </div>

            <label class="admin-field">
                <span>Ngân hàng</span>
                <select name="BankName" class="admin-select">
                    <option value="">-- Không nhập --</option>
                    @foreach (var bank in banks)
                    {
                        <option value="@bank">@bank</option>
                    }
                </select>
            </label>

            <label class="admin-field">
                <span>Số tài khoản</span>
                <input type="text"
                       name="BankAccountNumber"
                       inputmode="numeric"
                       maxlength="20"
                       minlength="6"
                       data-digits-only />
            </label>

            <label class="admin-field">
                <span>Chủ tài khoản</span>
                <input type="text" name="BankAccountName" maxlength="120" />
            </label>

            <label class="admin-field admin-field--wide">
                <span>Địa chỉ *</span>
                <input type="text" name="Address" required maxlength="300" minlength="5" />
            </label>

            <label class="admin-field admin-field--wide">
                <span>Ghi chú</span>
                <textarea name="Note" rows="3" maxlength="1000"></textarea>
            </label>

            <div class="admin-field admin-field--wide">
                <div class="admin-alert admin-alert--danger"
                     id="supplierCreateError"
                     role="alert"
                     hidden>
                </div>
            </div>

            <div class="admin-form-actions admin-field--wide">
                <button type="button"
                        class="admin-button admin-button--ghost"
                        data-close-modal>
                    Hủy
                </button>

                <button type="submit"
                        class="admin-button admin-button--primary"
                        id="supplierCreateSubmitButton">
                    Thêm nhà cung cấp
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Suppliers.Any())
{
    foreach (var supplier in Model.Suppliers)
    {
        var selectedTypes = (supplier.SupplierType ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(item => item.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        <div class="supplier-modal" id="supplierDetailModal-@supplier.Id" aria-hidden="true">
            <div class="supplier-modal__backdrop" data-close-modal></div>

            <div class="supplier-modal__dialog supplier-modal__dialog--medium">
                <div class="supplier-modal__header">
                    <div>
                        <p class="admin-section__eyebrow">Chi tiết nhà cung cấp</p>
                        <h2>@supplier.Name</h2>
                        <p>Mã số thuế: @supplier.TaxCode</p>
                    </div>

                    <button type="button"
                            class="supplier-modal__close"
                            data-close-modal
                            aria-label="Đóng">
                        ×
                    </button>
                </div>

                <div class="supplier-detail-status">
                    @if (supplier.IsActive)
                    {
                        <span class="status-chip status-chip--success">Đang hợp tác</span>
                    }
                    else
                    {
                        <span class="status-chip status-chip--neutral">Tạm ngưng</span>
                    }
                </div>

                <dl class="supplier-detail-grid">
                    <div>
                        <dt>Người liên hệ</dt>
                        <dd>@supplier.ContactPerson</dd>
                    </div>
                    <div>
                        <dt>Số điện thoại</dt>
                        <dd>@supplier.Phone</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(supplier.Email) ? "Chưa cập nhật" : supplier.Email)</dd>
                    </div>
                    <div>
                        <dt>Điều khoản thanh toán</dt>
                        <dd>@(supplier.PaymentTermDays == 0 ? "Thanh toán ngay" : $"Công nợ {supplier.PaymentTermDays} ngày")</dd>
                    </div>
                    <div class="supplier-detail-grid__wide">
                        <dt>Nhóm cung ứng</dt>
                        <dd>@supplier.SupplierType</dd>
                    </div>
                    <div class="supplier-detail-grid__wide">
                        <dt>Địa chỉ</dt>
                        <dd>@supplier.Address</dd>
                    </div>
                    <div>
                        <dt>Ngân hàng</dt>
                        <dd>@(string.IsNullOrWhiteSpace(supplier.BankName) ? "Chưa cập nhật" : supplier.BankName)</dd>
                    </div>
                    <div>
                        <dt>Số tài khoản</dt>
                        <dd>@(string.IsNullOrWhiteSpace(supplier.BankAccountNumber) ? "Chưa cập nhật" : supplier.BankAccountNumber)</dd>
                    </div>
                    <div>
                        <dt>Chủ tài khoản</dt>
                        <dd>@(string.IsNullOrWhiteSpace(supplier.BankAccountName) ? "Chưa cập nhật" : supplier.BankAccountName)</dd>
                    </div>
                    <div>
                        <dt>Ngày tạo hồ sơ</dt>
                        <dd>@supplier.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div class="supplier-detail-grid__wide">
                        <dt>Ghi chú</dt>
                        <dd>@(string.IsNullOrWhiteSpace(supplier.Note) ? "Không có ghi chú" : supplier.Note)</dd>
                    </div>
                </dl>

                <div class="admin-form-actions">
                    <button type="button"
                            class="admin-button admin-button--ghost"
                            data-close-modal>
                        Đóng
                    </button>
                </div>
            </div>
        </div>

        <div class="supplier-modal" id="supplierEditModal-@supplier.Id" aria-hidden="true">
            <div class="supplier-modal__backdrop" data-close-modal></div>

            <div class="supplier-modal__dialog supplier-modal__dialog--medium">
                <div class="supplier-modal__header">
                    <div>
                        <p class="admin-section__eyebrow">Cập nhật hồ sơ</p>
                        <h2>@supplier.Name</h2>
                        <p>Chỉnh sửa thông tin nhà cung cấp và lưu thay đổi.</p>
                    </div>

                    <button type="button"
                            class="supplier-modal__close"
                            data-close-modal
                            aria-label="Đóng">
                        ×
                    </button>
                </div>

                <form asp-action="UpdateSupplier"
                      asp-controller="Admin"
                      method="post"
                      class="admin-form-grid supplier-form-grid">
                    <input type="hidden" name="SupplierId" value="@supplier.Id" />

                    <label class="admin-field">
                        <span>Tên nhà cung cấp *</span>
                        <input type="text" name="Name" value="@supplier.Name" required maxlength="180" minlength="3" />
                    </label>

                    <label class="admin-field">
                        <span>Mã số thuế *</span>
                        <input type="text"
                               name="TaxCode"
                               value="@supplier.TaxCode"
                               required
                               inputmode="numeric"
                               maxlength="13"
                               pattern="(\d{10}|\d{13})"
                               data-digits-only />
                    </label>

                    <label class="admin-field">
                        <span>Người liên hệ *</span>
                        <input type="text" name="ContactPerson" value="@supplier.ContactPerson" required maxlength="120" minlength="2" />
                    </label>

                    <label class="admin-field">
                        <span>Số điện thoại *</span>
                        <input type="text"
                               name="Phone"
                               value="@supplier.Phone"
                               required
                               inputmode="numeric"
                               maxlength="10"
                               pattern="0\d{9}"
                               data-digits-only />
                    </label>

                    <label class="admin-field">
                        <span>Email</span>
                        <input type="email" name="Email" value="@supplier.Email" maxlength="150" />
                    </label>

                    <label class="admin-field">
                        <span>Số ngày công nợ</span>
                        <select name="PaymentTermDays" class="admin-select">
                            @foreach (var term in paymentTerms)
                            {
                                if (supplier.PaymentTermDays == term)
                                {
                                    <option value="@term" selected>@(term == 0 ? "Thanh toán ngay" : $"{term} ngày")</option>
                                }
                                else
                                {
                                    <option value="@term">@(term == 0 ? "Thanh toán ngay" : $"{term} ngày")</option>
                                }
                            }
                        </select>
                    </label>

                    <div class="admin-field admin-field--wide">
                        <span>Nhóm cung ứng *</span>
                        <div class="supplier-checkbox-grid">
                            @foreach (var type in supplierTypes)
                            {
                                <label>
                                    @if (selectedTypes.Contains(type))
                                    {
                                        <input type="checkbox" name="SupplierTypes" value="@type" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="SupplierTypes" value="@type" />
                                    }
                                    @type
                                </label>
                            }
                        </div>
                    </div>

                    <label class="admin-field">
                        <span>Ngân hàng</span>
                        <select name="BankName" class="admin-select">
                            <option value="">-- Không nhập --</option>
                            @foreach (var bank in banks)
                            {
                                if (string.Equals(supplier.BankName, bank, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@bank" selected>@bank</option>
                                }
                                else
                                {
                                    <option value="@bank">@bank</option>
                                }
                            }
                        </select>
                    </label>

                    <label class="admin-field">
                        <span>Số tài khoản</span>
                        <input type="text"
                               name="BankAccountNumber"
                               value="@supplier.BankAccountNumber"
                               inputmode="numeric"
                               maxlength="20"
                               minlength="6"
                               data-digits-only />
                    </label>

                    <label class="admin-field">
                        <span>Chủ tài khoản</span>
                        <input type="text" name="BankAccountName" value="@supplier.BankAccountName" maxlength="120" />
                    </label>

                    <label class="admin-field admin-field--wide">
                        <span>Địa chỉ *</span>
                        <input type="text" name="Address" value="@supplier.Address" required maxlength="300" minlength="5" />
                    </label>

                    <label class="admin-field admin-field--wide">
                        <span>Ghi chú</span>
                        <textarea name="Note" rows="3" maxlength="1000">@supplier.Note</textarea>
                    </label>

                    <div class="admin-form-actions admin-field--wide">
                        <button type="button"
                                class="admin-button admin-button--ghost"
                                data-close-modal>
                            Hủy
                        </button>

                        <button type="submit" class="admin-button admin-button--primary">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll("[data-digits-only]").forEach(function (input) {
                input.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, "");
                });
            });

            function openModal(modalId) {
                const modal = document.getElementById(modalId);
                if (!modal) return;

                modal.classList.add("is-open");
                modal.setAttribute("aria-hidden", "false");
                document.body.classList.add("supplier-modal-open");
            }

            function closeModal(modal) {
                if (!modal) return;

                modal.classList.remove("is-open");
                modal.setAttribute("aria-hidden", "true");

                if (!document.querySelector(".supplier-modal.is-open")) {
                    document.body.classList.remove("supplier-modal-open");
                }
            }

            document.querySelectorAll("[data-open-modal]").forEach(function (button) {
                button.addEventListener("click", function () {
                    openModal(button.getAttribute("data-open-modal"));
                });
            });

            document.querySelectorAll("[data-close-modal]").forEach(function (button) {
                button.addEventListener("click", function () {
                    closeModal(button.closest(".supplier-modal"));
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") return;
                document.querySelectorAll(".supplier-modal.is-open").forEach(closeModal);
            });

            const searchInput = document.getElementById("supplierSearchInput");
            const statusFilter = document.getElementById("supplierStatusFilter");
            const clearFilterButton = document.getElementById("supplierClearFilterButton");
            const noResultRow = document.getElementById("supplierNoResultRow");
            const resultCount = document.getElementById("supplierResultCount");

            function normalizeText(value) {
                return (value || "")
                    .toString()
                    .trim()
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "");
            }

            function filterSuppliers() {
                const keyword = normalizeText(searchInput ? searchInput.value : "");
                const selectedStatus = statusFilter ? statusFilter.value : "";
                const rows = document.querySelectorAll(".supplier-data-row");
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const matchKeyword = keyword === ""
                        || normalizeText(row.dataset.supplierSearch).includes(keyword);
                    const matchStatus = selectedStatus === ""
                        || row.dataset.supplierStatus === selectedStatus;
                    const visible = matchKeyword && matchStatus;

                    row.hidden = !visible;
                    if (visible) visibleCount++;
                });

                if (noResultRow) noResultRow.hidden = visibleCount !== 0;
                if (resultCount) resultCount.textContent = visibleCount + " kết quả";
            }

            if (searchInput) searchInput.addEventListener("input", filterSuppliers);
            if (statusFilter) statusFilter.addEventListener("change", filterSuppliers);

            if (clearFilterButton) {
                clearFilterButton.addEventListener("click", function () {
                    if (searchInput) searchInput.value = "";
                    if (statusFilter) statusFilter.value = "";
                    filterSuppliers();
                });
            }

            const createForm = document.getElementById("supplierCreateForm");
            const createError = document.getElementById("supplierCreateError");
            const createButton = document.getElementById("supplierCreateSubmitButton");

            function showCreateError(message) {
                if (!createError) {
                    alert(message);
                    return;
                }

                createError.textContent = message;
                createError.hidden = false;
            }

            if (createForm) {
                createForm.addEventListener("submit", async function (event) {
                    event.preventDefault();

                    if (!createForm.checkValidity()) {
                        createForm.reportValidity();
                        return;
                    }

                    if (createError) {
                        createError.textContent = "";
                        createError.hidden = true;
                    }

                    const originalText = createButton ? createButton.textContent : "Thêm nhà cung cấp";
                    if (createButton) {
                        createButton.disabled = true;
                        createButton.textContent = "Đang lưu...";
                    }

                    try {
                        const response = await fetch(createForm.action, {
                            method: "POST",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: new FormData(createForm)
                        });

                        const contentType = response.headers.get("content-type") || "";
                        const result = contentType.includes("application/json")
                            ? await response.json()
                            : null;

                        if (!response.ok || !result || !result.success) {
                            showCreateError(
                                result && result.message
                                    ? result.message
                                    : "Không thể thêm nhà cung cấp. Vui lòng kiểm tra lại dữ liệu."
                            );
                            return;
                        }

                        window.location.reload();
                    } catch (error) {
                        console.error(error);
                        showCreateError("Không thể kết nối đến máy chủ. Vui lòng thử lại.");
                    } finally {
                        if (createButton) {
                            createButton.disabled = false;
                            createButton.textContent = originalText;
                        }
                    }
                });
            }
        })();
    </script>
}
