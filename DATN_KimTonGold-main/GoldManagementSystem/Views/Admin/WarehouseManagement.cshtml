@model GoldManagementSystem.Models.ViewModels.SupplierManagementViewModel
@using GoldManagementSystem.Models
@using System
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Phiếu nhập kho";

    var selectedBranchId =
        ViewBag.SelectedBranchId as int?;

    var purchaseOrders =
        Model.PurchaseOrders?.ToList()
        ?? new List<SupplierPurchaseOrder>();

    var receipts =
        Model.RecentReceipts?.ToList()
        ?? new List<SupplierGoodsReceipt>();
    
    var warehouseTab =
        Context.Request.Query["warehouseTab"]
            .ToString()
            .ToLowerInvariant();

    if (warehouseTab != "receipts")
    {
        warehouseTab = "orders";
    }

    var processingOrderCount =
        purchaseOrders.Count(order =>
            order.Status
                != SupplierPurchaseOrder.StatusReceived);

    var notReceivedCount =
        purchaseOrders.Count(order =>
            order.Status == SupplierPurchaseOrder.StatusOrdered
            || order.Status
                == SupplierPurchaseOrder.StatusAwaitingReplacement);

    var shippingCount =
        purchaseOrders.Count(order =>
            order.Status
                == SupplierPurchaseOrder.StatusShipping);

    var pendingInventoryCount =
        receipts.Count(receipt =>
            receipt.Status
                == SupplierGoodsReceipt.StatusPendingApproval);

    var completedReceiptCount =
        receipts.Count(receipt =>
            receipt.Status
                == SupplierGoodsReceipt.StatusApproved
            || receipt.Status
                == SupplierGoodsReceipt.StatusPartiallyApproved);

    string GetOrderStatusLabel(string status)
    {
        if (status == SupplierPurchaseOrder.StatusOrdered)
        {
            return "Chưa nhận";
        }

        return status;
    }

    string GetOrderStatusClass(string status)
    {
        return status switch
        {
            SupplierPurchaseOrder.StatusOrdered
                => "status-chip--neutral",

            SupplierPurchaseOrder.StatusShipping
                => "status-chip--info",

            SupplierPurchaseOrder.StatusPartiallyReceived
                => "status-chip--warning",

            SupplierPurchaseOrder.StatusAwaitingReplacement
                => "status-chip--warning",

            SupplierPurchaseOrder.StatusReceived
                => "status-chip--success",

            _ => "status-chip--neutral"
        };
    }

    string GetReceiptStatusLabel(string status)
    {
        return status switch
        {
            SupplierGoodsReceipt.StatusPendingApproval
                => "Chờ nhập kho",

            SupplierGoodsReceipt.StatusApproved
                => "Đã nhập kho",

            SupplierGoodsReceipt.StatusPartiallyApproved
                => "Đã nhập kho một phần",

            SupplierGoodsReceipt.StatusRejected
                => "Không nhận hàng",

            _ => status
        };
    }

    string GetReceiptStatusClass(string status)
    {
        return status switch
        {
            SupplierGoodsReceipt.StatusPendingApproval
                => "status-chip--warning",

            SupplierGoodsReceipt.StatusApproved
                => "status-chip--success",

            SupplierGoodsReceipt.StatusPartiallyApproved
                => "status-chip--info",

            SupplierGoodsReceipt.StatusRejected
                => "status-chip--danger",

            _ => "status-chip--neutral"
        };
    }
}

<div class="dashboard-card dashboard-card--flush admin-panel warehouse-receipt-page">
    <section class="admin-hero admin-hero--split warehouse-receipt-hero">
        <div>
            <p class="admin-hero__eyebrow">Nghiệp vụ kho</p>

            <h1>Phiếu nhập kho</h1>

            <p class="admin-hero__text">
                Theo dõi đơn đang giao, kiểm tra hàng thực tế,
                xác nhận số lượng đạt và nhập hàng vào tồn kho.
            </p>
        </div>
    </section>

    <div class="admin-panel__body warehouse-receipt-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <section class="admin-stats-grid warehouse-receipt-stats">
            <article class="admin-stat-card admin-stat-card--gold">
                <div class="admin-stat-card__content">
                    <p>Chưa nhận / chờ giao bù</p>
                    <strong>@notReceivedCount</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--blue">
                <div class="admin-stat-card__content">
                    <p>Đang giao</p>
                    <strong>@shippingCount</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--rose">
                <div class="admin-stat-card__content">
                    <p>Chờ nhập kho</p>
                    <strong>@pendingInventoryCount</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--green">
                <div class="admin-stat-card__content">
                    <p>Đã nhập kho</p>
                    <strong>@completedReceiptCount</strong>
                </div>
            </article>
        </section>

        <div class="warehouse-workflow-note">
            <span>1. Đang giao</span>
            <span>2. Kiểm hàng</span>
            <span>3. Nhận hàng đạt</span>
            <span>4. Nhập kho</span>
        </div>
        <div class="warehouse-tabs"
            role="tablist"
            aria-label="Quản lý nhập kho">

            <button type="button"
                    class="warehouse-tab-button @(warehouseTab == "orders" ? "is-active" : string.Empty)"
                    data-warehouse-tab-button="orders"
                    role="tab"
                    aria-selected="@(warehouseTab == "orders" ? "true" : "false")">

                <span>Đơn giao hàng</span>

                <strong>@processingOrderCount</strong>
            </button>

            <button type="button"
                    class="warehouse-tab-button @(warehouseTab == "receipts" ? "is-active" : string.Empty)"
                    data-warehouse-tab-button="receipts"
                    role="tab"
                    aria-selected="@(warehouseTab == "receipts" ? "true" : "false")">

                <span>Phiếu nhập kho</span>

                <strong>@receipts.Count</strong>
            </button>
        </div>
        <div class="warehouse-tab-panel @(warehouseTab == "orders" ? "is-active" : string.Empty)"
            data-warehouse-tab-panel="orders"
            role="tabpanel">
        <section class="admin-section warehouse-receipt-card">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow">
                        Theo dõi giao hàng
                    </p>

                    <h2>Đơn đặt hàng nhà cung cấp</h2>
                </div>

                <span class="status-chip status-chip--info"
                      id="receivingOrderResultCount">
                    @purchaseOrders.Count kết quả
                </span>
            </div>

            <div class="warehouse-filter-toolbar">
                <label class="admin-field warehouse-filter-toolbar__search">
                    <span>Tìm kiếm</span>

                    <input type="search"
                           id="receivingOrderSearchInput"
                           placeholder="Mã đơn, nhà cung cấp, sản phẩm..." />
                </label>

                <label class="admin-field">
                    <span>Trạng thái</span>

                    <select id="receivingOrderStatusFilter"
                            class="admin-select">
                        <option value="">Tất cả trạng thái</option>

                        <option value="@SupplierPurchaseOrder.StatusOrdered">
                            Chưa nhận
                        </option>

                        <option value="@SupplierPurchaseOrder.StatusShipping">
                            Đang giao
                        </option>

                        <option value="@SupplierPurchaseOrder.StatusPartiallyReceived">
                            Nhận một phần
                        </option>

                        <option value="@SupplierPurchaseOrder.StatusAwaitingReplacement">
                            Chờ giao bù
                        </option>

                        <option value="@SupplierPurchaseOrder.StatusReceived">
                            Đã nhận đủ
                        </option>
                    </select>
                </label>

                <div class="warehouse-filter-toolbar__actions">
                    <button type="button"
                            id="receivingOrderClearFilter"
                            class="admin-button admin-button--ghost">
                        Xóa lọc
                    </button>
                </div>
            </div>

            <div class="table-shell warehouse-table-shell">
                <table class="data-table warehouse-data-table">
                    <thead>
                        <tr>
                            <th>Đơn đặt hàng</th>
                            <th>Nhà cung cấp</th>
                            <th>Dự kiến giao</th>
                            <th>Tiến độ nhận</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (purchaseOrders.Any())
                        {
                            foreach (var order in purchaseOrders)
                            {
                                var totalOrdered =
                                    order.Details?.Sum(detail =>
                                        detail.Quantity) ?? 0;

                                var totalAccepted =
                                    order.Details?.Sum(detail =>
                                        detail.AcceptedQuantity) ?? 0;

                                var remainingQuantity =
                                    Math.Max(
                                        0,
                                        totalOrdered - totalAccepted);

                                var progressPercent =
                                    totalOrdered > 0
                                        ? Math.Min(
                                            100,
                                            (int)Math.Round(
                                                totalAccepted * 100m
                                                / totalOrdered))
                                        : 0;

                                var canMarkShipping =
                                    order.Status
                                        == SupplierPurchaseOrder.StatusOrdered
                                    || order.Status
                                        == SupplierPurchaseOrder.StatusPartiallyReceived
                                    || order.Status
                                        == SupplierPurchaseOrder.StatusAwaitingReplacement;

                                var canInspect =
                                    order.Status
                                        == SupplierPurchaseOrder.StatusShipping
                                    && remainingQuantity > 0;

                                var orderSearchText =
                                    string.Join(
                                        " ",
                                        new[]
                                        {
                                            order.OrderCode,
                                            order.Supplier?.Name,
                                            order.Branch?.BranchName,
                                            string.Join(
                                                " ",
                                                order.Details?.Select(detail =>
                                                    detail.ProductName)
                                                ?? Enumerable.Empty<string>())
                                        }
                                        .Where(value =>
                                            !string.IsNullOrWhiteSpace(value)));

                                <tr class="js-receiving-order-row"
                                    data-order-search="@orderSearchText"
                                    data-order-status="@order.Status">
                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@order.OrderCode</strong>
                                            <span>
                                                @totalOrdered sản phẩm ·
                                                @(order.Details?.Count ?? 0) dòng hàng
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@(order.Supplier?.Name ?? "--")</strong>
                                            <span>@(order.Supplier?.Phone ?? "--")</span>
                                        </div>
                                    </td>

                                    <td>
                                        @(order.ExpectedDeliveryDate.HasValue
                                            ? order.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy")
                                            : "--")
                                    </td>

                                    <td>
                                        <div class="warehouse-progress">
                                            <div class="warehouse-progress__text">
                                                <strong>
                                                    @totalAccepted / @totalOrdered
                                                </strong>

                                                <span>@progressPercent%</span>
                                            </div>

                                            <div class="warehouse-progress__bar">
                                                <span style="width: @progressPercent%"></span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status-chip @GetOrderStatusClass(order.Status)">
                                            @GetOrderStatusLabel(order.Status)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-action-group">
                                            <button type="button"
                                                    class="admin-button admin-button--secondary"
                                                    data-open-modal="purchaseOrderDetailModal-@order.Id">
                                                Xem
                                            </button>

                                            @if (canMarkShipping)
                                            {
                                                <form asp-action="MarkSupplierPurchaseOrderAsShipping"
                                                      asp-controller="Admin"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận nhà cung cấp đang giao đơn này?');">

                                                    <input type="hidden"
                                                           name="purchaseOrderId"
                                                           value="@order.Id" />

                                                    <button type="submit"
                                                            class="admin-button admin-button--secondary">
                                                        Đang giao
                                                    </button>
                                                </form>
                                            }

                                            @if (canInspect)
                                            {
                                                <button type="button"
                                                        class="admin-button admin-button--primary"
                                                        data-open-modal="supplierDeliveryInspectionModal-@order.Id">
                                                    Kiểm hàng
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state-card supplier-empty-state">
                                        <h3>Chưa có đơn đặt hàng</h3>
                                        <p>Đơn đặt hàng sẽ xuất hiện tại đây để theo dõi giao hàng.</p>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="receivingOrderNoResultRow" hidden>
                            <td colspan="6">
                                <div class="empty-state-card supplier-empty-state">
                                    <h3>Không tìm thấy đơn phù hợp</h3>
                                    <p>Hãy thử thay đổi từ khóa hoặc trạng thái.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        </div>
        <div class="warehouse-tab-panel @(warehouseTab == "receipts" ? "is-active" : string.Empty)"
            data-warehouse-tab-panel="receipts"
            role="tabpanel">
        <section class="admin-section warehouse-receipt-card">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow">
                        Kết quả nhận hàng
                    </p>

                    <h2>Danh sách phiếu nhập kho</h2>
                </div>

                <span class="status-chip status-chip--info"
                      id="receiptResultCount">
                    @receipts.Count kết quả
                </span>
            </div>

            <div class="warehouse-filter-toolbar">
                <label class="admin-field warehouse-filter-toolbar__search">
                    <span>Tìm kiếm</span>

                    <input type="search"
                           id="receiptSearchInput"
                           placeholder="Mã phiếu, mã đơn, nhà cung cấp..." />
                </label>

                <label class="admin-field">
                    <span>Trạng thái</span>

                    <select id="receiptStatusFilter"
                            class="admin-select">
                        <option value="">Tất cả trạng thái</option>

                        <option value="@SupplierGoodsReceipt.StatusPendingApproval">
                            Chờ nhập kho
                        </option>

                        <option value="@SupplierGoodsReceipt.StatusApproved">
                            Đã nhập kho
                        </option>

                        <option value="@SupplierGoodsReceipt.StatusPartiallyApproved">
                            Đã nhập kho một phần
                        </option>

                        <option value="@SupplierGoodsReceipt.StatusRejected">
                            Không nhận hàng
                        </option>
                    </select>
                </label>

                <div class="warehouse-filter-toolbar__actions">
                    <button type="button"
                            id="receiptClearFilter"
                            class="admin-button admin-button--ghost">
                        Xóa lọc
                    </button>
                </div>
            </div>

            <div class="table-shell warehouse-table-shell">
                <table class="data-table warehouse-data-table">
                    <thead>
                        <tr>
                            <th>Phiếu nhập</th>
                            <th>Đơn đặt hàng</th>
                            <th>Nhà cung cấp</th>
                            <th>Kho nhận</th>
                            <th>Kết quả kiểm</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (receipts.Any())
                        {
                            foreach (var receipt in receipts)
                            {
                                var deliveredQuantity =
                                    receipt.Details?.Sum(detail =>
                                        detail.ReceivedQuantity) ?? 0;

                                var acceptedQuantity =
                                    receipt.Details?.Sum(detail =>
                                        detail.AcceptedQuantity) ?? 0;

                                var rejectedQuantity =
                                    receipt.Details?.Sum(detail =>
                                        detail.RejectedQuantity) ?? 0;

                                var canPostInventory =
                                    receipt.Status
                                        == SupplierGoodsReceipt.StatusPendingApproval;

                                var receiptSearchText =
                                    $"{receipt.ReceiptCode} "
                                    + $"{receipt.SupplierPurchaseOrder?.OrderCode} "
                                    + $"{receipt.SupplierPurchaseOrder?.Supplier?.Name} "
                                    + $"{receipt.Warehouse?.Name}";

                                <tr class="js-receipt-row"
                                    data-receipt-search="@receiptSearchText"
                                    data-receipt-status="@receipt.Status">
                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@receipt.ReceiptCode</strong>
                                            <span>@receipt.ReceivedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </td>

                                    <td>
                                        @(receipt.SupplierPurchaseOrder?.OrderCode ?? "--")
                                    </td>

                                    <td>
                                        @(receipt.SupplierPurchaseOrder?.Supplier?.Name ?? "--")
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@(receipt.Warehouse?.Name ?? "--")</strong>
                                            <span>@(receipt.Warehouse?.Code ?? "--")</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="warehouse-quality-summary">
                                            <span>Giao: @deliveredQuantity</span>
                                            <strong>Đạt: @acceptedQuantity</strong>
                                            <span class="warehouse-quality-summary__rejected">
                                                Không đạt: @rejectedQuantity
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status-chip @GetReceiptStatusClass(receipt.Status)">
                                            @GetReceiptStatusLabel(receipt.Status)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-action-group">
                                            <button type="button"
                                                    class="admin-button admin-button--secondary"
                                                    data-open-modal="supplierGoodsReceiptDetailModal-@receipt.Id">
                                                Xem
                                            </button>

                                            @if (canPostInventory)
                                            {
                                                <form asp-action="PostSupplierGoodsReceiptToInventory"
                                                      asp-controller="Admin"
                                                      method="post"
                                                      onsubmit="return confirm('Xác nhận nhập số lượng đạt vào tồn kho?');">

                                                    <input type="hidden"
                                                           name="receiptId"
                                                           value="@receipt.Id" />

                                                    <button type="submit"
                                                            class="admin-button admin-button--primary">
                                                        Nhập kho
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state-card supplier-empty-state">
                                        <h3>Chưa có phiếu nhập kho</h3>
                                        <p>Phiếu sẽ được tạo sau khi hoàn tất kiểm hàng.</p>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="receiptNoResultRow" hidden>
                            <td colspan="7">
                                <div class="empty-state-card supplier-empty-state">
                                    <h3>Không tìm thấy phiếu phù hợp</h3>
                                    <p>Hãy thử thay đổi từ khóa hoặc trạng thái.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        </div>
    </div>
</div>

@if (purchaseOrders.Any())
{
    foreach (var order in purchaseOrders)
    {
        var remainingQuantity =
            order.Details?.Sum(detail =>
                Math.Max(
                    0,
                    detail.Quantity
                    - detail.AcceptedQuantity))
            ?? 0;

        var canInspect =
            order.Status
                == SupplierPurchaseOrder.StatusShipping
            && remainingQuantity > 0;

        @await Html.PartialAsync(
            "_SupplierPurchaseOrderDetailModal",
            order)

        if (canInspect)
        {
            @await Html.PartialAsync(
                "_SupplierGoodsReceiptCreateModal",
                order)
        }
    }
}

@if (receipts.Any())
{
    foreach (var receipt in receipts)
    {
        @await Html.PartialAsync(
            "_SupplierGoodsReceiptDetailModal",
            receipt)
    }
}

@section Scripts {
    <script>
        (function () {
            const warehouseTabButtons =
                Array.from(
                    document.querySelectorAll(
                        "[data-warehouse-tab-button]"
                    )
                );

            const warehouseTabPanels =
                Array.from(
                    document.querySelectorAll(
                        "[data-warehouse-tab-panel]"
                    )
                );

            function activateWarehouseTab(
                tabName,
                updateAddress
            ) {
                const resolvedTab =
                    tabName === "receipts"
                        ? "receipts"
                        : "orders";

                warehouseTabButtons.forEach(function (button) {
                    const isActive =
                        button.dataset.warehouseTabButton
                        === resolvedTab;

                    button.classList.toggle(
                        "is-active",
                        isActive);

                    button.setAttribute(
                        "aria-selected",
                        isActive ? "true" : "false");
                });

                warehouseTabPanels.forEach(function (panel) {
                    const isActive =
                        panel.dataset.warehouseTabPanel
                        === resolvedTab;

                    panel.classList.toggle(
                        "is-active",
                        isActive);
                });

                if (updateAddress) {
                    const currentUrl =
                        new URL(window.location.href);

                    currentUrl.searchParams.set(
                        "warehouseTab",
                        resolvedTab);

                    currentUrl.hash = "";

                    window.history.replaceState(
                        {},
                        "",
                        currentUrl);
                }
            }

            warehouseTabButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    activateWarehouseTab(
                        button.dataset.warehouseTabButton,
                        true);
                });
            });
            function openModal(modalId) {
                const modal = document.getElementById(modalId);
                if (!modal) return;

                modal.classList.add("is-open");
                modal.setAttribute("aria-hidden", "false");
                document.body.classList.add("supplier-modal-open");
            }

            document.querySelectorAll("[data-open-modal]").forEach(function (button) {
                button.addEventListener("click", function () {
                    openModal(button.dataset.openModal);
                });
            });

            document.querySelectorAll("[data-close-modal]").forEach(function (button) {
                button.addEventListener("click", function () {
                    const modal = button.closest(".supplier-modal");
                    if (!modal) return;

                    modal.classList.remove("is-open");
                    modal.setAttribute("aria-hidden", "true");

                    if (!document.querySelector(".supplier-modal.is-open")) {
                        document.body.classList.remove("supplier-modal-open");
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") return;

                document.querySelectorAll(".supplier-modal.is-open")
                    .forEach(function (modal) {
                        modal.classList.remove("is-open");
                        modal.setAttribute("aria-hidden", "true");
                    });

                document.body.classList.remove("supplier-modal-open");
            });

            function normalizeText(value) {
                return (value || "")
                    .toLocaleLowerCase("vi")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .trim();
            }

            function setupFilter(options) {
                const searchInput =
                    document.getElementById(options.searchId);

                const statusFilter =
                    document.getElementById(options.statusId);

                const clearButton =
                    document.getElementById(options.clearId);

                const resultCount =
                    document.getElementById(options.countId);

                const noResultRow =
                    document.getElementById(options.noResultId);

                const rows =
                    Array.from(document.querySelectorAll(options.rowSelector));

                function applyFilter() {
                    const keyword =
                        normalizeText(searchInput?.value);

                    const status =
                        statusFilter?.value || "";

                    let visibleCount = 0;

                    rows.forEach(function (row) {
                        const searchText =
                            normalizeText(row.dataset[options.searchData]);

                        const rowStatus =
                            row.dataset[options.statusData] || "";

                        const isVisible =
                            (!keyword || searchText.includes(keyword))
                            && (!status || rowStatus === status);

                        row.hidden = !isVisible;

                        if (isVisible) {
                            visibleCount += 1;
                        }
                    });

                    if (resultCount) {
                        resultCount.textContent =
                            visibleCount + " kết quả";
                    }

                    if (noResultRow) {
                        noResultRow.hidden =
                            visibleCount !== 0 || rows.length === 0;
                    }
                }

                searchInput?.addEventListener(
                    "input",
                    applyFilter);

                statusFilter?.addEventListener(
                    "change",
                    applyFilter);

                clearButton?.addEventListener(
                    "click",
                    function () {
                        if (searchInput) {
                            searchInput.value = "";
                        }

                        if (statusFilter) {
                            statusFilter.value = "";
                        }

                        applyFilter();
                        searchInput?.focus();
                    });
            }

            setupFilter({
                searchId: "receivingOrderSearchInput",
                statusId: "receivingOrderStatusFilter",
                clearId: "receivingOrderClearFilter",
                countId: "receivingOrderResultCount",
                noResultId: "receivingOrderNoResultRow",
                rowSelector: ".js-receiving-order-row",
                searchData: "orderSearch",
                statusData: "orderStatus"
            });

            setupFilter({
                searchId: "receiptSearchInput",
                statusId: "receiptStatusFilter",
                clearId: "receiptClearFilter",
                countId: "receiptResultCount",
                noResultId: "receiptNoResultRow",
                rowSelector: ".js-receipt-row",
                searchData: "receiptSearch",
                statusData: "receiptStatus"
            });

            function parseQuantity(input) {
                const value =
                    Number.parseInt(input?.value || "0", 10);

                return Number.isFinite(value)
                    ? Math.max(0, value)
                    : 0;
            }

            document.querySelectorAll(".js-inspection-line")
                .forEach(function (line) {
                    const deliveredInput =
                        line.querySelector(".js-delivered-quantity");

                    const acceptedInput =
                        line.querySelector(".js-accepted-quantity");

                    const rejectedInput =
                        line.querySelector(".js-rejected-quantity");

                    const rejectionReason =
                        line.querySelector(".js-rejection-reason");

                    const weightInput =
                        line.querySelector(".js-accepted-weight");

                    const caratInput =
                        line.querySelector(".js-accepted-carat");

                    const remaining =
                        Number.parseInt(
                            line.dataset.remaining || "0",
                            10);

                    function updateInspectionResult() {
                        let delivered =
                            parseQuantity(deliveredInput);

                        let accepted =
                            parseQuantity(acceptedInput);

                        if (delivered > remaining) {
                            delivered = remaining;
                            deliveredInput.value = remaining;
                        }

                        if (accepted > delivered) {
                            accepted = delivered;
                            acceptedInput.value = delivered;
                        }

                        const rejected =
                            Math.max(
                                0,
                                delivered - accepted);

                        if (rejectedInput) {
                            rejectedInput.value = rejected;
                        }

                        if (rejectionReason) {
                            rejectionReason.required =
                                rejected > 0;
                        }

                        if (weightInput) {
                            weightInput.required =
                                accepted > 0
                                && line.dataset.requiresWeight === "true";
                        }

                        if (caratInput) {
                            caratInput.required =
                                accepted > 0
                                && line.dataset.requiresCarat === "true";
                        }

                        line.classList.toggle(
                            "has-rejected-items",
                            rejected > 0);

                        line.classList.toggle(
                            "has-accepted-items",
                            accepted > 0);
                    }

                    deliveredInput?.addEventListener(
                        "input",
                        updateInspectionResult);

                    acceptedInput?.addEventListener(
                        "input",
                        updateInspectionResult);

                    updateInspectionResult();
                });
        })();
    </script>
}