@model IEnumerable<GoldManagementSystem.Models.ViewModels.UserViewModel>
@using GoldManagementSystem.Services
@using System.Linq
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    var roles = ViewBag.AllRoles as List<string> ?? new List<string>();

    string GetRoleLabelVi(string role) => RoleCatalog.GetVietnameseLabel(role);
    string GetRoleLabelEn(string role) => RoleCatalog.GetEnglishLabel(role);
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--split">
        <div>
            <p class="admin-hero__eyebrow" data-i18n data-i18n-vi="Quản trị tài khoản" data-i18n-en="Account administration">Quản trị tài khoản</p>
            <h1 data-i18n data-i18n-vi="Quản lý người dùng" data-i18n-en="User management">Quản lý người dùng</h1>
            <p class="admin-hero__text" data-i18n data-i18n-vi="Phân quyền rõ ràng, khóa hoặc mở tài khoản nhanh và tạo người dùng mới từ một giao diện dễ nhìn hơn." data-i18n-en="Assign roles, lock or unlock accounts, and create new users from a cleaner admin interface.">Phân quyền rõ ràng, khóa hoặc mở tài khoản nhanh và tạo người dùng mới từ một giao diện dễ nhìn hơn.</p>
        </div>

        <button type="button"
                class="admin-button admin-button--primary"
                onclick="document.getElementById('createUserModal').classList.toggle('is-hidden')"
                data-i18n
                data-i18n-vi="Thêm người dùng"
                data-i18n-en="Add user">
            Thêm người dùng
        </button>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
        }

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Nhân sự hệ thống" data-i18n-en="System users">Nhân sự hệ thống</p>
                    <h2 data-i18n data-i18n-vi="Danh sách người dùng và quyền truy cập" data-i18n-en="Users and access roles">Danh sách người dùng và quyền truy cập</h2>
                </div>
            </div>

            <div class="table-shell">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th data-i18n data-i18n-vi="Người dùng" data-i18n-en="User">Người dùng</th>
                            <th data-i18n data-i18n-vi="Email" data-i18n-en="Email">Email</th>
                            <th data-i18n data-i18n-vi="Trạng thái" data-i18n-en="Status">Trạng thái</th>
                            <th data-i18n data-i18n-vi="Vai trò" data-i18n-en="Role">Vai trò</th>
                            <th data-i18n data-i18n-vi="Thao tác" data-i18n-en="Actions">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var currentRole = RoleCatalog.GetHighestRole(user.Roles);
                            <tr>
                                <td>
                                    <div class="data-table__stack">
                                        <strong>@user.FullName</strong>
                                        <span>@user.Id</span>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-chip status-chip--success" data-i18n data-i18n-vi="Hoạt động" data-i18n-en="Active">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="status-chip status-chip--danger" data-i18n data-i18n-vi="Đã khóa" data-i18n-en="Locked">Đã khóa</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="UpdateUserRole" asp-controller="Admin" method="post" class="admin-inline-form admin-inline-form--auto-submit">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="newRole" class="admin-select admin-select--compact" onchange="this.form.submit()">
                                            @foreach (var role in roles)
                                            {
                                                if (role == currentRole)
                                                {
                                                    <option value="@role"
                                                            selected
                                                            data-i18n
                                                            data-i18n-vi="@GetRoleLabelVi(role)"
                                                            data-i18n-en="@GetRoleLabelEn(role)">
                                                        @GetRoleLabelVi(role)
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@role"
                                                            data-i18n
                                                            data-i18n-vi="@GetRoleLabelVi(role)"
                                                            data-i18n-en="@GetRoleLabelEn(role)">
                                                        @GetRoleLabelVi(role)
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="ToggleUserStatus" asp-controller="Admin" method="post">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="admin-button admin-button--danger" data-i18n data-i18n-vi="Khóa tài khoản" data-i18n-en="Lock account">Khóa tài khoản</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-button admin-button--secondary" data-i18n data-i18n-vi="Kích hoạt lại" data-i18n-en="Reactivate">Kích hoạt lại</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<div id="createUserModal" class="admin-modal is-hidden">
    <div class="admin-modal__backdrop" onclick="document.getElementById('createUserModal').classList.add('is-hidden')"></div>
    <div class="admin-modal__dialog">
        <div class="admin-modal__header">
            <div>
                <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Tạo tài khoản mới" data-i18n-en="Create a new account">Tạo tài khoản mới</p>
                <h3 data-i18n data-i18n-vi="Thêm người dùng" data-i18n-en="Add user">Thêm người dùng</h3>
            </div>
            <button type="button"
                    class="admin-modal__close"
                    onclick="document.getElementById('createUserModal').classList.add('is-hidden')"
                    aria-label="Đóng">
                &times;
            </button>
        </div>

        <form asp-action="CreateUser" asp-controller="Admin" method="post" class="admin-form-grid">
            <label class="admin-field">
                <span data-i18n data-i18n-vi="Họ và tên" data-i18n-en="Full name">Họ và tên</span>
                <input type="text" name="FullName" required placeholder="Nguyễn Văn A" />
            </label>

            <label class="admin-field">
                <span data-i18n data-i18n-vi="Email đăng nhập" data-i18n-en="Login email">Email đăng nhập</span>
                <input type="email" name="Email" required placeholder="email@example.com" />
            </label>

            <label class="admin-field">
                <span data-i18n data-i18n-vi="Mật khẩu khởi tạo" data-i18n-en="Temporary password">Mật khẩu khởi tạo</span>
                <input type="password" name="Password" required />
            </label>

            <label class="admin-field">
                <span data-i18n data-i18n-vi="Vai trò" data-i18n-en="Role">Vai trò</span>
                <select name="Role" class="admin-select">
                    @foreach (var role in roles)
                    {
                        <option value="@role" data-i18n data-i18n-vi="@GetRoleLabelVi(role)" data-i18n-en="@GetRoleLabelEn(role)">@GetRoleLabelVi(role)</option>
                    }
                </select>
            </label>

            <div class="admin-form-actions">
                <button type="submit" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Xác nhận tạo tài khoản" data-i18n-en="Create account">Xác nhận tạo tài khoản</button>
            </div>
        </form>
    </div>
</div>
