@model IEnumerable<GoldManagementSystem.Models.Order>
<style>
    /* Master-Detail Dashboard layout */
    .dashboard-layout {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 1.5rem;
        margin-top: 1.5rem;
        min-height: calc(100vh - 280px);
        align-items: start;
    }
    @@media (max-width: 992px) {
        .dashboard-layout {
            grid-template-columns: 1fr;
        }
    }

    /* Master Column: Order List & Tabs */
    .order-master-column {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(39, 37, 31, 0.07);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: 800px;
        overflow-y: auto;
    }

    /* Tab switcher */
    .order-tabs-scroll {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(39, 37, 31, 0.06);
    }
    .order-tabs-scroll::-webkit-scrollbar {
        height: 4px;
    }
    .order-tabs-scroll::-webkit-scrollbar-thumb {
        background: rgba(239, 122, 157, 0.2);
        border-radius: 4px;
    }
    .order-tab {
        white-space: nowrap;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        color: var(--brand-muted, #777);
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }
    .order-tab:hover {
        background: #fff8fa;
        color: #ef7a9d;
    }
    .order-tab.is-active {
        background: #fff3f6;
        color: #ef7a9d;
        border-color: rgba(239, 122, 157, 0.2);
    }

    /* Order list card */
    .order-list-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid rgba(39, 37, 31, 0.07);
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }
    .order-list-card:hover {
        border-color: rgba(239, 122, 157, 0.3);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(17, 17, 17, 0.02);
    }
    .order-list-card.is-selected {
        border-color: #ef7a9d;
        background: #fffdfd;
        box-shadow: 0 4px 15px rgba(239, 122, 157, 0.08);
    }
    .order-list-card__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
    }
    .order-list-card__title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #111;
    }
    .order-list-card__date {
        font-size: 0.7rem;
        color: var(--brand-muted, #888);
    }
    .order-list-card__amount {
        font-size: 0.84rem;
        font-weight: 700;
        color: #ef7a9d;
        margin-top: 0.25rem;
    }
    .order-list-card__customer {
        font-size: 0.78rem;
        color: #444;
        margin-top: 0.15rem;
    }

    /* Detail Column */
    .order-detail-column {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(39, 37, 31, 0.07);
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(17, 17, 17, 0.02);
        min-height: 500px;
    }

    .order-detail-panel {
        display: none;
        animation: fadeIn 0.35s ease;
    }
    
    .order-detail-card__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(39, 37, 31, 0.06);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }
    .order-detail-card__title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.65rem;
        font-weight: 700;
        color: #111;
    }

    /* Info sections */
    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }
    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }
    }
    .info-card {
        background: #fdfbf9;
        border: 1px solid rgba(39, 37, 31, 0.05);
        border-radius: 16px;
        padding: 1.25rem;
    }
    .info-card__title {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #b97a00;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        display: block;
    }
    .info-card__item {
        margin-bottom: 0.5rem;
        font-size: 0.84rem;
        line-height: 1.4;
    }
    .info-card__item span {
        color: var(--brand-muted, #777);
    }
    .info-card__item strong {
        color: #111;
    }

    /* Product row in detail table */
    .detail-product-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }
    .detail-product-row img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid rgba(39,37,31,0.06);
    }
    .detail-product-row a {
        font-size: 0.84rem;
        font-weight: 600;
        color: #ef7a9d;
        text-decoration: none;
    }
    .detail-product-row a:hover {
        text-decoration: underline;
    }

    /* Action bar */
    .actions-panel {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(39, 37, 31, 0.06);
    }

    .btn-action-panel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-weight: 700;
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 12px;
        padding: 0.65rem 1.25rem;
        min-height: 42px;
        transition: all 0.25s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }
    .btn-action-panel svg {
        width: 1.1rem;
        height: 1.1rem;
    }
    .btn-action-panel--primary {
        background: #ef7a9d;
        color: #fff;
        box-shadow: 0 4px 12px rgba(239, 122, 157, 0.25);
    }
    .btn-action-panel--primary:hover {
        background: #dd5e88;
        transform: translateY(-1px);
    }
    .btn-action-panel--success {
        background: #ebf8ef;
        color: #0f8b6d;
        border-color: rgba(15, 139, 109, 0.25);
    }
    .btn-action-panel--success:hover {
        background: #0f8b6d;
        color: #fff;
        transform: translateY(-1px);
    }
    .btn-action-panel--info {
        background: #ecf4ff;
        color: #1d5fd1;
        border-color: rgba(29, 95, 209, 0.25);
    }
    .btn-action-panel--info:hover {
        background: #1d5fd1;
        color: #fff;
        transform: translateY(-1px);
    }
    .btn-action-panel--warning {
        background: #fff7e5;
        color: #b97a00;
        border-color: rgba(185, 122, 0, 0.25);
    }
    .btn-action-panel--warning:hover {
        background: #b97a00;
        color: #fff;
        transform: translateY(-1px);
    }
    .btn-action-panel--danger {
        background: #fff1f0;
        color: #b42318;
        border-color: rgba(180, 35, 24, 0.2);
    }
    .btn-action-panel--danger:hover {
        background: #b42318;
        color: #fff;
        transform: translateY(-1px);
    }
    .btn-action-panel--disabled {
        background: #f5f2ee;
        color: #8b857d;
        border: 1px solid rgba(39, 37, 31, 0.08);
        cursor: not-allowed;
        opacity: 0.65;
    }

    /* Custom Confirm Modal */
    .custom-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10100;
        animation: modalFadeIn 0.2s ease;
    }
    .custom-modal.is-active {
        display: flex;
    }
    .custom-modal__backdrop {
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgba(17, 17, 17, 0.35);
        backdrop-filter: blur(4px);
    }
    .custom-modal__dialog {
        background: #fff;
        border-radius: 24px;
        padding: 1.75rem;
        max-width: 480px;
        width: 90%;
        box-shadow: 0 15px 45px rgba(17, 17, 17, 0.2);
        z-index: 10102;
        position: relative;
        animation: modalSlideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .custom-modal__title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 0.75rem;
    }
    .custom-modal__body {
        font-size: 0.85rem;
        color: #555;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }
    .custom-modal__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes modalSlideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    var pendingConfirmationCount = ViewBag.PendingConfirmationCount is int count ? count : 0;
    var actorRoles = ViewBag.ActorRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var isAdmin = actorRoles.Contains(GoldManagementSystem.Services.RoleCatalog.Admin);
    var isManager = actorRoles.Contains(GoldManagementSystem.Services.RoleCatalog.Manager);
    var isBranchOwner = actorRoles.Contains(GoldManagementSystem.Services.RoleCatalog.BranchOwner);
    var isStaff = actorRoles.Contains(GoldManagementSystem.Services.RoleCatalog.Staff);

    (string Vi, string En, string Modifier) GetStatusMeta(string status)
    {
        return status switch
        {
            GoldManagementSystem.Models.Order.StatusAwaitingDepositPayment => ("Chờ thanh toán cọc", "Awaiting deposit", "warning"),
            GoldManagementSystem.Models.Order.StatusUnpaidDeposit => ("Chưa thanh toán cọc", "Deposit unpaid", "neutral"),
            GoldManagementSystem.Models.Order.StatusPendingConfirmation => ("Chờ xác nhận", "Pending confirmation", "info"),
            GoldManagementSystem.Models.Order.StatusConfirmed => ("Đã xác nhận", "Confirmed", "success"),
            GoldManagementSystem.Models.Order.StatusProcessing => ("Đang xử lý", "Processing", "warning"),
            GoldManagementSystem.Models.Order.StatusShipping => ("Vận chuyển", "Shipping", "info"),
            GoldManagementSystem.Models.Order.StatusCompleted => ("Hoàn thành", "Completed", "success"),
            GoldManagementSystem.Models.Order.StatusCancelled => ("Đã hủy", "Cancelled", "danger"),
            _ => (status, status, "neutral")
        };
    }

    bool CanConfirmOrder(GoldManagementSystem.Models.Order order)
    {
        if (order.Status != GoldManagementSystem.Models.Order.StatusPendingConfirmation)
        {
            return false;
        }

        if (isAdmin || isManager || isBranchOwner)
        {
            return true;
        }

        return isStaff && order.TotalAmount <= 50000000m;
    }
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--compact">
        <div>
            <p class="admin-hero__eyebrow" data-i18n data-i18n-vi="Vận hành đơn hàng" data-i18n-en="Order operations">Vận hành đơn hàng</p>
            <h1 data-i18n data-i18n-vi="Quản lý Đơn Hàng" data-i18n-en="Order Management">Quản lý Đơn Hàng</h1>
            <p class="admin-hero__text" data-i18n data-i18n-vi="Xác thực cọc tiền mặt, phê duyệt đơn hàng theo hạn mức phân quyền và quản trị quy trình xử lý đơn hàng." data-i18n-en="Verify cash deposits, approve orders according to authority limits, and manage order fulfillment.">Xác thực cọc tiền mặt, phê duyệt đơn hàng theo hạn mức phân quyền và quản trị quy trình xử lý đơn hàng.</p>
        </div>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
        }
        @if (pendingConfirmationCount > 0)
        {
            <div class="admin-alert admin-alert--success">
                Có @pendingConfirmationCount đơn hàng mới đang chờ xác nhận theo thẩm quyền của bạn.
            </div>
        }

        <div class="dashboard-layout">
            <!-- Left Side: Order Master (Tabs & Card List) -->
            <div class="order-master-column">
                <!-- Tabs -->
                <div class="order-tabs-scroll">
                    <span class="order-tab is-active" data-tab-filter="all">Tất cả</span>
                    <span class="order-tab" data-tab-filter="pending-confirm">Chờ duyệt</span>
                    <span class="order-tab" data-tab-filter="pending-deposit">Chờ cọc</span>
                    <span class="order-tab" data-tab-filter="fulfillment">Đang xử lý</span>
                    <span class="order-tab" data-tab-filter="completed-cancelled">Đã xong/Hủy</span>
                </div>

                <!-- Search box -->
                <input type="text" id="orderSearchInput" placeholder="Tìm mã đơn hoặc tên khách..." style="width:100%; border-radius:10px; padding:0.6rem 0.85rem; border:1px solid rgba(39,37,31,0.08); font-size:0.8rem;" />

                <!-- Order Cards Container -->
                <div id="orderCardsList" style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var order in Model)
                    {
                        var statusMeta = GetStatusMeta(order.Status);
                        var customerName = order.CustomerName ?? order.User?.FullName ?? "Khách lẻ";
                        
                        <div class="order-list-card" 
                             id="order-card-@order.Id"
                             data-order-id="@order.Id"
                             data-status="@order.Status"
                             data-search-term="@order.OrderNumber.ToLower() @customerName.ToLower()">
                            <div class="order-list-card__header">
                                <span class="order-list-card__title">#@order.OrderNumber</span>
                                <span class="status-chip status-chip--@statusMeta.Modifier" style="font-size:0.65rem; padding:0.25rem 0.45rem;">
                                    @statusMeta.Vi
                                </span>
                            </div>
                            <div class="order-list-card__customer">@customerName</div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 0.35rem;">
                                <span class="order-list-card__date">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="order-list-card__amount">@order.TotalAmount.ToString("N0") ₫</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Side: Order Detail (Panel View) -->
            <div class="order-detail-column">
                <!-- Empty State -->
                <div id="empty-detail-state" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 400px; text-align: center; color: var(--brand-muted, #888);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 4rem; height: 4rem; color: #ef7a9d; margin-bottom: 1rem;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 700; color: #111;">Chi tiết đơn hàng</h3>
                    <p style="font-size:0.84rem; max-width: 280px; margin-top:0.25rem;">Chọn một đơn hàng từ danh sách bên trái để xem chi tiết và thực hiện xử lý.</p>
                </div>

                @foreach (var order in Model)
                {
                    var statusMeta = GetStatusMeta(order.Status);
                    var canConfirm = CanConfirmOrder(order);
                    var customerName = order.CustomerName ?? order.User?.FullName ?? "Khách lẻ";
                    var customerPhone = order.CustomerPhone ?? order.User?.PhoneNumber ?? "--";

                    <div class="order-detail-panel" id="order-detail-@order.Id" data-detail-id="@order.Id">
                        <div class="order-detail-card__header">
                            <div>
                                <h2 class="order-detail-card__title">Đơn hàng #@order.OrderNumber</h2>
                                <p style="font-size: 0.78rem; color: var(--brand-muted, #777); margin-top: 0.15rem;">
                                    Ngày tạo: @order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <span class="status-chip status-chip--@statusMeta.Modifier" style="font-size: 0.85rem; padding: 0.4rem 0.85rem;">
                                @statusMeta.Vi
                            </span>
                        </div>

                        <!-- Customer & Branch Grid -->
                        <div class="detail-grid">
                            <div class="info-card">
                                <span class="info-card__title">Khách hàng nhận</span>
                                <div class="info-card__item">
                                    <span>Họ tên:</span> <strong>@customerName</strong>
                                </div>
                                <div class="info-card__item">
                                    <span>Điện thoại:</span> <strong>@customerPhone</strong>
                                </div>
                                <div class="info-card__item">
                                    <span>Tài khoản tạo:</span> <strong>@(order.User?.Email ?? "--")</strong>
                                </div>
                            </div>

                            <div class="info-card">
                                <span class="info-card__title">Chi nhánh & Thanh toán</span>
                                <div class="info-card__item">
                                    <span>Chi nhánh:</span> <strong>@(order.Branch?.BranchName ?? "--")</strong>
                                </div>
                                <div class="info-card__item">
                                    <span>Địa chỉ:</span> <strong style="font-size: 0.78rem;">@(order.Branch?.Address ?? "--")</strong>
                                </div>
                                <div class="info-card__item">
                                    <span>Phương thức cọc:</span> 
                                    <strong>@(order.PaymentMethod == "OnlineDeposit" ? "Online (Cổng thẻ)" : "Tiền mặt tại quầy")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Order items table -->
                        <h3 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 0.75rem; color: #111;">Sản phẩm đặt mua</h3>
                        <div class="table-shell" style="margin-bottom: 1.5rem; border: 1px solid rgba(39,37,31,0.06); border-radius: 16px;">
                            <table class="data-table" style="box-shadow: none; border-radius: 16px;">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th>Số lượng</th>
                                        <th style="text-align: right;">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in order.OrderDetails ?? Enumerable.Empty<GoldManagementSystem.Models.OrderDetail>())
                                    {
                                        var detailImg = detail.Product?.GalleryImages.Any() == true
                                            ? detail.Product.GalleryImages.First()
                                            : "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1200&q=80";
                                        <tr>
                                            <td>
                                                <div class="detail-product-row">
                                                    <img src="@detailImg" alt="@detail.Product?.Name" />
                                                    <div style="display: flex; flex-direction: column;">
                                                        <a href="/Products/Details/@detail.ProductId" target="_blank">@detail.Product?.Name</a>
                                                        <span style="font-size: 0.72rem; color: var(--brand-muted, #777);">@detail.Product?.Category / @detail.Product?.GoldType</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@detail.UnitPrice.ToString("N0") ₫</td>
                                            <td>@detail.Quantity</td>
                                            <td style="text-align: right; font-weight: 700; color: #111;">@((detail.UnitPrice * detail.Quantity).ToString("N0")) ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Price summary cards -->
                        <div style="background: #faf8f5; border-radius: 16px; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.65rem;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #555;">
                                <span>Tiền cọc quy định (10%)</span>
                                <strong>@order.DepositAmount.ToString("N0") ₫</strong>
                            </div>
                            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #555;">
                                <span>Trạng thái cọc</span>
                                <strong style="color: @(order.DepositPaidAt.HasValue ? "#0f8b6d" : "#b97a00");">
                                    @(order.DepositPaidAt.HasValue ? $"Đã thanh toán ({order.DepositPaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")})" : "Chưa đặt cọc")
                                </strong>
                            </div>
                            @if (!order.DepositPaidAt.HasValue && order.DepositDueAt.HasValue)
                            {
                                <div style="display: flex; justify-content: space-between; font-size: 0.82rem; color: #b42318;">
                                    <span>Hạn chót thanh toán cọc</span>
                                    <span>@order.DepositDueAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                            <div style="display: flex; justify-content: space-between; font-size: 1.15rem; color: #111; font-weight: 700; border-top: 1px dashed rgba(39,37,31,0.1); padding-top: 0.65rem; margin-top: 0.25rem;">
                                <span>Tổng cộng đơn giá trị</span>
                                <span style="color: #ef7a9d;">@order.TotalAmount.ToString("N0") ₫</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(order.CancelReason))
                            {
                                <div style="margin-top: 0.5rem; background: #fff1f0; padding: 0.75rem; border-radius: 8px; font-size: 0.8rem; color: #b42318; border: 1px solid rgba(180,35,24,0.1);">
                                    <strong>Lý do hủy/từ chối:</strong> @order.CancelReason
                                </div>
                            }
                        </div>

                        <!-- Actions Control panel -->
                        <div class="actions-panel">
                            @if (order.Status == GoldManagementSystem.Models.Order.StatusUnpaidDeposit
                                || order.Status == GoldManagementSystem.Models.Order.StatusAwaitingDepositPayment)
                            {
                                <button type="button" 
                                        class="btn-action-panel btn-action-panel--warning"
                                        onclick="showConfirmDialog(@order.Id, '@GoldManagementSystem.Models.Order.StatusPendingConfirmation', 'Nhận cọc đơn hàng', 'Bạn có chắc chắn muốn xác nhận đã nhận cọc tiền mặt cho đơn hàng #@order.OrderNumber này?')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Nhận cọc
                                </button>
                            }
                            else if (order.Status == GoldManagementSystem.Models.Order.StatusPendingConfirmation)
                            {
                                if (canConfirm)
                                {
                                    <button type="button" 
                                            class="btn-action-panel btn-action-panel--primary"
                                            onclick="showConfirmDialog(@order.Id, '@GoldManagementSystem.Models.Order.StatusConfirmed', 'Duyệt đơn hàng', 'Bạn có chắc chắn muốn xác nhận duyệt đơn hàng #@order.OrderNumber này?')">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        Duyệt đơn
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-action-panel btn-action-panel--disabled" disabled title="Đơn giá trị từ 50 triệu trở lên yêu cầu quyền Quản lý/Admin duyệt.">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                                        </svg>
                                        Chờ cấp trên duyệt (Đơn &ge; 50 triệu)
                                    </button>
                                }
                            }
                            else if (order.Status == GoldManagementSystem.Models.Order.StatusConfirmed)
                            {
                                <button type="button" 
                                        class="btn-action-panel btn-action-panel--info"
                                        onclick="showConfirmDialog(@order.Id, '@GoldManagementSystem.Models.Order.StatusProcessing', 'Bắt đầu xử lý', 'Bạn muốn chuyển trạng thái đơn hàng này sang Đang xử lý?')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21a2.67 2.67 0 002.5-3.5L13.92 11.67m-3.75 3.75L3 7.5a2.67 2.67 0 013.5-3.5l7.67 7.67m-3.5 4.5L17.25 15m-3 1.5l1.5-1.5M8.25 8.25h.008v.008H8.25V8.25z" />
                                    </svg>
                                    Chuyển xử lý
                                </button>
                            }
                            else if (order.Status == GoldManagementSystem.Models.Order.StatusProcessing)
                            {
                                <button type="button" 
                                        class="btn-action-panel btn-action-panel--warning"
                                        onclick="showConfirmDialog(@order.Id, '@GoldManagementSystem.Models.Order.StatusShipping', 'Bắt đầu giao hàng', 'Xác nhận đơn hàng bắt đầu được vận chuyển?')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.75A1.125 1.125 0 012.625 17.625V4.625A1.125 1.125 0 013.75 3.5h12.75a1.125 1.125 0 011.125 1.125v1.25m-11 13c0-1.104.896-2 2-2h6a2 2 0 012 2m-10 0H3m10.5 0a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0m3 0h5.25M16.5 7.5h3.375a1.125 1.125 0 011.125 1.125v3.5m-5.625-4.625v4.625m0 0h5.625m-5.625 0v1.5m6.75-3v3" />
                                    </svg>
                                    Giao hàng
                                </button>
                            }
                            else if (order.Status == GoldManagementSystem.Models.Order.StatusShipping)
                            {
                                <button type="button" 
                                        class="btn-action-panel btn-action-panel--success"
                                        onclick="showConfirmDialog(@order.Id, '@GoldManagementSystem.Models.Order.StatusCompleted', 'Hoàn thành đơn hàng', 'Bạn xác nhận đơn hàng này đã hoàn tất mua hàng thành công?')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Hoàn thành
                                </button>
                            }

                            @if (order.Status != GoldManagementSystem.Models.Order.StatusCancelled
                                && order.Status != GoldManagementSystem.Models.Order.StatusCompleted)
                            {
                                <button type="button" 
                                        class="btn-action-panel btn-action-panel--danger"
                                        onclick="showCancelReasonDialog(@order.Id)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Hủy đơn
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Hidden action form -->
<form id="actionSubmitForm" asp-action="UpdateOrderStatus" asp-controller="Admin" method="post" style="display:none;">
    <input type="hidden" name="orderId" id="formOrderId" />
    <input type="hidden" name="newStatus" id="formNewStatus" />
    <input type="hidden" name="cancelReason" id="formCancelReason" />
</form>

<!-- 1. Custom General Confirm Modal -->
<div class="custom-modal" id="confirmModal">
    <div class="custom-modal__backdrop" onclick="closeConfirmDialog()"></div>
    <div class="custom-modal__dialog">
        <h3 class="custom-modal__title" id="confirmModalTitle">Xác nhận</h3>
        <p class="custom-modal__body" id="confirmModalBody">Bạn chắc chắn muốn thực hiện?</p>
        <div class="custom-modal__actions">
            <button type="button" class="admin-button admin-button--ghost" onclick="closeConfirmDialog()">Quay lại</button>
            <button type="button" class="admin-button admin-button--primary" id="confirmModalSubmitBtn">Xác nhận</button>
        </div>
    </div>
</div>

<!-- 2. Custom Cancel Reason Modal -->
<div class="custom-modal" id="cancelReasonModal">
    <div class="custom-modal__backdrop" onclick="closeCancelReasonDialog()"></div>
    <div class="custom-modal__dialog">
        <h3 class="custom-modal__title" style="color: #b42318;">Lý do hủy đơn hàng</h3>
        <p class="custom-modal__body" style="margin-bottom:0.75rem;">Vui lòng ghi rõ lý do từ chối/hủy đơn này. Thông tin lý do sẽ được cập nhật vào đơn hàng và thông báo trực tiếp cho khách hàng.</p>
        
        <textarea id="cancelReasonTextarea" placeholder="Nhập lý do hủy đơn (bắt buộc)..." style="width:100%; min-height:100px; border-radius:12px; padding:0.75rem; border:1px solid rgba(39,37,31,0.15); font-family:inherit; font-size:0.84rem; margin-top:0.5rem; outline:none; resize:vertical;"></textarea>
        <div id="cancelReasonErrorMsg" style="color:#b42318; font-size:0.75rem; font-weight:600; display:none; margin-top:0.25rem;">Vui lòng nhập lý do từ chối/hủy đơn.</div>
        
        <div class="custom-modal__actions" style="margin-top:1.5rem;">
            <button type="button" class="admin-button admin-button--ghost" onclick="closeCancelReasonDialog()">Quay lại</button>
            <button type="button" class="admin-button admin-button--primary" id="cancelReasonSubmitBtn" style="background:#b42318;">Hủy đơn hàng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dialog Globals
        let activeOrderId = null;
        let activeNewStatus = null;

        // Custom Confirm Dialog handlers
        window.showConfirmDialog = function(orderId, newStatus, title, body) {
            activeOrderId = orderId;
            activeNewStatus = newStatus;
            
            document.getElementById("confirmModalTitle").textContent = title;
            document.getElementById("confirmModalBody").textContent = body;
            document.getElementById("confirmModal").classList.add("is-active");
        }

        window.closeConfirmDialog = function() {
            document.getElementById("confirmModal").classList.remove("is-active");
            activeOrderId = null;
            activeNewStatus = null;
        }

        document.getElementById("confirmModalSubmitBtn").addEventListener("click", function() {
            if (activeOrderId && activeNewStatus) {
                document.getElementById("formOrderId").value = activeOrderId;
                document.getElementById("formNewStatus").value = activeNewStatus;
                document.getElementById("formCancelReason").value = "";
                document.getElementById("actionSubmitForm").submit();
            }
        });

        // Cancel Reason Dialog handlers
        window.showCancelReasonDialog = function(orderId) {
            activeOrderId = orderId;
            document.getElementById("cancelReasonTextarea").value = "";
            document.getElementById("cancelReasonErrorMsg").style.display = "none";
            document.getElementById("cancelReasonModal").classList.add("is-active");
        }

        window.closeCancelReasonDialog = function() {
            document.getElementById("cancelReasonModal").classList.remove("is-active");
            activeOrderId = null;
        }

        document.getElementById("cancelReasonSubmitBtn").addEventListener("click", function() {
            const reason = document.getElementById("cancelReasonTextarea").value.trim();
            if (!reason) {
                document.getElementById("cancelReasonErrorMsg").style.display = "block";
                return;
            }

            if (activeOrderId) {
                document.getElementById("formOrderId").value = activeOrderId;
                document.getElementById("formNewStatus").value = "@GoldManagementSystem.Models.Order.StatusCancelled";
                document.getElementById("formCancelReason").value = reason;
                document.getElementById("actionSubmitForm").submit();
            }
        });


        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll(".order-tab");
            const cards = document.querySelectorAll(".order-list-card");
            const searchInput = document.getElementById("orderSearchInput");

            // Filter order cards based on selected tab & search text
            function filterCards() {
                const activeTab = document.querySelector(".order-tab.is-active");
                const filter = activeTab ? activeTab.getAttribute("data-tab-filter") : "all";
                const searchVal = searchInput.value.toLowerCase().trim();

                cards.forEach(card => {
                    const status = card.getAttribute("data-status");
                    const searchTerm = card.getAttribute("data-search-term");
                    
                    let matchesTab = false;
                    if (filter === "all") {
                        matchesTab = true;
                    } else if (filter === "pending-confirm") {
                        matchesTab = (status === "@GoldManagementSystem.Models.Order.StatusPendingConfirmation");
                    } else if (filter === "pending-deposit") {
                        matchesTab = (status === "@GoldManagementSystem.Models.Order.StatusAwaitingDepositPayment" || status === "@GoldManagementSystem.Models.Order.StatusUnpaidDeposit");
                    } else if (filter === "fulfillment") {
                        matchesTab = (status === "@GoldManagementSystem.Models.Order.StatusProcessing" || status === "@GoldManagementSystem.Models.Order.StatusShipping");
                    } else if (filter === "completed-cancelled") {
                        matchesTab = (status === "@GoldManagementSystem.Models.Order.StatusCompleted" || status === "@GoldManagementSystem.Models.Order.StatusCancelled");
                    }

                    const matchesSearch = !searchVal || searchTerm.includes(searchVal);
                    
                    if (matchesTab && matchesSearch) {
                        card.style.display = "block";
                    } else {
                        card.style.display = "none";
                    }
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener("click", function () {
                    tabs.forEach(t => t.classList.remove("is-active"));
                    this.classList.add("is-active");
                    filterCards();

                    // Select the first visible card in the filtered list automatically
                    const firstVisibleCard = Array.from(cards).find(c => c.style.display !== "none");
                    if (firstVisibleCard) {
                        firstVisibleCard.click();
                    } else {
                        document.getElementById("empty-detail-state").style.display = "flex";
                        document.querySelectorAll(".order-detail-panel").forEach(p => p.style.display = "none");
                    }
                });
            });

            searchInput.addEventListener("input", filterCards);

            // Card Click Handler to open Detail view
            cards.forEach(card => {
                card.addEventListener("click", function () {
                    cards.forEach(c => c.classList.remove("is-selected"));
                    this.classList.add("is-selected");

                    const orderId = this.getAttribute("data-order-id");
                    document.getElementById("empty-detail-state").style.display = "none";
                    
                    document.querySelectorAll(".order-detail-panel").forEach(p => {
                        if (p.getAttribute("data-detail-id") === orderId) {
                            p.style.display = "block";
                        } else {
                            p.style.display = "none";
                        }
                    });
                });
            });

            // Read ?orderId=XXX from query parameters
            const urlParams = new URLSearchParams(window.location.search);
            const orderIdParam = urlParams.get('orderId');
            if (orderIdParam) {
                const targetCard = document.getElementById('order-card-' + orderIdParam);
                if (targetCard) {
                    // Force selecting the All tab to make it visible
                    document.querySelector('.order-tab[data-tab-filter="all"]').click();
                    
                    // Highlight & select card
                    targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    targetCard.click();
                    
                    targetCard.style.transition = 'background-color 0.5s ease';
                    targetCard.style.backgroundColor = 'rgba(239, 122, 157, 0.15)';
                    
                    setTimeout(() => {
                        targetCard.style.backgroundColor = '';
                    }, 3000);
                }
            } else {
                // By default select first visible card
                const firstCard = Array.from(cards).find(c => c.style.display !== "none");
                if (firstCard) {
                    firstCard.click();
                }
            }
        });
    </script>
}
