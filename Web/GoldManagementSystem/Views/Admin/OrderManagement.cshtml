@model IEnumerable<GoldManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";

    (string Vi, string En, string Modifier) GetStatusMeta(string status)
    {
        return status switch
        {
            "Hoàn thành" => ("Hoàn thành", "Completed", "success"),
            "Đã hủy" => ("Đã hủy", "Cancelled", "danger"),
            "Vận chuyển" => ("Vận chuyển", "Shipping", "info"),
            "Đang xử lý" => ("Đang xử lý", "Processing", "warning"),
            _ => (status, status, "neutral")
        };
    }
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--compact">
        <div>
            <p class="admin-hero__eyebrow" data-i18n data-i18n-vi="Vận hành đơn hàng" data-i18n-en="Order operations">Vận hành đơn hàng</p>
            <h1 data-i18n data-i18n-vi="Toàn bộ đơn hàng" data-i18n-en="All orders">Toàn bộ đơn hàng</h1>
            <p class="admin-hero__text" data-i18n data-i18n-vi="Theo dõi khách mua, chi nhánh xử lý và cập nhật trạng thái giao dịch nhanh hơn." data-i18n-en="Monitor customers, handling branches, and transaction status updates in one place.">Theo dõi khách mua, chi nhánh xử lý và cập nhật trạng thái giao dịch nhanh hơn.</p>
        </div>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        }

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Danh sách xử lý" data-i18n-en="Processing queue">Danh sách xử lý</p>
                    <h2 data-i18n data-i18n-vi="Cập nhật trạng thái đơn hàng" data-i18n-en="Update order status">Cập nhật trạng thái đơn hàng</h2>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-shell">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n data-i18n-vi="Mã đơn" data-i18n-en="Order no.">Mã đơn</th>
                                <th data-i18n data-i18n-vi="Khách hàng" data-i18n-en="Customer">Khách hàng</th>
                                <th data-i18n data-i18n-vi="Chi nhánh" data-i18n-en="Branch">Chi nhánh</th>
                                <th data-i18n data-i18n-vi="Ngày đặt" data-i18n-en="Order date">Ngày đặt</th>
                                <th data-i18n data-i18n-vi="Tổng tiền" data-i18n-en="Total">Tổng tiền</th>
                                <th data-i18n data-i18n-vi="Trạng thái" data-i18n-en="Status">Trạng thái</th>
                                <th data-i18n data-i18n-vi="Hành động" data-i18n-en="Action">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var status = GetStatusMeta(order.Status);
                                <tr>
                                    <td class="data-table__strong">#@order.OrderNumber</td>
                                    <td>
                                        <div class="data-table__stack">
                                            <strong>@(order.CustomerName ?? order.User?.FullName ?? "Khách lẻ")</strong>
                                            <span>@(order.CustomerPhone ?? order.User?.PhoneNumber ?? "--")</span>
                                        </div>
                                    </td>
                                    <td>@(order.Branch?.BranchName ?? "--")</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="data-table__accent">@order.TotalAmount.ToString("N0") ₫</td>
                                    <td>
                                        <span class="status-chip status-chip--@status.Modifier"
                                              data-i18n
                                              data-i18n-vi="@status.Vi"
                                              data-i18n-en="@status.En">
                                            @status.Vi
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-action="UpdateOrderStatus" asp-controller="Admin" method="post" class="admin-inline-form">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <select name="newStatus" class="admin-select admin-select--compact">
                                                <option value="Đang xử lý" data-i18n data-i18n-vi="Đang xử lý" data-i18n-en="Processing">Đang xử lý</option>
                                                <option value="Vận chuyển" data-i18n data-i18n-vi="Vận chuyển" data-i18n-en="Shipping">Vận chuyển</option>
                                                <option value="Hoàn thành" data-i18n data-i18n-vi="Hoàn thành" data-i18n-en="Completed">Hoàn thành</option>
                                                <option value="Đã hủy" data-i18n data-i18n-vi="Đã hủy" data-i18n-en="Cancelled">Đã hủy</option>
                                            </select>
                                            <button type="submit" class="admin-icon-button" title="Lưu trạng thái">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-card">
                    <h3 data-i18n data-i18n-vi="Chưa có đơn hàng nào" data-i18n-en="No orders found">Chưa có đơn hàng nào</h3>
                    <p data-i18n data-i18n-vi="Khi hệ thống phát sinh giao dịch, danh sách sẽ xuất hiện tại đây." data-i18n-en="Once transactions are created, they will appear here.">Khi hệ thống phát sinh giao dịch, danh sách sẽ xuất hiện tại đây.</p>
                </div>
            }
        </section>
    </div>
</div>
