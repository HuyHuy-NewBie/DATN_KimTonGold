@model IEnumerable<GoldManagementSystem.Models.Product>
@using System.Collections.Generic
@using System.Linq
@{
    ViewData["Title"] = "Sản Phẩm Yêu Thích";
    const string fallbackImageUrl = "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=900&q=80";
}

<div class="dashboard-card profile-shell">
    <section class="profile-shell__hero">
        <div>
            <p class="profile-shell__eyebrow" data-i18n data-i18n-vi="Bộ sưu tập cá nhân" data-i18n-en="Saved collection">Bộ sưu tập cá nhân</p>
            <h1 data-i18n data-i18n-vi="Sản phẩm yêu thích" data-i18n-en="Favorite products">Sản phẩm yêu thích</h1>
            <p data-i18n data-i18n-vi="Những mẫu bạn đã lưu sẽ nằm tại đây để xem lại nhanh, so sánh giá và quay lại mua sau." data-i18n-en="The pieces you save appear here so you can review them quickly, compare prices, and come back later.">Những mẫu bạn đã lưu sẽ nằm tại đây để xem lại nhanh, so sánh giá và quay lại mua sau.</p>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state-card empty-state-card--heart">
            <div class="empty-state-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.5-.9-.82C5.2 14.3 2 11.38 2 7.8a5 5 0 0 1 9.5-2.2A5 5 0 0 1 21 7.8c0 3.58-3.2 6.5-9.1 11.88l-.9.82Z" />
                </svg>
            </div>
            <h3 data-i18n data-i18n-vi="Chưa có sản phẩm yêu thích nào" data-i18n-en="No favorites yet">Chưa có sản phẩm yêu thích nào</h3>
            <p data-i18n data-i18n-vi="Lưu lại các mẫu bạn quan tâm để theo dõi dễ hơn trong những lần ghé lại sau." data-i18n-en="Save the pieces you like so they are easier to revisit later.">Lưu lại các mẫu bạn quan tâm để theo dõi dễ hơn trong những lần ghé lại sau.</p>
            <a href="/Products" class="admin-button admin-button--primary" data-i18n data-i18n-vi="Khám phá sản phẩm" data-i18n-en="Browse products">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="favorites-grid favorites-grid--catalog">
            @foreach (var product in Model)
            {
                var galleryImages = product.GalleryImages.Any()
                    ? product.GalleryImages.Take(3).ToList()
                    : new List<string> { fallbackImageUrl };
                var badge = product.Status == "Mới" || product.Status == "Bán chạy" ? product.Status : null;
                var badgeEn = badge == "Mới" ? "New" : badge == "Bán chạy" ? "Best seller" : badge;
                var branchName = product.Branch?.BranchName ?? "Trụ sở chính";
                var branchNameEn = product.Branch?.BranchName ?? "Head office";

                <article class="product-card-shell favorite-catalog-card" data-favorite-card>
                    <div class="favorite-catalog-card__image-wrap">
                        <a href="/Products/Details/@product.Id" class="product-card-shell__image">
                            <div class="product-card-shell__gallery"
                                 data-rotating-gallery="@(galleryImages.Count > 1 ? "true" : "false")"
                                 data-rotation-interval="3800">
                                @for (var index = 0; index < galleryImages.Count; index++)
                                {
                                    var image = galleryImages[index];
                                    <img src="@image"
                                         alt="@product.Name"
                                         class="@(index == 0 ? "is-active" : string.Empty)"
                                         onerror="this.onerror=null;this.src='@fallbackImageUrl';"
                                         loading="lazy" />
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(badge))
                            {
                                <span class="product-card-shell__badge"
                                      data-i18n
                                      data-i18n-vi="@badge"
                                      data-i18n-en="@badgeEn">
                                    @badge
                                </span>
                            }

                            <span class="product-card-shell__overlay"
                                  data-i18n
                                  data-i18n-vi="Xem chi tiết"
                                  data-i18n-en="View details">
                                Xem chi tiết
                            </span>
                        </a>

                        <form method="post" action="/User/ToggleFavorite" data-favorite-form class="favorite-catalog-card__toggle-form">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit"
                                    class="favorite-product-card__toggle"
                                    title="Bỏ yêu thích"
                                    aria-label="Bỏ yêu thích">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10 17.2 3.52 10.7a4.1 4.1 0 1 1 5.8-5.8L10 5.58l.68-.68a4.1 4.1 0 1 1 5.8 5.8L10 17.2Z" />
                                </svg>
                            </button>
                        </form>
                    </div>

                    <div class="product-card-shell__body favorite-catalog-card__body">
                        <p class="product-card-shell__meta" data-auto-i18n>@product.GoldType</p>
                        <h3 class="product-card-shell__title">
                            <a href="/Products/Details/@product.Id" data-auto-i18n>@product.Name</a>
                        </h3>
                        <div class="product-card-shell__facts">
                            <span data-auto-i18n>@product.Category</span>
                            <span data-i18n data-i18n-vi="@($"{product.Weight:0.#} chỉ")" data-i18n-en="@($"{product.Weight:0.#} tael")">@product.Weight.ToString("0.#") chỉ</span>
                        </div>
                        <p class="product-card-shell__price">@product.SellPrice.ToString("N0") ₫</p>
                        <p class="favorite-catalog-card__branch" data-i18n data-i18n-vi="@($"Chi nhánh: {branchName}")" data-i18n-en="@($"Branch: {branchNameEn}")">Chi nhánh: @branchName</p>
                    </div>
                </article>
            }
        </div>
    }
</div>
