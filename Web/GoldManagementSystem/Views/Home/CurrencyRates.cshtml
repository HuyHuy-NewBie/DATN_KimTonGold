@{
    ViewData["Title"] = "Tỷ Giá Ngoại Tệ Hôm Nay";
}
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false }
    }
</script>
@using GoldManagementSystem.Models

<div class="bg-gray-50 min-h-screen py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-900 uppercase tracking-widest relative pb-4">
                Bảng Tỷ Giá Ngoại Tệ
                <span class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-green-500"></span>
            </h1>
            <p class="mt-4 text-gray-500">Dữ liệu được cập nhật tự động từ 24h.com.vn (Bảng niêm yết Vietcombank)</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- 1. Bảng Ngoại Tệ Trực Tiếp -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-green-50 flex items-center gap-2">
                    <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Tỷ Giá Hôm Nay</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-3 font-semibold">Ngoại Tệ</th>
                                <th class="px-6 py-3 font-semibold">Mua Tiền Mặt</th>
                                <th class="px-6 py-3 font-semibold">Bán Ra</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @foreach (var rate in ViewBag.CurrencyRates)
                            {
                                <tr class="hover:bg-green-50/50 transition">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center">
                                            <span class="font-bold text-gray-800 mr-2">@rate.Symbol</span>
                                            <span class="text-xs text-gray-500">(@rate.DisplayName)</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-medium text-green-600">@((rate.BuyPrice).ToString("N0") + " ₫")</td>
                                    <td class="px-6 py-4 font-medium text-red-600">@((rate.SellPrice).ToString("N0") + " ₫")</td>
                                </tr>
                            }
                            @if(((List<MarketHistory>)ViewBag.CurrencyRates).Count == 0)
                            {
                                <tr><td colspan="3" class="px-6 py-8 text-center text-gray-400">Đang chờ cập nhật dữ liệu...</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Biểu Đồ Tiền Tệ -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                    <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                    <h2 class="text-lg font-bold text-gray-800 uppercase">Biểu Đồ Xu Hướng (30 Ngày)</h2>
                </div>
                <div class="p-4 flex-grow relative h-64">
                    <canvas id="currencyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const prepareChartData = (historyList) => {
            if (!historyList || historyList.length === 0) return { labels: [], datasets: [] };
            
            const timestamps = [...new Set(historyList.map(h => new Date(h.Timestamp).toLocaleDateString('vi-VN')))];
            const types = [...new Set(historyList.map(h => h.Symbol))];
            
            const colors = ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#14b8a6'];
            
            const datasets = types.map((type, idx) => {
                const dataPoints = timestamps.map(time => {
                    const found = historyList.find(h => new Date(h.Timestamp).toLocaleDateString('vi-VN') === time && h.Symbol === type);
                    return found ? found.SellPrice : null;
                });
                
                return {
                    label: type,
                    data: dataPoints,
                    borderColor: colors[idx % colors.length],
                    backgroundColor: colors[idx % colors.length],
                    tension: 0.3,
                    borderWidth: 2,
                    pointRadius: 3,
                    spanGaps: true
                };
            });
            
            return { labels: timestamps, datasets: datasets };
        };

        const rawCurrencyHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HistoryCurrency));
        const currencyData = prepareChartData(rawCurrencyHistory);

        const ctx = document.getElementById('currencyChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: currencyData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
                },
                scales: {
                    y: { beginAtZero: false, ticks: { callback: function(value) { return value.toLocaleString() + 'đ'; } } }
                }
            }
        });
    });
</script>
