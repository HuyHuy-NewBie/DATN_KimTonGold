@model GoldManagementSystem.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng Ký - Hệ Thống Quản Lý Vàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
        (function() {
            var lang = localStorage.getItem("preferredLanguage") || "vi";
            document.documentElement.lang = lang;
            if (lang === "en") {
                document.documentElement.classList.add("lang-loading");
            }
        })();
    </script>
    <style>
        html.lang-loading [data-i18n] {
            opacity: 0 !important;
        }
    </style>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen p-4" style="font-family: 'Inter', sans-serif;">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
        <div class="p-8">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-yellow-500 mb-1">KIM<span class="text-slate-900">TON</span></h2>
                <p class="text-slate-500 text-sm" data-i18n data-i18n-vi="Tạo tài khoản bằng email hoặc số điện thoại" data-i18n-en="Create an account with email or phone number">Tạo tài khoản bằng email hoặc số điện thoại</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-600 p-3 rounded-lg text-sm mb-6 border border-red-100"></div>
            }

            @if (ViewBag.VerificationInfoMessage != null && Model?.RequiresVerification != true)
            {
                <div class="mb-6 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-700">
                    @ViewBag.VerificationInfoMessage
                </div>
            }

            @if (Model?.RequiresVerification == true)
            {
                <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-4 text-sm text-slate-700">
                    <p class="font-semibold text-slate-900" data-i18n data-i18n-vi="Bước 2: Xác nhận tạo tài khoản" data-i18n-en="Step 2: Confirm account creation">Bước 2: Xác nhận tạo tài khoản</p>
                    <p class="mt-1" data-i18n data-i18n-vi="Hệ thống đã gửi mã 6 số tới kênh bạn chọn. Chỉ sau khi nhập đúng mã, tài khoản mới được tạo." data-i18n-en="A 6-digit code has been sent to your selected channel. Your account will only be created after the correct code is entered.">Hệ thống đã gửi mã 6 số tới kênh bạn chọn. Chỉ sau khi nhập đúng mã, tài khoản mới được tạo.</p>
                    <p class="mt-2 text-sm font-medium text-emerald-700">@Model.VerificationDestinationDisplay</p>
                </div>

                @if (ViewBag.VerificationInfoMessage != null)
                {
                    <div class="mb-6 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-700">
                        @ViewBag.VerificationInfoMessage
                    </div>
                }

                <form asp-action="VerifyRegister" method="post">
                    <input asp-for="VerificationFlowId" type="hidden" />
                    <div class="space-y-4">
                        <div>
                            <label asp-for="VerificationCode" class="block text-sm font-medium text-slate-700 mb-1">Mã xác nhận</label>
                            <input asp-for="VerificationCode" autocomplete="one-time-code"
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                   placeholder="Nhập 6 chữ số" />
                            <span asp-validation-for="VerificationCode" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div class="grid gap-3 sm:grid-cols-3">
                            <button type="submit" class="w-full py-3 mt-2 bg-slate-900 text-white font-bold rounded-xl shadow-md shadow-slate-900/20 hover:bg-slate-800 transition-all active:scale-[0.98]">
                                Xác nhận và tạo tài khoản
                            </button>

                            <button type="submit"
                                    asp-action="ResendRegisterCode"
                                    formnovalidate
                                    class="w-full py-3 mt-2 bg-white text-slate-700 font-semibold rounded-xl border border-slate-200 hover:border-slate-400 hover:bg-slate-50 transition-all active:scale-[0.98]">
                                Cấp lại mã mới
                            </button>

                            <button type="submit"
                                    asp-action="CancelRegisterVerification"
                                    formnovalidate
                                    class="w-full py-3 mt-2 bg-white text-rose-700 font-semibold rounded-xl border border-rose-200 hover:border-rose-300 hover:bg-rose-50 transition-all active:scale-[0.98]">
                                Hủy xác nhận
                            </button>
                        </div>

                        <a asp-action="Register" class="block text-center text-sm font-medium text-blue-600 hover:text-blue-800">
                            Nhập lại thông tin đăng ký
                        </a>
                    </div>
                </form>
            }
            else
            {
                <form asp-action="Register" method="post">
                    <input asp-for="VerificationChannel" type="hidden" value="phone" />
                    <div class="space-y-4">
                        <div>
                            <label asp-for="FullName" class="block text-sm font-medium text-slate-700 mb-1" data-i18n data-i18n-vi="Họ và Tên" data-i18n-en="Full name">Họ và Tên</label>
                            <input asp-for="FullName"
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                   placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Identifier" class="block text-sm font-medium text-slate-700 mb-1" data-i18n data-i18n-vi="Gmail hoặc Số Điện Thoại" data-i18n-en="Email or phone number">Gmail hoặc Số Điện Thoại</label>
                            <input asp-for="Identifier" autocomplete="username"
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                   placeholder="nguyenvana@gmail.com hoặc 09xxxxxxxx" />
                            <span asp-validation-for="Identifier" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-1" data-i18n data-i18n-vi="Mật Khẩu" data-i18n-en="Password">Mật Khẩu</label>
                            <div class="relative">
                                <input asp-for="Password"
                                       autocomplete="new-password"
                                       id="register-password-input"
                                       class="w-full px-4 py-3 pr-20 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent transition"
                                       placeholder="••••••••" />
                                <button type="button"
                                        id="register-password-toggle"
                                        class="absolute inset-y-0 right-3 my-2 rounded-lg px-3 text-xs font-semibold text-slate-500 hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-yellow-400"
                                        aria-controls="register-password-input"
                                        aria-label="Hiện mật khẩu">
                                    Hiện
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-sm font-semibold text-slate-800">Xác nhận tài khoản</p>
                            <p class="mt-2 text-sm text-slate-600">Bạn có thể đăng ký bằng email hoặc số điện thoại. Hệ thống sẽ gửi mã xác nhận 6 số tới đúng thông tin bạn vừa nhập.</p>
                            <p class="mt-2 text-sm text-slate-600">Sau khi đăng nhập, bạn vẫn có thể bổ sung kênh liên hệ còn lại trong mục Thông tin tài khoản.</p>
                        </div>

                        <button type="submit" class="w-full py-3 mt-2 bg-slate-900 text-white font-bold rounded-xl shadow-md shadow-slate-900/20 hover:bg-slate-800 transition-all active:scale-[0.98]" data-i18n data-i18n-vi="Đăng Ký Tài Khoản" data-i18n-en="Create Account">
                            Đăng Ký Tài Khoản
                        </button>
                    </div>
                </form>
            }
        </div>
        <div class="bg-slate-50 p-6 text-center border-t border-slate-100 rounded-b-3xl">
            <p class="text-sm text-slate-600">
                <span data-i18n data-i18n-vi="Đã có tài khoản?" data-i18n-en="Already have an account?">Đã có tài khoản?</span>
                <a href="/Account/Login" class="font-semibold text-blue-600 hover:text-blue-800" data-i18n data-i18n-vi="Đăng nhập ngay" data-i18n-en="Log in">Đăng nhập ngay</a>
            </p>
        </div>
    </div>
    <a href="/" class="fixed top-4 left-4 p-2 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors" title="Trở về Trang Chủ">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
    </a>
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/site.js"></script>
    <script>
        (function () {
            var passwordInput = document.getElementById("register-password-input");
            var toggleButton = document.getElementById("register-password-toggle");

            if (!passwordInput || !toggleButton) {
                return;
            }

            function syncToggleLabel() {
                var isVisible = passwordInput.type === "text";
                var isEnglish = document.documentElement.lang === "en";
                var label = isVisible
                    ? (isEnglish ? "Hide" : "Ẩn")
                    : (isEnglish ? "Show" : "Hiện");
                var ariaLabel = isVisible
                    ? (isEnglish ? "Hide password" : "Ẩn mật khẩu")
                    : (isEnglish ? "Show password" : "Hiện mật khẩu");

                toggleButton.textContent = label;
                toggleButton.setAttribute("aria-label", ariaLabel);
                toggleButton.setAttribute("title", ariaLabel);
            }

            toggleButton.addEventListener("click", function () {
                passwordInput.type = passwordInput.type === "password" ? "text" : "password";
                syncToggleLabel();
            });

            syncToggleLabel();
        })();
    </script>
</body>
</html>
