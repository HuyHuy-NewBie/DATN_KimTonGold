@model GoldManagementSystem.Models.ViewModels.InventoryIssueManagementViewModel
@using GoldManagementSystem.Models
@using System.Linq

@{
    ViewData["Title"] = "Phiếu xuất kho";

    var displayWarehouses =
    ViewBag.DisplayWarehouses as List<Warehouse>
    ?? new List<Warehouse>();

    var issueReceivers =
    ViewBag.InventoryIssueReceivers as List<AppUser>
    ?? new List<AppUser>();
    var isAdmin =
        User.IsInRole("Admin");

    string GetStatusClass(string status)
    {
        return status switch
        {
            InventoryIssue.StatusPending =>
                "status-chip--warning",

            InventoryIssue.StatusIssued =>
                "status-chip--success",

            InventoryIssue.StatusCancelled =>
                "status-chip--neutral",

            _ => "status-chip--neutral"
        };
    }

    string GetTypeClass(string issueType)
    {
        return issueType switch
        {
            InventoryIssue.TypeSale =>
                "status-chip--info",

            InventoryIssue.TypeSupplierReturn =>
                "status-chip--warning",

            _ => "status-chip--neutral"
        };
    }
    var availableSuppliers =
    Model.AvailableItems
        .Where(item => item.Supplier != null)
        .Select(item => item.Supplier)
        .GroupBy(supplier => supplier.Id)
        .Select(group => group.First())
        .OrderBy(supplier => supplier.Name)
        .ToList();
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--split">
        <div>
            <p class="admin-hero__eyebrow">
                Nghiệp vụ kho
            </p>

            <h1>Phiếu xuất kho</h1>

            <p class="admin-hero__text">
                Lập và theo dõi các phiếu xuất hàng bán.
                Tồn kho chỉ bị trừ sau khi phiếu được
                xác nhận xuất kho.
            </p>
        </div>
        <button type="button"
                class="admin-button admin-button--primary"
                onclick="openInventoryIssueModal()">
            + Tạo phiếu xuất kho
        </button>
        <div class="admin-hero__actions">
            <a asp-action="InventoryManagement"
               asp-controller="Admin"
               asp-route-branchId="@Model.BranchId"
               class="admin-button admin-button--primary">
                Xem tồn kho
            </a>

            <a asp-action="InventoryHistory"
               asp-controller="Admin"
               asp-route-branchId="@Model.BranchId"
               class="admin-button admin-button--secondary">
                Lịch sử nhập - xuất
            </a>
        </div>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (ViewBag.InventoryScopeWarning != null)
        {
            <div class="admin-alert admin-alert--danger">
                @ViewBag.InventoryScopeWarning
            </div>
        }

        <section class="admin-stats-grid">
            <article class="admin-stat-card admin-stat-card--gold">
                <div class="admin-stat-card__content">
                    <p>Tổng phiếu</p>

                    <strong>
                        @(Model.TotalIssues.ToString("N0"))
                    </strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--blue">
                <div class="admin-stat-card__content">
                    <p>Chờ xuất kho</p>

                    <strong>
                        @(Model.PendingIssues.ToString("N0"))
                    </strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--green">
                <div class="admin-stat-card__content">
                    <p>Đã xuất kho</p>

                    <strong>
                        @(Model.IssuedIssues.ToString("N0"))
                    </strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--rose">
                <div class="admin-stat-card__content">
                    <p>Số lượng đã xuất</p>

                    <strong>
                        @(Model.TotalIssuedQuantity.ToString("N0"))
                    </strong>
                </div>
            </article>
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow">
                        Tra cứu
                    </p>

                    <h2>Lọc phiếu xuất kho</h2>
                </div>
            </div>

            <form asp-action="InventoryIssues"
                  asp-controller="Admin"
                  method="get"
                  class="admin-filter-grid">

                <label class="admin-field">
                    <span>Từ khóa</span>

                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Mã phiếu, người nhận, mã đơn..." />
                </label>

                @if (isAdmin)
                {
                    <label class="admin-field">
                        <span>Chi nhánh</span>

                        <select name="branchId"
                                asp-items="Model.BranchOptions"
                                class="admin-select"
                                onchange="this.form.submit()">
                        </select>
                    </label>
                }
                else
                {
                    <input type="hidden"
                           name="branchId"
                           value="@Model.BranchId" />
                }

                <label class="admin-field">
                    <span>Kho</span>

                    <select name="warehouseId"
                            asp-items="Model.WarehouseOptions"
                            class="admin-select">
                    </select>
                </label>
               

                <label class="admin-field">
                    <span>Trạng thái</span>

                    <select name="status"
                            asp-items="Model.StatusOptions"
                            class="admin-select">
                    </select>
                </label>

                <div class="admin-filter-actions admin-field--wide">
                    <button type="submit"
                            class="admin-button admin-button--primary">
                        Áp dụng
                    </button>

                    <a asp-action="InventoryIssues"
                       asp-controller="Admin"
                       asp-route-branchId="@Model.BranchId"
                       class="admin-button admin-button--secondary">
                        Xóa lọc
                    </a>
                </div>
            </form>
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow">
                        Danh sách
                    </p>

                    <h2>Các phiếu xuất kho</h2>
                </div>

                <span class="status-chip status-chip--info">
                    @Model.Issues.Count phiếu hiển thị
                </span>
            </div>

            <div class="admin-alert admin-alert--success">
                Phiếu chờ xuất chưa làm thay đổi tồn kho.
                Hãy xem chi tiết và xác nhận bàn giao để chuyển hàng ra quầy.
            </div>

            <div class="table-shell">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Loại xuất</th>
                            <th>Kho xuất → Quầy nhận</th>
                            <th>Người nhận tại quầy</th>
                            <th>Hàng hóa</th>
                            <th>Số lượng</th>
                            <th>Trạng thái</th>
                            <th>Ngày lập</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Issues.Any())
                        {
                            @foreach (var issue in Model.Issues)
                            {
                                var totalQuantity =
                                    issue.Details?.Sum(
                                        detail =>
                                            detail.Quantity) ?? 0;

                                var itemLines =
                                    issue.Details?.Count ?? 0;

                                <tr>
                                    <td>
                                        <div class="data-table__stack">
                                            <strong>
                                                @issue.IssueCode
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                issue.ReferenceCode))
                                            {
                                                <span>
                                                    Tham chiếu:
                                                    @issue.ReferenceCode
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status-chip @GetTypeClass(issue.IssueType)">
                                            @issue.IssueType
                                        </span>

                                        @if (issue.Supplier != null)
                                        {
                                            <div class="data-table__stack">
                                                <span>
                                                    @issue.Supplier.Name
                                                </span>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>
                                                @issue.Warehouse?.Name
                                            </strong>

                                            <span>
                                                → @(issue.DestinationWarehouse?.Name
                                                    ?? "Chưa xác định quầy")
                                            </span>

                                            <small>
                                                @issue.Branch?.BranchName
                                            </small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>
                                                @(issue.ReceiverUser?.FullName
                                                    ?? "Chưa xác định")
                                            </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(
                                                    issue.ReceiverUser?.Email)
                                                    ? "--"
                                                    : issue.ReceiverUser.Email)
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @itemLines dòng hàng
                                    </td>

                                    <td>
                                        <strong>
                                            @(totalQuantity.ToString("N0"))
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="status-chip @GetStatusClass(issue.Status)">
                                            @issue.Status
                                        </span>
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>
                                                @(issue.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("dd/MM/yyyy"))
                                            </strong>

                                            <span>
                                                @(issue.CreatedAt
                                                    .ToLocalTime()
                                                    .ToString("HH:mm"))
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="admin-button admin-button--secondary admin-button--small"
                                                onclick="openInventoryIssueDetailModal(@issue.Id)">
                                            Xem chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9  ">
                                    Chưa có phiếu xuất kho nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
<div id="inventoryIssueCreateModal"
     class="admin-modal is-hidden">

    <div class="admin-modal__backdrop"
         onclick="closeInventoryIssueModal()">
    </div>

    <div class="admin-modal__dialog issue-create-dialog">
        <div class="admin-modal__header issue-create-header">
            <div>
                <p class="admin-section__eyebrow">
                    Điều chuyển ra quầy
                </p>

                <h3>Tạo phiếu xuất ra quầy</h3>

                <span>
                    Chuyển hàng từ kho lưu trữ sang quầy trưng bày.
                </span>
            </div>

            <button type="button"
                    class="admin-modal__close"
                    onclick="closeInventoryIssueModal()">
                &times;
            </button>
        </div>

        <form asp-action="CreateInventoryIssue"
              asp-controller="Admin"
              method="post"
              id="inventoryIssueCreateForm">

            <input type="hidden"
                   name="BranchId"
                   id="inventoryIssueBranchId"
                   value="@Model.BranchId" />

            <section class="issue-create-information">
                <div class="issue-create-section-title">
                    <span>1</span>

                    <div>
                        <strong>Thông tin xuất hàng</strong>
                        <small>
                            Chọn kho xuất, quầy nhận và nhân viên chịu trách nhiệm
                        </small>
                    </div>
                </div>

                <div class="issue-create-form-grid">
                    <label class="admin-field">
                        <span>Kho xuất hàng *</span>

                        <select name="WarehouseId"
                                id="inventoryIssueWarehouse"
                                class="admin-select"
                                required>

                            <option value="">
                                -- Chọn kho xuất --
                            </option>

                            @foreach (var option
                                in Model.WarehouseOptions.Where(
                                    item =>
                                        !string.IsNullOrWhiteSpace(
                                            item.Value)))
                            {
                                <option value="@option.Value">
                                    @option.Text
                                </option>
                            }
                        </select>
                    </label>           
                    <label class="admin-field">
                        <span>Quầy trưng bày nhận hàng *</span>

                        <select name="DestinationWarehouseId"
                                id="inventoryIssueDestinationWarehouse"
                                class="admin-select"
                                required>
                            <option value="">
                                -- Chọn quầy nhận hàng --
                            </option>

                            @foreach (var warehouse in displayWarehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Code - @warehouse.Name
                                    · @warehouse.Branch?.BranchName
                                </option>
                            }
                        </select>
                    </label>

                    <label class="admin-field">
                        <span>Người nhận tại quầy *</span>

                        <select name="ReceiverUserId"
                                id="inventoryIssueReceiver"
                                class="admin-select"
                                required>
                            <option value="">
                                -- Chọn người nhận --
                            </option>

                            @foreach (var receiver in issueReceivers)
                            {
                                <option value="@receiver.Id">
                                    @receiver.FullName
                                    · @receiver.Branch?.BranchName
                                </option>
                            }
                        </select>
                    </label>
                    <label class="admin-field">
                        <span>Mã yêu cầu xuất</span>

                        <input type="text"
                               name="ReferenceCode"
                               maxlength="100"
                               placeholder="VD: YCX-2026-001" />
                    </label>

                    <label class="admin-field issue-create-field-wide">
                        <span>Ghi chú</span>

                        <textarea name="Note"
                                  maxlength="1000"
                                  rows="2"
                                  placeholder="Thông tin bổ sung, không bắt buộc"></textarea>
                    </label>
                </div>
            </section>

            <section class="issue-create-product-section">
                <div class="issue-create-section-title">
                    <span>2</span>

                    <div>
                        <strong>Chọn hàng xuất kho</strong>
                        <small>
                            Tìm theo mã tồn, tên hàng, chất liệu hoặc NCC
                        </small>
                    </div>
                </div>

                <div class="issue-product-picker">
                    <div class="issue-product-search-panel">
                        <div class="issue-search-toolbar">
                            <div class="issue-search-input">
                                <input type="search"
                                       id="inventoryIssueKeyword"
                                       placeholder="Tìm mã tồn, tên sản phẩm, chất liệu..." />

                                <button type="button"
                                        id="inventoryIssueSearchButton">
                                    Tìm kiếm
                                </button>
                            </div>

                            <span id="inventoryIssueSearchSummary">
                                Hãy chọn kho để xem hàng
                            </span>
                        </div>

                        <div id="inventoryIssueSearchState"
                             class="issue-search-state">
                            Chọn kho xuất hàng trước khi tìm kiếm.
                        </div>

                        <div id="inventoryIssueSearchResults"
                             class="issue-search-results">
                        </div>

                        <div id="inventoryIssuePagination"
                             class="issue-search-pagination"
                             hidden>

                            <button type="button"
                                    id="inventoryIssuePreviousPage">
                                ← Trước
                            </button>

                            <span id="inventoryIssuePageInfo">
                                Trang 1/1
                            </span>

                            <button type="button"
                                    id="inventoryIssueNextPage">
                                Sau →
                            </button>
                        </div>
                    </div>

                    <aside class="issue-selected-panel">
                        <div class="issue-selected-heading">
                            <div>
                                <strong>Hàng đã chọn</strong>

                                <small>
                                    Nhập số lượng và trọng lượng thực tế
                                </small>
                            </div>

                            <span id="inventoryIssueSelectedCount">
                                0
                            </span>
                        </div>

                        <div id="inventoryIssueSelectedItems"
                             class="issue-selected-list">

                            <div class="issue-selected-empty">
                                <strong>Chưa chọn sản phẩm</strong>

                                <span>
                                    Nhấn “Thêm” tại danh sách bên trái.
                                </span>
                            </div>
                        </div>
                    </aside>
                </div>
            </section>

            <div class="issue-create-actions">
                <button type="button"
                        class="admin-button admin-button--secondary"
                        onclick="closeInventoryIssueModal()">
                    Hủy
                </button>

                <button type="submit"
                        class="admin-button admin-button--primary">
                    Lưu phiếu chờ xuất
                </button>
            </div>
        </form>
    </div>
</div>
@foreach (var issue in Model.Issues)
{
    var totalQuantity =
        issue.Details?.Sum(detail =>
            detail.Quantity) ?? 0;

    var totalValue =
        issue.Details?.Sum(detail =>
            detail.LineValue) ?? 0m;

    <div id="inventoryIssueDetailModal-@issue.Id"
         class="admin-modal is-hidden">

        <div class="admin-modal__backdrop"
             onclick="closeInventoryIssueDetailModal(@issue.Id)">
        </div>

        <div class="admin-modal__dialog issue-create-dialog">
            <div class="admin-modal__header">
                <div>
                    <p class="admin-section__eyebrow">
                        Chi tiết phiếu xuất kho
                    </p>

                    <h3>@issue.IssueCode</h3>

                    <span class="status-chip @GetStatusClass(issue.Status)">
                        @issue.Status
                    </span>
                </div>

                <button type="button"
                        class="admin-modal__close"
                        onclick="closeInventoryIssueDetailModal(@issue.Id)">
                    &times;
                </button>
            </div>

            <section class="issue-create-information">
                <div class="issue-create-form-grid">
                    <div class="admin-field">
                        <span>Kho xuất</span>
                        <strong>
                            @issue.Warehouse?.Name
                        </strong>
                    </div>

                    <div class="admin-field">
                        <span>Quầy nhận</span>
                        <strong>
                            @(issue.DestinationWarehouse?.Name
                                ?? "Chưa xác định")
                        </strong>
                    </div>

                    <div class="admin-field">
                        <span>Người nhận tại quầy</span>
                        <strong>
                            @(issue.ReceiverUser?.FullName
                                ?? "Chưa xác định")
                        </strong>
                    </div>

                    <div class="admin-field">
                        <span>Người lập phiếu</span>
                        <strong>
                            @(issue.CreatedByUser?.FullName
                                ?? "Chưa xác định")
                        </strong>
                    </div>

                    <div class="admin-field">
                        <span>Ngày lập</span>
                        <strong>
                            @issue.CreatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>

                    <div class="admin-field">
                        <span>Mã yêu cầu xuất</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(
                                issue.ReferenceCode)
                                ? "--"
                                : issue.ReferenceCode)
                        </strong>
                    </div>

                    @if (issue.Status
                        == InventoryIssue.StatusIssued)
                    {
                        <div class="admin-field">
                            <span>Người xác nhận</span>
                            <strong>
                                @(issue.ConfirmedByUser?.FullName
                                    ?? "Chưa xác định")
                            </strong>
                        </div>

                        <div class="admin-field">
                            <span>Thời gian xuất</span>
                            <strong>
                                @(issue.IssuedAt.HasValue
                                    ? issue.IssuedAt.Value
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                    : "--")
                            </strong>
                        </div>
                    }

                    <div class="admin-field issue-create-field-wide">
                        <span>Ghi chú</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(issue.Note)
                                ? "--"
                                : issue.Note)
                        </strong>
                    </div>
                </div>
            </section>

            <section class="issue-create-product-section">
                <div class="issue-create-section-title">
                    <span>✓</span>

                    <div>
                        <strong>Hàng hóa xuất kho</strong>
                        <small>
                            @totalQuantity sản phẩm ·
                            @totalValue.ToString("N0") ₫
                        </small>
                    </div>
                </div>

                <div class="table-shell">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Mã tồn</th>
                                <th>Hàng hóa</th>
                                <th>Số lượng</th>
                                <th>Trọng lượng</th>
                                <th>Giá vốn</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var detail
                                in issue.Details)
                            {
                                <tr>
                                    <td>
                                        @detail.InventoryItem?.StockCode
                                    </td>

                                    <td>
                                        <div class="data-table__stack">
                                            <strong>
                                                @detail.InventoryItem?.ProductName
                                            </strong>

                                            <span>
                                                @detail.InventoryItem?.MaterialType
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @detail.Quantity.ToString("N0")
                                    </td>

                                    <td>
                                        @detail.IssuedWeight.ToString("N2") g
                                    </td>

                                    <td>
                                        @detail.UnitCost.ToString("N0") ₫
                                    </td>

                                    <td>
                                        <strong>
                                            @detail.LineValue.ToString("N0") ₫
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="issue-create-actions">
                <button type="button"
                        class="admin-button admin-button--secondary"
                        onclick="closeInventoryIssueDetailModal(@issue.Id)">
                    Đóng
                </button>

                @if (issue.Status
                    == InventoryIssue.StatusPending)
                {
                    <form asp-action="ConfirmInventoryIssue"
                          asp-controller="Admin"
                          method="post"
                          onsubmit="return confirm('Xác nhận bàn giao hàng theo phiếu @issue.IssueCode ra quầy?');">

                        <input type="hidden"
                               name="issueId"
                               value="@issue.Id" />

                        <button type="submit"
                                class="admin-button admin-button--primary">
                            Xác nhận xuất ra quầy
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        const selectedIssueItems = new Map();

        let currentIssueSearchPage = 1;
        let currentIssueTotalPages = 1;

        function escapeIssueHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function formatIssueNumber(value) {
            return Number(value || 0)
                .toLocaleString("vi-VN");
        }

        function openInventoryIssueModal() {
            const modal =
                document.getElementById(
                    "inventoryIssueCreateModal"
                );

            if (!modal) {
                return;
            }

            modal.classList.remove("is-hidden");
            renderSelectedIssueItems();

            const warehouseId =
                document.getElementById(
                    "inventoryIssueWarehouse"
                ).value;

            if (warehouseId) {
                searchInventoryIssueItems(1);
            }
        }

        function closeInventoryIssueModal() {
            document.getElementById(
                "inventoryIssueCreateModal"
            )?.classList.add("is-hidden");
        }

        async function searchInventoryIssueItems(page) {
            const branchId =
                document.getElementById(
                    "inventoryIssueBranchId"
                ).value;

            const warehouseId =
                document.getElementById(
                    "inventoryIssueWarehouse"
                ).value;

            const keyword =
                document.getElementById(
                    "inventoryIssueKeyword"
                ).value.trim();

            const resultContainer =
                document.getElementById(
                    "inventoryIssueSearchResults"
                );

            const stateContainer =
                document.getElementById(
                    "inventoryIssueSearchState"
                );

            const pagination =
                document.getElementById(
                    "inventoryIssuePagination"
                );

            if (!branchId) {
                stateContainer.hidden = false;
                stateContainer.textContent =
                    "Vui lòng chọn chi nhánh trước khi tạo phiếu.";
                resultContainer.innerHTML = "";
                pagination.hidden = true;
                return;
            }

            if (!warehouseId) {
                stateContainer.hidden = false;
                stateContainer.textContent =
                    "Hãy chọn kho xuất hàng trước.";
                resultContainer.innerHTML = "";
                pagination.hidden = true;
                return;
            }

            stateContainer.hidden = false;
            stateContainer.textContent =
                "Đang tải danh sách hàng...";

            resultContainer.innerHTML = "";
            pagination.hidden = true;

            const query =
                new URLSearchParams({
                    branchId: branchId,
                    warehouseId: warehouseId,
                    keyword: keyword,
                    page: page.toString()
                });

            try {
                const response =
                    await fetch(
                        `@Url.Action(
                            "SearchInventoryItemsForIssue",
                            "Admin")?${query.toString()}`
                    );

                const data =
                    await response.json();

                if (!response.ok
                    || !data.success) {
                    throw new Error(
                        data.message
                        || "Không thể tải hàng tồn kho."
                    );
                }

                currentIssueSearchPage =
                    data.page;

                currentIssueTotalPages =
                    data.totalPages;

                document.getElementById(
                    "inventoryIssueSearchSummary"
                ).textContent =
                    `${formatIssueNumber(data.totalItems)} sản phẩm phù hợp`;

                if (!data.items
                    || data.items.length === 0) {
                    stateContainer.hidden = false;
                    stateContainer.textContent =
                        "Không tìm thấy sản phẩm phù hợp.";
                    return;
                }

                stateContainer.hidden = true;

                resultContainer.innerHTML =
                    data.items.map(function (item) {
                        const selected =
                            selectedIssueItems.has(
                                item.id
                            );

                        const supplier =
                            item.supplierName
                                ? `<span>NCC: ${escapeIssueHtml(
                                    item.supplierName
                                )}</span>`
                                : "";

                        const certificate =
                            item.certificateCode
                                ? `<span>Kiểm định: ${escapeIssueHtml(
                                    item.certificateCode
                                )}</span>`
                                : "";

                        return `
                            <article class="issue-search-card">
                                <div class="issue-search-card__body">
                                    <div class="issue-search-card__code">
                                        ${escapeIssueHtml(item.stockCode)}
                                    </div>

                                    <strong>
                                        ${escapeIssueHtml(item.productName)}
                                    </strong>

                                    <span>
                                        ${escapeIssueHtml(item.productLine)}
                                        ·
                                        ${escapeIssueHtml(item.materialType)}
                                    </span>

                                    ${supplier}
                                    ${certificate}

                                    <div class="issue-search-card__stock">
                                        <span>
                                            Còn
                                            <b>${formatIssueNumber(
                                                item.quantityOnHand
                                            )}</b>
                                            sản phẩm
                                        </span>

                                        <span>
                                            ${formatIssueNumber(
                                                item.weightOnHand
                                            )} g
                                        </span>
                                    </div>
                                </div>

                                <button type="button"
                                        class="issue-search-card__add"
                                        data-add-issue-item="${item.id}"
                                        ${selected ? "disabled" : ""}>
                                    ${selected ? "Đã chọn" : "+ Thêm"}
                                </button>
                            </article>
                        `;
                    }).join("");

                data.items.forEach(function (item) {
                    const button =
                        resultContainer.querySelector(
                            `[data-add-issue-item="${item.id}"]`
                        );

                    button?.addEventListener(
                        "click",
                        function () {
                            item.quantity = "1";
                            item.issuedWeight = "";
                            item.detailNote = "";

                            selectedIssueItems.set(
                                item.id,
                                item
                            );

                            renderSelectedIssueItems();

                            button.disabled = true;
                            button.textContent =
                                "Đã chọn";
                        }
                    );
                });

                pagination.hidden = false;

                document.getElementById(
                    "inventoryIssuePageInfo"
                ).textContent =
                    `Trang ${data.page}/${data.totalPages}`;

                document.getElementById(
                    "inventoryIssuePreviousPage"
                ).disabled =
                    data.page <= 1;

                document.getElementById(
                    "inventoryIssueNextPage"
                ).disabled =
                    data.page >= data.totalPages;
            }
            catch (error) {
                stateContainer.hidden = false;
                stateContainer.textContent =
                    error.message;

                resultContainer.innerHTML = "";
            }
        }

        function renderSelectedIssueItems() {
            const container =
                document.getElementById(
                    "inventoryIssueSelectedItems"
                );

            const count =
                document.getElementById(
                    "inventoryIssueSelectedCount"
                );

            count.textContent =
                selectedIssueItems.size;

            if (selectedIssueItems.size === 0) {
                container.innerHTML = `
                    <div class="issue-selected-empty">
                        <strong>Chưa chọn sản phẩm</strong>
                        <span>
                            Nhấn “Thêm” tại danh sách bên trái.
                        </span>
                    </div>
                `;

                return;
            }

            container.innerHTML =
                Array.from(
                    selectedIssueItems.values()
                ).map(function (item) {
                    const weightInput =
                        Number(item.weightOnHand) > 0
                            ? `
                                <label>
                                    <span>Trọng lượng xuất (g)</span>
                                    <input type="number"
                                           name="IssuedWeights[${item.id}]"
                                           value="${escapeIssueHtml(
                                               item.issuedWeight
                                           )}"
                                           data-selected-field="issuedWeight"
                                           data-selected-id="${item.id}"
                                           min="0.01"
                                           max="${item.weightOnHand}"
                                           step="0.01"
                                           placeholder="Nhập trọng lượng" />
                                </label>
                            `
                            : `
                                <input type="hidden"
                                       name="IssuedWeights[${item.id}]"
                                       value="0" />
                            `;

                    return `
                        <article class="issue-selected-card">
                            <input type="hidden"
                                   name="SelectedInventoryItemIds"
                                   value="${item.id}" />

                            <div class="issue-selected-card__heading">
                                <div>
                                    <span>
                                        ${escapeIssueHtml(item.stockCode)}
                                    </span>

                                    <strong>
                                        ${escapeIssueHtml(item.productName)}
                                    </strong>
                                </div>

                                <button type="button"
                                        data-remove-issue-item="${item.id}"
                                        aria-label="Bỏ sản phẩm">
                                    ×
                                </button>
                            </div>

                            <div class="issue-selected-card__available">
                                Đang tồn:
                                ${formatIssueNumber(
                                    item.quantityOnHand
                                )}
                                sản phẩm
                                ·
                                ${formatIssueNumber(
                                    item.weightOnHand
                                )} g
                            </div>

                            <div class="issue-selected-card__fields">
                                <label>
                                    <span>Số lượng xuất</span>

                                    <input type="number"
                                           name="Quantities[${item.id}]"
                                           value="${escapeIssueHtml(
                                               item.quantity
                                           )}"
                                           data-selected-field="quantity"
                                           data-selected-id="${item.id}"
                                           min="1"
                                           max="${item.quantityOnHand}"
                                           required />
                                </label>

                                ${weightInput}
                            </div>

                            <label class="issue-selected-card__note">
                                <span>Ghi chú dòng hàng</span>

                                <input type="text"
                                       name="DetailNotes[${item.id}]"
                                       value="${escapeIssueHtml(
                                           item.detailNote
                                       )}"
                                       data-selected-field="detailNote"
                                       data-selected-id="${item.id}"
                                       maxlength="500"
                                       placeholder="Không bắt buộc" />
                            </label>
                        </article>
                    `;
                }).join("");

            container.querySelectorAll(
                "[data-remove-issue-item]"
            ).forEach(function (button) {
                button.addEventListener(
                    "click",
                    function () {
                        const id =
                            Number(
                                button.dataset
                                    .removeIssueItem
                            );

                        selectedIssueItems.delete(id);
                        renderSelectedIssueItems();

                        searchInventoryIssueItems(
                            currentIssueSearchPage
                        );
                    }
                );
            });

            container.querySelectorAll(
                "[data-selected-field]"
            ).forEach(function (input) {
                input.addEventListener(
                    "input",
                    function () {
                        const id =
                            Number(
                                input.dataset.selectedId
                            );

                        const item =
                            selectedIssueItems.get(id);

                        if (!item) {
                            return;
                        }

                        item[
                            input.dataset.selectedField
                        ] = input.value;
                    }
                );
            });
        }

        document.getElementById(
            "inventoryIssueWarehouse"
        )?.addEventListener(
            "change",
            function () {
                selectedIssueItems.clear();
                renderSelectedIssueItems();
                searchInventoryIssueItems(1);
            }
        );

        document.getElementById(
            "inventoryIssueSearchButton"
        )?.addEventListener(
            "click",
            function () {
                searchInventoryIssueItems(1);
            }
        );

        document.getElementById(
            "inventoryIssueKeyword"
        )?.addEventListener(
            "keydown",
            function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchInventoryIssueItems(1);
                }
            }
        );

        document.getElementById(
            "inventoryIssuePreviousPage"
        )?.addEventListener(
            "click",
            function () {
                if (currentIssueSearchPage > 1) {
                    searchInventoryIssueItems(
                        currentIssueSearchPage - 1
                    );
                }
            }
        );

        document.getElementById(
            "inventoryIssueNextPage"
        )?.addEventListener(
            "click",
            function () {
                if (
                    currentIssueSearchPage
                    < currentIssueTotalPages
                ) {
                    searchInventoryIssueItems(
                        currentIssueSearchPage + 1
                    );
                }
            }
        );

        document.getElementById(
            "inventoryIssueCreateForm"
        )?.addEventListener(
            "submit",
            function (event) {
                if (selectedIssueItems.size === 0) {
                    event.preventDefault();

                    alert(
                        "Vui lòng chọn ít nhất một sản phẩm để xuất."
                    );

                    return;
                }

                for (
                    const item
                    of selectedIssueItems.values()
                ) {
                    const quantity =
                        Number(item.quantity);

                    const weight =
                        Number(
                            item.issuedWeight || 0
                        );

                    if (
                        quantity <= 0
                        || quantity
                            > item.quantityOnHand
                    ) {
                        event.preventDefault();

                        alert(
                            `Số lượng xuất của ${item.productName} không hợp lệ.`
                        );

                        return;
                    }

                    if (
                        item.weightOnHand > 0
                        && quantity
                            < item.quantityOnHand
                        && weight <= 0
                    ) {
                        event.preventDefault();

                        alert(
                            `Vui lòng nhập trọng lượng thực tế xuất của ${item.productName}.`
                        );

                        return;
                    }
                }
            }
        );

        document.addEventListener(
            "keydown",
            function (event) {
                if (event.key === "Escape") {
                    closeInventoryIssueModal();
                }
            }
        );
        function openInventoryIssueDetailModal(issueId) {
            document.getElementById(
                `inventoryIssueDetailModal-${issueId}`
            )?.classList.remove("is-hidden");
        }

        function closeInventoryIssueDetailModal(issueId) {
            document.getElementById(
                `inventoryIssueDetailModal-${issueId}`
            )?.classList.add("is-hidden");
        }
    </script>
}