@model GoldManagementSystem.Models.SupplierPurchaseOrder

<div class="supplier-modal" id="purchaseOrderDetailModal-@Model.Id" aria-hidden="true">
    <div class="supplier-modal__backdrop" data-close-modal></div>

    <div class="supplier-modal__dialog supplier-modal__dialog--large">
        <div class="supplier-modal__header">
            <div>
                <p class="admin-section__eyebrow">Chi tiết đơn đặt hàng NCC</p>
                <h2>@Model.OrderCode</h2>
            </div>

            <button type="button" class="supplier-modal__close" data-close-modal>×</button>
        </div>

        <div class="supplier-detail-grid">
            <div>
                <span>Nhà cung cấp</span>
                <strong>@(Model.Supplier?.Name ?? "--")</strong>
            </div>

            <div>
                <span>Chi nhánh nhận</span>
                <strong>@(Model.Branch?.BranchName ?? "--")</strong>
            </div>

            <div>
                <span>Ngày tạo</span>
                <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>

            <div>
                <span>Dự kiến giao</span>
                <strong>@(Model.ExpectedDeliveryDate.HasValue ? Model.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy") : "--")</strong>
            </div>

            <div>
                <span>Tổng tiền</span>
                <strong>@Model.TotalAmount.ToString("N0") ₫</strong>
            </div>

            <div>
                <span>Trạng thái</span>
                <strong>@Model.Status</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="supplier-detail-note">
                <span>Ghi chú đơn</span>
                <p>@Model.Note</p>
            </div>
        }

        <div class="table-shell">
            <table class="data-table supplier-table">
                <thead>
                    <tr>
                        <th>Nhóm</th>
                        <th>Danh mục</th>
                        <th>Phân loại</th>
                        <th>Sản phẩm</th>
                        <th>SL</th>
                        <th>Gram</th>
                        <th>Carat</th>
                        <th>Mã kiểm định</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td>@detail.ProductLine</td>
                            <td>@detail.Category</td>
                            <td>@detail.GoldType</td>
                            <td>
                                <div class="data-table__stack">
                                    <strong>@detail.ProductName</strong>
                                    <span>@(string.IsNullOrWhiteSpace(detail.Note) ? "--" : detail.Note)</span>
                                </div>
                            </td>
                            <td>@detail.Quantity</td>
                            <td>@detail.Weight.ToString("N2")</td>
                            <td>@(detail.DiamondCarat.HasValue ? detail.DiamondCarat.Value.ToString("N2") : "--")</td>
                            <td>@(string.IsNullOrWhiteSpace(detail.DiamondCertificate) ? "--" : detail.DiamondCertificate)</td>
                            <td>@detail.UnitCost.ToString("N0") ₫</td>
                            <td class="data-table__accent">@detail.TotalCost.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>