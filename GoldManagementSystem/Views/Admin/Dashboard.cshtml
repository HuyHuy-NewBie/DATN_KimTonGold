@using GoldManagementSystem.Models
@using System.Linq
@{
    ViewData["Title"] = "Dashboard Quản Lý";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<Order> ?? Enumerable.Empty<Order>();
    var totalRevenue = ViewBag.TotalRevenue is decimal revenue ? revenue : Convert.ToDecimal(ViewBag.TotalRevenue ?? 0m);

    (string Vi, string En, string Modifier) GetStatusMeta(string status)
    {
        return status switch
        {
            Order.StatusAwaitingDepositPayment => ("Chờ thanh toán cọc", "Awaiting deposit", "warning"),
            Order.StatusUnpaidDeposit => ("Chưa thanh toán cọc", "Deposit unpaid", "neutral"),
            Order.StatusPendingConfirmation => ("Chờ xác nhận", "Pending confirmation", "info"),
            Order.StatusConfirmed => ("Đã xác nhận", "Confirmed", "success"),
            Order.StatusCompleted => ("Hoàn thành", "Completed", "success"),
            Order.StatusCancelled => ("Đã hủy", "Cancelled", "danger"),
            Order.StatusShipping => ("Vận chuyển", "Shipping", "info"),
            Order.StatusProcessing => ("Đang xử lý", "Processing", "warning"),
            _ => (status, status, "neutral")
        };
    }
}

<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero">
        <div>
            <p class="admin-hero__eyebrow" data-i18n data-i18n-vi="Bảng điều khiển" data-i18n-en="Control center">Bảng điều khiển</p>
            <h1 data-i18n data-i18n-vi="Dashboard tổng quan" data-i18n-en="Operations dashboard">Dashboard tổng quan</h1>
            <p class="admin-hero__text" data-i18n data-i18n-vi="Theo dõi nhanh doanh thu, đơn hàng, người dùng và danh mục sản phẩm trong một màn hình gọn gàng." data-i18n-en="Track revenue, orders, users, and products from one clean admin screen.">Theo dõi nhanh doanh thu, đơn hàng, người dùng và danh mục sản phẩm trong một màn hình gọn gàng.</p>
        </div>
    </section>

    <div class="admin-panel__body">
        <section class="admin-stats-grid">
            <article class="admin-stat-card admin-stat-card--gold">
                <div class="admin-stat-card__content">
                    <p data-i18n data-i18n-vi="Tổng doanh thu" data-i18n-en="Total revenue">Tổng doanh thu</p>
                    <strong>@totalRevenue.ToString("N0") ₫</strong>
                </div>
                <span class="admin-stat-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.66 0-3 .9-3 2s1.34 2 3 2 3 .9 3 2-1.34 2-3 2m0-8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.4-2.6-1M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </span>
            </article>

            <article class="admin-stat-card admin-stat-card--blue">
                <div class="admin-stat-card__content">
                    <p data-i18n data-i18n-vi="Đơn hàng" data-i18n-en="Orders">Đơn hàng</p>
                    <strong>@ViewBag.TotalOrders</strong>
                </div>
                <span class="admin-stat-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 10.5a1 1 0 0 1-.99 1.1H4.99A1 1 0 0 1 4 19.5L5 9Z" />
                    </svg>
                </span>
            </article>

            <article class="admin-stat-card admin-stat-card--green">
                <div class="admin-stat-card__content">
                    <p data-i18n data-i18n-vi="Người dùng" data-i18n-en="Users">Người dùng</p>
                    <strong>@ViewBag.TotalUsers</strong>
                </div>
                <span class="admin-stat-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 19a4 4 0 0 0-8 0m8 0H5m11 0h3m-8-8a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 1a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5ZM4 12a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
                    </svg>
                </span>
            </article>

            <article class="admin-stat-card admin-stat-card--rose">
                <div class="admin-stat-card__content">
                    <p data-i18n data-i18n-vi="Sản phẩm" data-i18n-en="Products">Sản phẩm</p>
                    <strong>@ViewBag.TotalProducts</strong>
                </div>
                <span class="admin-stat-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 0v9m8-4.5-8 4.5-8-4.5" />
                    </svg>
                </span>
            </article>
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Hoạt động gần đây" data-i18n-en="Recent activity">Hoạt động gần đây</p>
                    <h2 data-i18n data-i18n-vi="Đơn hàng mới nhất" data-i18n-en="Latest orders">Đơn hàng mới nhất</h2>
                </div>
                <a href="/Admin/OrderManagement" class="admin-link" data-i18n data-i18n-vi="Xem tất cả" data-i18n-en="View all">Xem tất cả</a>
            </div>

            @if (recentOrders.Any())
            {
                <div class="table-shell">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n data-i18n-vi="Mã đơn" data-i18n-en="Order no.">Mã đơn</th>
                                <th data-i18n data-i18n-vi="Khách hàng" data-i18n-en="Customer">Khách hàng</th>
                                <th data-i18n data-i18n-vi="Ngày tạo" data-i18n-en="Created">Ngày tạo</th>
                                <th data-i18n data-i18n-vi="Tổng tiền" data-i18n-en="Total">Tổng tiền</th>
                                <th data-i18n data-i18n-vi="Trạng thái" data-i18n-en="Status">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                var status = GetStatusMeta(order.Status);
                                <tr>
                                    <td class="data-table__strong">#@order.OrderNumber</td>
                                    <td>
                                        @if (order.User != null)
                                        {
                                            @order.User.FullName
                                        }
                                        else
                                        {
                                            <span data-i18n data-i18n-vi="Khách vãng lai" data-i18n-en="Guest">Khách vãng lai</span>
                                        }
                                    </td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td class="data-table__accent">@order.TotalAmount.ToString("N0") ₫</td>
                                    <td>
                                        <span class="status-chip status-chip--@status.Modifier"
                                              data-i18n
                                              data-i18n-vi="@status.Vi"
                                              data-i18n-en="@status.En">
                                            @status.Vi
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-card">
                    <h3 data-i18n data-i18n-vi="Chưa có đơn hàng gần đây" data-i18n-en="No recent orders yet">Chưa có đơn hàng gần đây</h3>
                    <p data-i18n data-i18n-vi="Dữ liệu sẽ xuất hiện tại đây khi hệ thống ghi nhận thêm giao dịch." data-i18n-en="Data will appear here once the system records new transactions.">Dữ liệu sẽ xuất hiện tại đây khi hệ thống ghi nhận thêm giao dịch.</p>
                </div>
            }
        </section>

        @inject GoldManagementSystem.Data.ApplicationDbContext DbContext
        @using Microsoft.EntityFrameworkCore
        @{
            var activeBranches = await DbContext.Branches
                .Where(b => b.IsActive)
                .OrderBy(b => b.BranchName)
                .ToListAsync();
        }

        <section class="admin-section" style="margin-top: 2rem; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 2rem;">
            <div class="admin-section__header">
                <div>
                    <p class="admin-section__eyebrow" data-i18n data-i18n-vi="Trí tuệ nhân tạo" data-i18n-en="Artificial intelligence">Trí tuệ nhân tạo</p>
                    <h2 data-i18n data-i18n-vi="Cấu hình Trợ lý Chat AI KIMTON" data-i18n-en="Configure KIMTON Chat AI Assistant">Cấu hình Trợ lý Chat AI KIMTON</h2>
                    <p style="font-size: 0.88rem; color: #666; margin-top: 0.25rem;" data-i18n data-i18n-vi="Lựa chọn chi nhánh để xuất System Prompt chuẩn hóa cho ChatGPT / Gemini." data-i18n-en="Select a branch to export the standardized System Prompt for ChatGPT / Gemini.">Lựa chọn chi nhánh để xuất System Prompt chuẩn hóa cho ChatGPT / Gemini.</p>
                </div>
            </div>

            <div style="background: #fff; border: 1px solid rgba(0,0,0,0.06); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div class="admin-field" style="max-width: 320px; display: flex; flex-direction: column; gap: 0.5rem;">
                    <span style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; color: #555;" data-i18n data-i18n-vi="Chọn chi nhánh" data-i18n-en="Select branch">Chọn chi nhánh</span>
                    <select id="adminPromptBranchSelect" class="admin-select" style="padding: 0.6rem; border-radius: 8px; border: 1px solid #ccc; width: 100%;">
                        @foreach (var b in activeBranches)
                        {
                            <option value="@b.Id" 
                                    data-name="@b.BranchName" 
                                    data-phone="@b.PhoneNumber" 
                                    data-address="@b.Address">
                                @b.BranchName
                            </option>
                        }
                    </select>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <span style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; color: #555;" data-i18n data-i18n-vi="Nội dung System Prompt" data-i18n-en="System Prompt content">Nội dung System Prompt</span>
                    <textarea id="adminPromptTextarea" readonly rows="12" style="font-family: 'Courier New', Courier, monospace; font-size: 0.82rem; padding: 1rem; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); background: #f9f9f9; resize: vertical; line-height: 1.5; color: #333; width: 100%;"></textarea>
                </div>

                <div style="display: flex; gap: 1rem;">
                    <button type="button" id="adminCopyPromptBtn" class="admin-button admin-button--primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; cursor: pointer;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span data-i18n data-i18n-vi="Sao chép Prompt" data-i18n-en="Copy Prompt">Sao chép Prompt</span>
                    </button>
                    <span id="adminCopyStatus" style="font-size: 0.85rem; color: #2ec4b6; font-weight: 600; display: none; align-self: center;" data-i18n data-i18n-vi="Đã sao chép vào bộ nhớ tạm!" data-i18n-en="Copied to clipboard!">Đã sao chép vào bộ nhớ tạm!</span>
                </div>
            </div>
        </section>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const select = document.getElementById("adminPromptBranchSelect");
                const textarea = document.getElementById("adminPromptTextarea");
                const copyBtn = document.getElementById("adminCopyPromptBtn");
                const status = document.getElementById("adminCopyStatus");

                const goldPrices = {
                    gold24k: { buy: 7450000, sell: 7600000 },
                    gold18k: { buy: 5350000, sell: 5550000 },
                    gold14k: { buy: 4100000, sell: 4300000 }
                };

                function updatePrompt() {
                    if (!select || !textarea) return;
                    const option = select.options[select.selectedIndex];
                    if (!option) return;

                    const name = option.getAttribute("data-name");
                    const phone = option.getAttribute("data-phone") || "0961137407";
                    const address = option.getAttribute("data-address") || "Chưa cập nhật địa chỉ";
                    const openHours = "08:00 - 21:30 hàng ngày";

                    const pricesText = `
  + Vàng SJC / 24K (9999): Mua vào ` + goldPrices.gold24k.buy.toLocaleString('vi-VN') + ` đ/chỉ - Bán ra ` + goldPrices.gold24k.sell.toLocaleString('vi-VN') + ` đ/chỉ
  + Vàng Tây 18K: Mua vào ` + goldPrices.gold18k.buy.toLocaleString('vi-VN') + ` đ/chỉ - Bán ra ` + goldPrices.gold18k.sell.toLocaleString('vi-VN') + ` đ/chỉ
  + Vàng Tây 14K: Mua vào ` + goldPrices.gold14k.buy.toLocaleString('vi-VN') + ` đ/chỉ - Bán ra ` + goldPrices.gold14k.sell.toLocaleString('vi-VN') + ` đ/chỉ`;

                    const promptText = `Bạn là Trợ Lý KIMTON — chuyên viên tư vấn cao cấp của tiệm vàng ` + name + `.

## THÔNG TIN CỬA HÀNG (luôn dùng chính xác dữ liệu dưới đây, không tự bịa)
- Tên: ` + name + `
- Hotline/Zalo: ` + phone + `
- Giờ mở cửa: ` + openHours + `
- Địa chỉ: ` + address + `
- Bảng giá vàng hôm nay: ` + pricesText + `
- Giá công chế tác: Dao động từ 300.000 đ đến 1.500.000 đ tùy thuộc vào độ tinh xảo và khối lượng của từng sản phẩm.
- Chính sách thu đổi: Mua lại 75% giá trị hóa đơn, đổi mẫu mới thu hồi 80%
- Chính sách đặt thiết kế riêng: Nhận đặt chế tác theo yêu cầu cá nhân (3D Render miễn phí). Thời gian chế tác hoàn thiện từ 7-10 ngày làm việc sau khi chốt thiết kế.
- Danh mục sản phẩm: Nhẫn cưới, Nhẫn cầu hôn, Nhẫn nam/nữ thời trang, Bông tai/Hoa tai, Dây chuyền, Lắc tay/Vòng tay, Mặt dây chuyền các loại chất liệu Vàng 24K, Vàng 18K, Vàng 14K.

## NGUYÊN TẮC TRẢ LỜI

1. TRẢ LỜI THẲNG, KHÔNG NÉ TRÁNH
Nếu câu hỏi có thể trả lời bằng dữ liệu ở trên, luôn trả lời trực tiếp và cụ thể (số liệu, chính sách...). Tuyệt đối không đẩy khách qua hotline nếu thông tin đã có sẵn.
Chỉ đẩy qua hotline/Zalo khi: hỏi giá công cho mẫu thiết kế riêng chưa có sẵn, hỏi vấn đề cần thẩm định trực tiếp (kiểm định vàng, khiếu nại, đơn hàng giá trị lớn), hoặc câu hỏi ngoài phạm vi dữ liệu bạn có.

2. LUÔN DẪN DẮT SANG BƯỚC TIẾP THEO
Sau khi trả lời, luôn kết bằng một câu hỏi mở hoặc gợi ý hành động cụ thể để giữ mạch tư vấn, phù hợp với câu hỏi vừa trả lời. Không trả lời cụt rồi dừng.

3. PHÂN LOẠI Ý ĐỊNH KHÁCH HÀNG
- Hỏi tham khảo chung (giá vàng, thông tin cơ bản): trả lời gọn, nhẹ nhàng, không dồn ép mua.
- Hỏi cụ thể (mẫu, size, ngân sách, số lượng): đây là tín hiệu mua thật — tư vấn sâu hơn, gợi ý sản phẩm phù hợp, hỏi thêm nhu cầu.
- Khiếu nại/phàn nàn: xin lỗi ngắn gọn, chuyển ngay qua hotline, không tự phán xét hay hứa hẹn thay cửa hàng.
- Đơn hàng giá trị lớn (vàng miếng đầu tư, bộ trang sức cưới...): tư vấn sơ bộ rồi chủ động đề nghị kết nối nhân viên thật để đảm bảo độ chính xác và tin cậy.

4. GIỌNG VĂN
Xưng "em", gọi khách "anh/chị". Lịch sự, ấm áp, chuyên nghiệp như nhân viên tư vấn giỏi tại cửa hàng — không máy móc, không lặp lại nguyên văn một mẫu câu cho mọi tình huống.

5. KHÔNG TỰ BỊA THÔNG TIN
KHÔNG tự đưa ra số liệu, chính sách, hay cam kết nào không có trong dữ liệu cửa hàng cung cấp. Nếu không chắc, nói rõ sẽ cần xác nhận qua hotline.

6. KẾT THÚC BẰNG HÀNH ĐỘNG RÕ RÀNG
Ưu tiên chốt câu trả lời bằng lời mời cụ thể: để lại số điện thoại, ghé cửa hàng, hoặc câu hỏi giúp xác định nhu cầu tiếp theo — thay vì câu chung chung "vui lòng liên hệ".`;

                    textarea.value = promptText;
                }

                if (select) {
                    select.addEventListener("change", updatePrompt);
                    updatePrompt();
                }

                if (copyBtn && textarea) {
                    copyBtn.addEventListener("click", function () {
                        navigator.clipboard.writeText(textarea.value).then(function () {
                            status.style.display = "inline";
                            setTimeout(function () {
                                status.style.display = "none";
                            }, 2500);
                        }).catch(function (err) {
                            alert("Không thể sao chép! Vui lòng chọn và sao chép thủ công.");
                        });
                    });
                }
            });
        </script>
    </div>
</div>

