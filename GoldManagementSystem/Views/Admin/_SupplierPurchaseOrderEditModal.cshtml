@model GoldManagementSystem.Models.SupplierPurchaseOrder
@using GoldManagementSystem.Models
@using System.Globalization

<div class="supplier-modal purchase-order-scope"
     id="purchaseOrderEditModal-@Model.Id"
     aria-hidden="true">
    <div class="supplier-modal__backdrop" data-close-modal></div>

    <div class="supplier-modal__dialog supplier-modal__dialog--large">
        <div class="supplier-modal__header">
            <div>
                <p class="admin-section__eyebrow">Sửa đơn đặt hàng NCC</p>
                <h2>@Model.OrderCode</h2>
            </div>

            <button type="button" class="supplier-modal__close" data-close-modal>×</button>
        </div>

        <form asp-action="UpdateSupplierPurchaseOrder"
              asp-controller="Admin"
              method="post"
              class="supplier-purchase-form js-purchase-edit-form"
              onsubmit="return confirm('Bạn có chắc muốn lưu thay đổi đơn đặt hàng này không?');">

            <input type="hidden" name="PurchaseOrderId" value="@Model.Id" />

            <div class="supplier-order-grid">
                <label class="admin-field">
                    <span>Nhà cung cấp *</span>
                    <select name="SupplierId" class="admin-select" required>
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @foreach (var supplier in ViewBag.ActiveSuppliersForEdit as List<Supplier> ?? new List<Supplier>())
                        {
                            if (supplier.Id == Model.SupplierId)
                            {
                                <option value="@supplier.Id" selected>@supplier.Name</option>
                            }
                            else
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Chi nhánh nhận hàng *</span>
                    <select name="BranchId" class="admin-select" required>
                        <option value="">-- Chọn chi nhánh nhận hàng --</option>
                        @foreach (var branch in ViewBag.ActiveBranchesForEdit as List<Branch> ?? new List<Branch>())
                        {
                            if (branch.Id == Model.BranchId)
                            {
                                <option value="@branch.Id" selected>@branch.BranchName</option>
                            }
                            else
                            {
                                <option value="@branch.Id">@branch.BranchName</option>
                            }
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Ngày dự hàng đến *</span>
                    <input type="date"
                           name="ExpectedDeliveryDate"
                           required
                           value="@(Model.ExpectedDeliveryDate.HasValue ? Model.ExpectedDeliveryDate.Value.ToString("yyyy-MM-dd") : "")" />
                </label>

                <label class="admin-field">
                    <span>Ghi chú đơn đặt hàng</span>
                    <textarea name="PurchaseOrderNote" rows="2" maxlength="1000">@Model.Note</textarea>
                </label>
            </div>

            <div class="purchase-order-line-toolbar">
                <div>                  
                    <h3>Danh sách dòng hàng</h3>
                </div>

                <button type="button" class="admin-button admin-button--secondary js-add-edit-purchase-line">
                    + Thêm dòng hàng
                </button>
            </div>

            <div class="purchase-order-lines js-edit-purchase-lines">
                @{
                    var details = Model.Details?.ToList() ?? new List<SupplierPurchaseOrderDetail>();
                    if (!details.Any())
                    {
                        details.Add(new SupplierPurchaseOrderDetail
                        {
                            ProductLine = "Vàng",
                            Quantity = 1,
                            Weight = 0,
                            UnitCost = 0
                        });
                    }
                }

                @for (var i = 0; i < details.Count; i++)
                {
                    var detail = details[i];

                    <article class="purchase-order-line">
                        <div class="purchase-order-line__header">
                            <strong>Dòng hàng <span class="js-line-number">@(i + 1)</span></strong>

                            <button type="button"
                                    class="admin-button admin-button--danger js-remove-purchase-line">
                                Xóa dòng
                            </button>
                        </div>

                        <div class="purchase-order-line__grid">
                            <label class="admin-field">
                                <span>Nhóm hàng *</span>
                                <select name="ProductLines" class="admin-select js-purchase-product-line" required data-current-value="@detail.ProductLine">
                                    <option value="">-- Chọn nhóm hàng --</option>
                                    <option value="Vàng">Vàng</option>
                                    <option value="Bạc">Bạc</option>
                                    <option value="Kim cương">Kim cương</option>
                                    <option value="Đá quý">Đá quý</option>
                                    <option value="Phụ kiện / hộp đựng">Phụ kiện / hộp đựng</option>
                                </select>
                            </label>

                            <label class="admin-field">
                                <span>Danh mục hàng *</span>
                                <select name="Categories" class="admin-select js-purchase-category" required data-current-value="@detail.Category">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                            </label>

                            <label class="admin-field">
                                <span class="js-type-label">Chất liệu / phân loại *</span>
                                <select name="GoldTypes" class="admin-select js-purchase-type" required data-current-value="@detail.GoldType">
                                    <option value="">-- Chọn phân loại --</option>
                                </select>
                            </label>

                            <label class="admin-field purchase-field--span-2">
                                <span>Tên sản phẩm dự kiến nhập *</span>

                                <input type="text"
                                    name="ProductNames"
                                    required
                                    maxlength="220"
                                    value="@detail.ProductName" />
                            </label>

                            <label class="admin-field">
                                <span>Số lượng *</span>
                                <input type="number" name="Quantities" required min="1" step="1" value="@detail.Quantity" />
                            </label>

                            <label class="admin-field">
                                <span>Đơn giá/chiếc (VNĐ) *</span>

                                <input type="text"
                                    class="js-unit-cost-display"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    maxlength="19"
                                    value="@detail.UnitCost.ToString("0", CultureInfo.InvariantCulture)"
                                    required />

                                <input type="hidden"
                                    name="UnitCosts"
                                    class="js-unit-cost-value"
                                    value="@detail.UnitCost.ToString("0", CultureInfo.InvariantCulture)" />
                            </label>

                            <label class="admin-field js-weight-field" hidden>
                                <span class="js-weight-label">Trọng lượng 1 sản phẩm (g) *</span>

                                <input type="number"
                                    name="Weights"
                                    min="0"
                                    step="0.01"
                                    value="@detail.Weight.ToString("0.##", CultureInfo.InvariantCulture)" />
                            </label>

                            <label class="admin-field js-carat-field" hidden>
                                <span class="js-carat-label">Carat 1 sản phẩm (ct) *</span>

                                <input type="number"
                                    name="DiamondCarats"
                                    min="0.01"
                                    step="0.01"
                                    value="@(detail.DiamondCarat.HasValue
                                        ? detail.DiamondCarat.Value.ToString("0.##", CultureInfo.InvariantCulture)
                                        : "")" />
                            </label>

                            <label class="admin-field js-certificate-field" hidden>
                                <span>Số chứng thư kiểm định</span>

                                <input type="text"
                                    name="DiamondCertificates"
                                    maxlength="50"
                                    pattern="[A-Za-z0-9][A-Za-z0-9./-]{5,49}"
                                    placeholder="Ví dụ: GIA-1234567890"
                                    value="@detail.DiamondCertificate" />
                            </label>

                            <div class="purchase-line-summary">
                                <span>
                                    Thành tiền dự kiến:
                                    <strong class="js-line-total-cost">0 ₫</strong>
                                </span>

                                <span class="js-total-weight-row" hidden>
                                    Tổng trọng lượng dự kiến:
                                    <strong class="js-line-total-weight">0 g</strong>
                                </span>

                                <span class="js-total-carat-row" hidden>
                                    Tổng Carat dự kiến:
                                    <strong class="js-line-total-carat">0 ct</strong>
                                </span>
                            </div>

                            <label class="admin-field purchase-field--full">
                                <span>Ghi chú dòng hàng</span>

                                <textarea name="DetailNotes"
                                        rows="1"
                                        maxlength="500"
                                        placeholder="Ghi chú riêng cho dòng hàng này...">@detail.Note</textarea>
                            </label>
                        </div>
                    </article>
                }
            </div>

            <div class="admin-form-actions">
                <button type="button"
                        class="admin-button admin-button--ghost"
                        data-close-modal>
                    Hủy
                </button>

                <button type="submit"
                        class="admin-button admin-button--primary">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>