@model GoldManagementSystem.Models.ChatSettings
@{
    ViewData["Title"] = "Cài đặt AI Chatbot";
}   
//2//
 
<div class="dashboard-card dashboard-card--flush admin-panel">
    <section class="admin-hero admin-hero--split">
        <div>
            <p class="admin-hero__eyebrow">Trợ lý ảo</p>
            <h1>Cài đặt AI Chatbot</h1>
            <p class="admin-hero__text">
                Nhập nội dung cho từng mục bên dưới. AI sẽ tự động trả lời khách hàng dựa trên dữ liệu bạn nhập vào đây.
                Để trống ô nào thì AI sẽ hướng khách gọi Hotline thay vì trả lời sai.
            </p>
        </div>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="ChatSettings" method="post">
            @Html.AntiForgeryToken()

            @* ── Thông tin cửa hàng ─────────────────────────────────────── *@
            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Thông tin chung</p>
                        <h2>Thông tin cửa hàng</h2>
                    </div>
                </div>
                <div class="admin-form-grid">
                    <label class="admin-field">
                        <span>Tên cửa hàng</span>
                        <input asp-for="ShopName" placeholder="KimTon Gold" />
                    </label>
                    <label class="admin-field">
                        <span>Hotline</span>
                        <input asp-for="Hotline" placeholder="1800 9999" />
                    </label>
                    <label class="admin-field admin-field--wide">
                        <span>Địa chỉ</span>
                        <input asp-for="ShopAddress" placeholder="123 Đường Vàng Kim, Quận 1, TP.HCM" />
                    </label>
                </div>
            </section>

            @* ── 5 mục gợi ý nhanh ─────────────────────────────────────── *@

            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Nút gợi ý nhanh 1</p>
                        <h2>💰 Giá sản phẩm</h2>
                    </div>
                    <span class="chat-settings__badge">Nút "Giá sản phẩm"</span>
                </div>
                <p class="chat-settings__hint">
                    Ví dụ: Giá = giá vàng hôm nay × trọng lượng + tiền công (200k–2tr tùy mẫu). Nhẫn vàng 18K: công từ 300k–800k. Dây chuyền: 400k–1.5tr.
                </p>
                <label class="admin-field admin-field--wide">
                    <span>Nội dung giá sản phẩm (để trống → AI hướng khách gọi Hotline)</span>
                    <textarea asp-for="ProductPriceInfo" rows="6"
                              placeholder="Nhập thông tin giá sản phẩm, công thức tính, bảng giá công theo loại trang sức..."></textarea>
                </label>
            </section>

            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Nút gợi ý nhanh 2</p>
                        <h2>📏 Chọn size</h2>
                    </div>
                    <span class="chat-settings__badge">Nút "Chọn size"</span>
                </div>
                <p class="chat-settings__hint">
                    Gợi ý: Đo chu vi ngón tay bằng chỉ/giấy → quy đổi size VN (size 5=49mm, size 6=51.5mm, size 7=54mm, size 8=57mm, size 9=59mm, size 10=62mm).
                </p>
                <label class="admin-field admin-field--wide">
                    <span>Hướng dẫn chọn size (để trống → AI hướng khách gọi Hotline)</span>
                    <textarea asp-for="SizeGuideInfo" rows="8"
                              placeholder="Nhập hướng dẫn cách đo size ngón tay, cổ tay và bảng quy đổi size..."></textarea>
                </label>
            </section>

            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Nút gợi ý nhanh 3</p>
                        <h2>🛡️ Bảo hành</h2>
                    </div>
                    <span class="chat-settings__badge">Nút "Bảo hành"</span>
                </div>
                <p class="chat-settings__hint">
                    Gợi ý: Bảo hành 12 tháng, đánh bóng miễn phí 1 lần/năm, thay móc/chốt miễn phí 6 tháng đầu. Điều kiện: còn hóa đơn, không hư do tác động ngoại lực.
                </p>
                <label class="admin-field admin-field--wide">
                    <span>Chính sách bảo hành (để trống → AI hướng khách gọi Hotline)</span>
                    <textarea asp-for="WarrantyInfo" rows="6"
                              placeholder="Nhập thời gian bảo hành, quyền lợi bảo hành, điều kiện áp dụng..."></textarea>
                </label>
            </section>

            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Nút gợi ý nhanh 4</p>
                        <h2>🔄 Chính sách thu đổi</h2>
                    </div>
                    <span class="chat-settings__badge">Nút "Chính sách"</span>
                </div>
                <p class="chat-settings__hint">
                    Gợi ý: Thu đổi vàng cũ lấy vàng mới, hao hụt 2–5% tùy loại. Cần mang theo hóa đơn mua hàng. Vàng khác loại được thu đổi nhưng tính phí chênh lệch.
                </p>
                <label class="admin-field admin-field--wide">
                    <span>Chính sách thu đổi (để trống → AI hướng khách gọi Hotline)</span>
                    <textarea asp-for="ExchangePolicy" rows="6"
                              placeholder="Nhập tỷ lệ hao hụt, điều kiện thu đổi, giấy tờ cần thiết..."></textarea>
                </label>
            </section>

            <section class="admin-section">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">Nút gợi ý nhanh 5</p>
                        <h2>📦 Đặt hàng</h2>
                    </div>
                    <span class="chat-settings__badge">Nút "Đặt hàng"</span>
                </div>
                <p class="chat-settings__hint">
                    Gợi ý: Đặt qua website/chat → đặt cọc 30% → hoàn thành 7–14 ngày → thanh toán còn lại khi nhận. Giao hàng toàn quốc, phí ship từ 30.000đ.
                </p>
                <label class="admin-field admin-field--wide">
                    <span>Quy trình đặt hàng (để trống → AI hướng khách gọi Hotline)</span>
                    <textarea asp-for="OrderProcess" rows="6"
                              placeholder="Nhập quy trình đặt hàng, chính sách đặt cọc, phương thức thanh toán, phí ship..."></textarea>
                </label>
            </section>

            @* Lưu ──────────────────────────────────────────────────────── *@
            <div class="admin-section" style="border-top: 1px solid rgba(0,0,0,0.07); padding-top: 1.5rem;">
                @if (Model.UpdatedAt > new DateTime(2025, 1, 1, 0, 0, 1, DateTimeKind.Utc))
                {
                    <p style="font-size:0.8rem; color:#999; margin-bottom:0.75rem;">
                        Cập nhật lần cuối: @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") bởi @Model.UpdatedBy
                    </p>
                }
                <div class="admin-form-actions">
                    <button type="submit" class="admin-button admin-button--primary">
                        💾 Lưu cài đặt chatbot
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<style>
    .chat-settings__badge {
        display: inline-block;
        background: linear-gradient(135deg, #b42363, #d4507a);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.28rem 0.8rem;
        border-radius: 99px;
        align-self: center;
        white-space: nowrap;
    }
    .chat-settings__hint {
        font-size: 0.82rem;
        color: #888;
        line-height: 1.5;
        margin-bottom: 0.85rem;
        padding: 0.65rem 0.9rem;
        background: #fef9f2;
        border-left: 3px solid #e8b96e;
        border-radius: 0 6px 6px 0;
    }
    .admin-field textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 10px;
        font-size: 0.88rem;
        line-height: 1.6;
        font-family: inherit;
        resize: vertical;
        background: #fff;
        color: #111;
        transition: border-color 0.2s;
    }
    .admin-field textarea:focus {
        outline: none;
        border-color: #b42363;
        box-shadow: 0 0 0 3px rgba(180, 35, 99, 0.08);
    }
</style>
}
