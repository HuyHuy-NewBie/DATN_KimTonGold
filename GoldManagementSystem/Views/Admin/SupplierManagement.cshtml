</div>
@section Scripts {
    <script>
        document.querySelectorAll("[data-digits-only]").forEach(function (input) {
            input.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, "");
            });
        });
        const supplierCreateForm =
            document.getElementById("supplierCreateForm");

        const supplierCreateError =
            document.getElementById("supplierCreateError");

        const supplierCreateSubmitButton =
            document.getElementById("supplierCreateSubmitButton");

        function showSupplierCreateError(message) {
            if (!supplierCreateError) {
                alert(message);
                return;
            }

            supplierCreateError.textContent = message;
            supplierCreateError.hidden = false;

            // Cuộn tới vị trí thông báo lỗi trong popup
            supplierCreateError.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

        if (supplierCreateForm) {
            supplierCreateForm.addEventListener("submit", async function (event) {
                // Không cho form tải lại trang theo cách mặc định
                event.preventDefault();

                // Kiểm tra required, pattern, minlength...
                if (!supplierCreateForm.checkValidity()) {
                    supplierCreateForm.reportValidity();
                    return;
                }

                // Ẩn thông báo lỗi cũ
                if (supplierCreateError) {
                    supplierCreateError.textContent = "";
                    supplierCreateError.hidden = true;
                }

                const originalButtonText = supplierCreateSubmitButton
                    ? supplierCreateSubmitButton.textContent
                    : "Thêm nhà cung cấp";

                // Khóa nút để tránh nhấn nhiều lần
                if (supplierCreateSubmitButton) {
                    supplierCreateSubmitButton.disabled = true;
                    supplierCreateSubmitButton.textContent = "Đang lưu...";
                }

                try {
                    const response = await fetch(supplierCreateForm.action, {
                        method: "POST",

                        // Backend dùng header này để biết đây là AJAX
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },

                        // FormData chứa toàn bộ input và AntiForgeryToken
                        body: new FormData(supplierCreateForm)
                    });

                    const contentType =
                        response.headers.get("content-type") || "";

                    const result = contentType.includes("application/json")
                        ? await response.json()
                        : null;

                    // Backend báo lỗi hoặc không trả về JSON đúng
                    if (!response.ok || !result || !result.success) {
                        showSupplierCreateError(
                            result && result.message
                                ? result.message
                                : "Không thể thêm nhà cung cấp. Vui lòng kiểm tra lại dữ liệu."
                        );

                        return;
                    }

                    // Chỉ tải lại trang sau khi SaveChangesAsync thành công
                    window.location.reload();
                }
                catch (error) {
                    console.error(error);

                    showSupplierCreateError(
                        "Không thể kết nối đến máy chủ. Vui lòng thử lại."
                    );
                }
                finally {
                    if (supplierCreateSubmitButton) {
                        supplierCreateSubmitButton.disabled = false;
                        supplierCreateSubmitButton.textContent = originalButtonText;
                    }
                }
            });
        }
        const supplierSearchInput = document.getElementById("supplierSearchInput");
        const supplierStatusFilter = document.getElementById("supplierStatusFilter");
        const supplierFilterButton = document.getElementById("supplierFilterButton");
        const supplierClearFilterButton = document.getElementById("supplierClearFilterButton");
        const supplierNoResultRow = document.getElementById("supplierNoResultRow");

        function normalizeText(value) {
            return (value || "")
                .toString()
                .trim()
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function filterSuppliers() {
            const keyword = normalizeText(supplierSearchInput.value);
            const selectedStatus = supplierStatusFilter.value;

            const supplierRows = document.querySelectorAll(".supplier-data-row");
            let visibleCount = 0;

            supplierRows.forEach(function (row) {
                const searchText = normalizeText(row.dataset.supplierSearch);
                const status = row.dataset.supplierStatus;
                const supplierId = row.dataset.supplierId;
                const editRow = document.querySelector('.supplier-edit-row[data-edit-for="' + supplierId + '"]');

                const matchKeyword = keyword === "" || searchText.includes(keyword);
                const matchStatus = selectedStatus === "" || status === selectedStatus;
                const shouldShow = matchKeyword && matchStatus;

                row.style.display = shouldShow ? "" : "none";

                if (editRow) {
                    editRow.style.display = shouldShow ? "" : "none";
                }

                if (shouldShow) {
                    visibleCount++;
                }
            });

            if (supplierNoResultRow) {
                supplierNoResultRow.style.display = visibleCount === 0 ? "" : "none";
            }
        }

        if (supplierSearchInput) {
            supplierSearchInput.addEventListener("input", filterSuppliers);
        }

        if (supplierStatusFilter) {
            supplierStatusFilter.addEventListener("change", filterSuppliers);
        }

        if (supplierFilterButton) {
            supplierFilterButton.addEventListener("click", filterSuppliers);
        }

        if (supplierClearFilterButton) {
            supplierClearFilterButton.addEventListener("click", function () {
                supplierSearchInput.value = "";
                supplierStatusFilter.value = "";
                filterSuppliers();
            });
        }

        document.querySelectorAll(".js-toggle-supplier-status-form").forEach(function (form) {
            form.addEventListener("submit", async function (event) {
                event.preventDefault();

                const supplierIdInput = form.querySelector('input[name="supplierId"]');
                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                const button = form.querySelector(".js-toggle-supplier-status-button");

                if (!supplierIdInput || !tokenInput) {
                    return;
                }

                const body = new URLSearchParams();
                body.append("supplierId", supplierIdInput.value);
                body.append("__RequestVerificationToken", tokenInput.value);

                if (button) {
                    button.disabled = true;
                }

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: body.toString()
                    });

                    const result = await response.json();

                    if (!result.success) {
                        alert(result.message);
                        return;
                    }

                    const supplierId = result.supplierId || supplierIdInput.value;
                    const row = document.querySelector('.supplier-data-row[data-supplier-id="' + supplierId + '"]');
                    const statusChip = document.querySelector('.js-supplier-status-chip[data-supplier-id="' + supplierId + '"]');

                    if (button) {
                        button.textContent = result.buttonText;
                        button.className = result.buttonClass + " js-toggle-supplier-status-button";
                    }

                    if (statusChip) {
                        statusChip.textContent = result.statusText;
                        statusChip.className = result.statusChipClass + " js-supplier-status-chip";
                    }

                    if (row) {
                        row.dataset.supplierStatus = result.status;
                    }

                    if (typeof filterSuppliers === "function") {
                        filterSuppliers();
