@model GoldManagementSystem.Models.ViewModels.SupplierManagementViewModel
@using GoldManagementSystem.Models
@using System.Linq
@{
    ViewData["Title"] = "Quản lý nhà cung cấp";

    decimal DebtValue(SupplierPurchaseOrder order)
    {
        var accepted = order?.Receipts?.Sum(receipt => receipt.TotalAcceptedValue) ?? 0m;
        var paid = order?.Payments?.Sum(payment => payment.Amount) ?? 0m;
        var debt = accepted - paid;
        return debt > 0 ? debt : 0m;
    }

    var isAllStatusSelected = string.IsNullOrWhiteSpace(Model.StatusFilter);
    var isActiveStatusSelected = string.Equals(Model.StatusFilter, "active", StringComparison.OrdinalIgnoreCase);
    var isInactiveStatusSelected = string.Equals(Model.StatusFilter, "inactive", StringComparison.OrdinalIgnoreCase);
}

<div class="dashboard-card dashboard-card--flush admin-panel supplier-management-page">
    <section class="admin-hero admin-hero--split supplier-hero">
        <div>
            <p class="admin-hero__eyebrow">Nghiệp vụ mua hàng</p>
            <h1>Quản lý nhà cung cấp</h1>
            <p class="admin-hero__text">
                Quản lý hồ sơ nhà cung cấp, đặt hàng nhập, kiểm hàng, nhập kho và thanh toán công nợ
                theo nghiệp vụ cửa hàng vàng bạc đá quý.
            </p>
        </div>

        <div class="admin-hero__actions">
            <button type="button"
                    class="admin-button admin-button--secondary"
                    data-open-modal="supplierCreateModal">
                Thêm NCC
            </button>

            <button type="button"
                    class="admin-button admin-button--secondary"
                    data-open-modal="purchaseOrderCreateModal">
                Tạo đơn đặt hàng NCC
            </button>

            <a href="#purchase-order-list" class="admin-button admin-button--secondary">
                Đơn đặt hàng
            </a>

            <a href="#goods-receipt-list"
            class="admin-button admin-button--secondary">
                Phiếu nhận hàng
            </a>

            <a href="#supplier-list" class="admin-button admin-button--primary">
                Danh sách NCC
            </a>
        </div>
    </section>

    <div class="admin-panel__body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-alert admin-alert--danger">@TempData["ErrorMessage"]</div>
        }

        <section class="admin-stats-grid supplier-overview-grid">
            <article class="admin-stat-card admin-stat-card--gold">
                <div class="admin-stat-card__content">
                    <p>Nhà cung cấp</p>
                    <strong>@Model.TotalSuppliers</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--blue">
                <div class="admin-stat-card__content">
                    <p>Đơn đang xử lý</p>
                    <strong>@Model.ActivePurchaseOrders</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--green">
                <div class="admin-stat-card__content">
                    <p>Cần kiểm hàng</p>
                    <strong>@Model.PendingReceiptCount</strong>
                </div>
            </article>

            <article class="admin-stat-card admin-stat-card--rose">
                <div class="admin-stat-card__content">
                    <p>Công nợ NCC</p>
                    <strong>@Model.TotalSupplierDebt.ToString("N0") ₫</strong>
                </div>
            </article>
        </section>

        <div class="supplier-modal" id="supplierCreateModal" aria-hidden="true">
    <div class="supplier-modal__backdrop" data-close-modal></div>

    <div class="supplier-modal__dialog">
        <div class="supplier-modal__header">
            <div>
                <p class="admin-section__eyebrow">Hồ sơ nhà cung cấp</p>
                <h2>Thêm nhà cung cấp</h2>
            </div>

            <button type="button" class="supplier-modal__close" data-close-modal>
                ×
            </button>
        </div>

        <form asp-action="CreateSupplier"
        asp-controller="Admin"
        method="post"
        class="admin-form-grid supplier-form-grid"
        id="supplierCreateForm">
            <label class="admin-field">
                <span>Tên nhà cung cấp *</span>
                <input type="text" name="Name" required maxlength="180" minlength="3" placeholder="VD: Công ty TNHH Vàng Bạc ABC" />
            </label>

            <label class="admin-field">
                <span>Mã số thuế *</span>
                <input type="text"
                    name="TaxCode"
                    required
                    inputmode="numeric"
                    maxlength="13"
                    pattern="(\d{10}|\d{13})"
                    data-digits-only
                    placeholder="VD: 0312345678 hoặc 0312345678001" />
            </label>

            <label class="admin-field">
                <span>Người liên hệ *</span>
                <input type="text" name="ContactPerson" required maxlength="120" minlength="2" placeholder="VD: Nguyễn Văn A" />
            </label>

            <label class="admin-field">
                <span>Số điện thoại *</span>
                <input type="text"
                    name="Phone"
                    required
                    inputmode="numeric"
                    maxlength="10"
                    pattern="0\d{9}"
                    data-digits-only
                    placeholder="VD: 0901234567" />
            </label>

            <label class="admin-field">
                <span>Email</span>
                <input type="email" name="Email" maxlength="150" placeholder="supplier@example.com" />
            </label>

            <label class="admin-field">
                <span>Số ngày công nợ</span>
                <select name="PaymentTermDays" class="admin-select">
                    <option value="0">Thanh toán ngay</option>
                    <option value="7">7 ngày</option>
                    <option value="15">15 ngày</option>
                    <option value="30">30 ngày</option>
                    <option value="45">45 ngày</option>
                    <option value="60">60 ngày</option>
                    <option value="90">90 ngày</option>
                </select>
            </label>

            <div class="admin-field admin-field--wide">
                <span>Nhóm cung ứng *</span>

                <div class="supplier-checkbox-grid">
                    <label><input type="checkbox" name="SupplierTypes" value="Vàng" checked /> Vàng</label>
                    <label><input type="checkbox" name="SupplierTypes" value="Bạc" /> Bạc</label>
                    <label><input type="checkbox" name="SupplierTypes" value="Kim cương" /> Kim cương</label>
                    <label><input type="checkbox" name="SupplierTypes" value="Đá quý" /> Đá quý</label>
                    <label><input type="checkbox" name="SupplierTypes" value="Phụ kiện / hộp đựng" /> Phụ kiện / hộp đựng</label>
                    <label><input type="checkbox" name="SupplierTypes" value="Gia công / sửa chữa" /> Gia công / sửa chữa</label>
                </div>
            </div>

            <label class="admin-field">
                <span>Ngân hàng</span>
                <select name="BankName" class="admin-select">
                    <option value="">-- Không nhập --</option>
                    <option value="Vietcombank">Vietcombank</option>
                    <option value="VietinBank">VietinBank</option>
                    <option value="BIDV">BIDV</option>
                    <option value="Agribank">Agribank</option>
                    <option value="Techcombank">Techcombank</option>
                    <option value="ACB">ACB</option>
                    <option value="MB Bank">MB Bank</option>
                    <option value="Sacombank">Sacombank</option>
                    <option value="VPBank">VPBank</option>
                    <option value="TPBank">TPBank</option>
                    <option value="Khác">Khác</option>
                </select>
            </label>

            <label class="admin-field">
                <span>Số tài khoản</span>
                <input type="text"
                    name="BankAccountNumber"
                    inputmode="numeric"
                    maxlength="20"
                    minlength="6"
                    data-digits-only
                    placeholder="Chỉ nhập số" />
            </label>

            <label class="admin-field">
                <span>Chủ tài khoản</span>
                <input type="text" name="BankAccountName" maxlength="120" placeholder="VD: CONG TY TNHH ABC" />
            </label>

            <label class="admin-field admin-field--wide">
                <span>Địa chỉ *</span>
                <input type="text" name="Address" required maxlength="300" minlength="5" placeholder="Địa chỉ nhà cung cấp" />
            </label>

            <label class="admin-field admin-field--wide">
                <span>Ghi chú</span>
                <textarea name="Note" rows="3" maxlength="1000" placeholder="VD: chuyên cung ứng vàng 18K, có giấy kiểm định..."></textarea>
            </label>
            <div class="admin-field admin-field--wide">
                <div class="admin-alert admin-alert--danger"
                    id="supplierCreateError"
                    role="alert"
                    hidden>
                </div>
            </div>
            <div class="admin-form-actions">
                <button type="submit"
                        class="admin-button admin-button--primary"
                        id="supplierCreateSubmitButton">
                    Thêm nhà cung cấp
                </button>
            </div>
        </form>
        </div>
</div>
<div class="supplier-modal" id="purchaseOrderCreateModal" aria-hidden="true">
    <div class="supplier-modal__backdrop" data-close-modal></div>

    <div class="supplier-modal__dialog supplier-modal__dialog--large">
        <div class="supplier-modal__header">
            <div>
                <p class="admin-section__eyebrow">Đặt hàng nhập</p>
                <h2>Tạo đơn đặt hàng từ nhà cung cấp</h2>
            </div>

            <button type="button" class="supplier-modal__close" data-close-modal>×</button>
        </div>

        <form asp-action="CreateSupplierPurchaseOrder"
              asp-controller="Admin"
              method="post"
              class="supplier-purchase-form"
              id="supplierPurchaseOrderForm">

            <div class="supplier-order-grid">
                <label class="admin-field">
                    <span>Nhà cung cấp *</span>

                    <select name="SupplierId"
                            id="purchaseOrderSupplierSelect"
                            class="admin-select"
                            required>

                        <option value="">-- Chọn nhà cung cấp --</option>

                        @foreach (Supplier supplier in ViewBag.ActiveSuppliersForEdit)
                        {
                            <option value="@supplier.Id"
                                    data-supplier-types="@supplier.SupplierType">
                                @supplier.Name
                            </option>
                        }
                    </select>
                </label>

                <label class="admin-field">
                    <span>Chi nhánh nhận hàng *</span>
                    <select name="BranchId" class="admin-select" required asp-items="Model.BranchOptions"></select>
                </label>

                <label class="admin-field">
                    <span>Ngày dự kiến giao *</span>
                    <input type="date"
                           name="ExpectedDeliveryDate"
                           required
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </label>

                <label class="admin-field">
                    <span>Ghi chú đơn đặt hàng</span>
                    <textarea name="PurchaseOrderNote" rows="2" maxlength="1000"></textarea>
                </label>
            </div>

            <div class="purchase-order-line-toolbar">
                <div>
                    <p class="admin-section__eyebrow">Chi tiết hàng đặt</p>
                    <h3>Danh sách dòng hàng</h3>
                </div>

                <button type="button" class="admin-button admin-button--secondary" id="addPurchaseOrderLine">
                    + Thêm dòng hàng
                </button>
            </div>

            <div class="purchase-order-lines" id="purchaseOrderLines">
                <article class="purchase-order-line">
                    <div class="purchase-order-line__header">
                        <strong>Dòng hàng <span class="js-line-number">1</span></strong>

                        <button type="button"
                                class="admin-button admin-button--danger js-remove-purchase-line">
                            Xóa dòng
                        </button>
                    </div>

                    <div class="purchase-order-line__grid">
                        <label class="admin-field">
                            <span>Nhóm hàng *</span>
                            <select name="ProductLines" class="admin-select js-purchase-product-line" required>
                                <option value="">-- Chọn nhóm hàng --</option>
                                @foreach (var item in Model.ProductLineOptions)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </label>

                        <label class="admin-field js-category-field">
                            <span>Danh mục hàng *</span>

                            <select name="Categories" class="admin-select js-purchase-category" required>
                                <option value="">-- Chọn nhóm hàng trước --</option>
                            </select>
                        </label>

                    <label class="admin-field js-type-field">
                        <span>Chất liệu / phân loại *</span>

                        <select name="GoldTypes" class="admin-select js-purchase-type" required>
                            <option value="">-- Chọn nhóm hàng trước --</option>
                        </select>
                    </label>

                        <label class="admin-field">
                            <span>Tên sản phẩm dự kiến nhập *</span>
                            <input type="text" name="ProductNames" required maxlength="220" />
                        </label>

                        <label class="admin-field">
                            <span>Số lượng *</span>
                            <input type="number" name="Quantities" required min="1" step="1" value="1" />
                        </label>

                        <label class="admin-field">
                            <span>Đơn giá nhập *</span>
                            <input type="number" name="UnitCosts" required min="1" step="1000" />
                        </label>

                        <label class="admin-field">
                            <span class="js-weight-label">Trọng lượng gram</span>
                            <input type="number" name="Weights" min="0" step="0.01" value="0" />
                        </label>

                        <label class="admin-field">
                            <span class="js-carat-label">Carat</span>
                            <input type="number" name="DiamondCarats" min="0" step="0.01" />
                        </label>

                        <label class="admin-field">
                            <span>Mã kiểm định</span>
                            <input type="text" name="DiamondCertificates" maxlength="120" />
                        </label>

                        <label class="admin-field">
                            <span>Ghi chú dòng hàng</span>
                            <textarea name="DetailNotes" rows="2" maxlength="500"></textarea>
                        </label>
                    </div>
                </article>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-button admin-button--primary">
                    Tạo đơn đặt hàng NCC
                </button>
            </div>
        </form>
    </div>
</div>

<section class="admin-section" id="purchase-order-list">
    <div class="admin-section__header">
        <div>
            <p class="admin-section__eyebrow">Theo dõi đặt hàng</p>
            <h2>Đơn đặt hàng NCC gần đây</h2>
        </div>
    </div>

    <div class="table-shell">
        <table class="data-table supplier-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Nhà cung cấp</th>
                    <th>Chi nhánh nhận</th>
                    <th>Ngày tạo</th>
                    <th>Dự kiến giao</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PurchaseOrders.Any())
                {
                    foreach (var order in Model.PurchaseOrders)
                    {
                        var canEditOrder = order.Status == SupplierPurchaseOrder.StatusOrdered
                        && (order.Receipts == null || !order.Receipts.Any())
                        && (order.Payments == null || !order.Payments.Any());
                        var remainingOrderQuantity =
                            order.Details?.Sum(detail =>
                                Math.Max(
                                    0,
                                    detail.Quantity
                                    - detail.ReceivedQuantity))
                            ?? 0;

                        var canReceiveOrder =
                            remainingOrderQuantity > 0
                            && (
                                order.Status
                                    == SupplierPurchaseOrder.StatusOrdered
                                || order.Status
                                    == SupplierPurchaseOrder.StatusPartiallyReceived
                            );
                    <tr class="supplier-order-row js-order-detail-row"
                        data-detail-modal="purchaseOrderDetailModal-@order.Id">
                        <td>
                            <strong>@order.OrderCode</strong>
                        </td>
                        <td>
                            <div class="data-table__stack">
                                <strong>@order.Supplier?.Name</strong>
                                <span>@(order.Details?.FirstOrDefault()?.ProductName ?? "--")</span>
                            </div>
                        </td>
                        <td>@(order.Branch?.BranchName ?? "--")</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(order.ExpectedDeliveryDate.HasValue ? order.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy") : "--")</td>
                        <td class="data-table__accent">@order.TotalAmount.ToString("N0") ₫</td>
                        <td>
                            @if (order.Status == SupplierPurchaseOrder.StatusOrdered)
                            {
                                <span class="status-chip status-chip--warning">@order.Status</span>
                            }
                            else if (order.Status == SupplierPurchaseOrder.StatusReceived)
                            {
                                <span class="status-chip status-chip--success">@order.Status</span>
                            }
                            else if (order.Status == SupplierPurchaseOrder.StatusCancelled)
                            {
                                <span class="status-chip status-chip--neutral">@order.Status</span>
                            }
                            else
                            {
                                <span class="status-chip status-chip--info">@order.Status</span>
                            }
                        </td>
                        <td>
                            <div class="admin-action-group">
                                <button type="button"
                                        class="admin-button admin-button--secondary"
                                        data-open-modal="purchaseOrderDetailModal-@order.Id">
                                    Chi tiết
                                </button>
                                @if (canReceiveOrder)
                                {
                                    <button type="button"
                                            class="admin-button admin-button--primary"
                                            data-open-modal="supplierGoodsReceiptCreateModal-@order.Id">
                                        Nhận hàng
                                    </button>
                                }

                                @if (canEditOrder)
                                {
                                    <button type="button"
                                            class="admin-button admin-button--primary"
                                            data-open-modal="purchaseOrderEditModal-@order.Id">
                                        Sửa
                                    </button>

                                    <form asp-action="CancelSupplierPurchaseOrder"
                                        asp-controller="Admin"
                                        method="post"
                                        onsubmit="return confirm('Bạn có chắc muốn hủy đơn đặt hàng này không?');">
                                        <input type="hidden" name="purchaseOrderId" value="@order.Id" />
                                        <button type="submit" class="admin-button admin-button--danger">
                                            Hủy
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>

                    
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state-card supplier-empty-state">
                                <h3>Chưa có đơn đặt hàng NCC</h3>
                                <p>Sau khi tạo đơn, danh sách đơn đặt hàng gần đây sẽ hiển thị tại đây.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.PurchaseOrders.Any())
    {
        foreach (var order in Model.PurchaseOrders)
        {
            var canEditOrder =
                order.Status
                    == SupplierPurchaseOrder.StatusOrdered
                && (order.Receipts == null
                    || !order.Receipts.Any())
                && (order.Payments == null
                    || !order.Payments.Any());

            var remainingOrderQuantity =
                order.Details?.Sum(detail =>
                    Math.Max(
                        0,
                        detail.Quantity
                        - detail.ReceivedQuantity))
                ?? 0;

            var canReceiveOrder =
                remainingOrderQuantity > 0
                && (
                    order.Status
                        == SupplierPurchaseOrder.StatusOrdered
                    || order.Status
                        == SupplierPurchaseOrder.StatusPartiallyReceived
                );

            @await Html.PartialAsync(
                "_SupplierPurchaseOrderDetailModal",
                order)

            if (canReceiveOrder)
            {
                @await Html.PartialAsync(
                    "_SupplierGoodsReceiptCreateModal",
                    order)
            }

            if (canEditOrder)
            {
                @await Html.PartialAsync(
                    "_SupplierPurchaseOrderEditModal",
                    order)
            }
        }
    }
</section>
        @* =========================================================
            PHIẾU NHẬN HÀNG
            Phần này phải nằm ngoài bảng đơn đặt hàng
            và trước section danh sách nhà cung cấp.
            ========================================================= *@

            <section class="admin-section" id="goods-receipt-list">
                <div class="admin-section__header">
                    <div>
                        <p class="admin-section__eyebrow">
                            Tiếp nhận hàng hóa
                        </p>

                        <h2>Phiếu nhận hàng gần đây</h2>
                    </div>

                    <span class="status-chip status-chip--info">
                        @Model.RecentReceipts.Count phiếu
                    </span>
                </div>

                <div class="admin-alert admin-alert--success">
                    Nhân viên kiểm tra hàng hóa trực tiếp bên ngoài,
                    sau đó chỉ cần chọn Đạt hoặc Không đạt trên hệ thống.
                    Những dòng đạt sẽ được nhập kho khi duyệt phiếu.
                </div>

                <div class="table-shell">
                    <table class="data-table supplier-table">
                        <thead>
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Đơn đặt hàng</th>
                                <th>Nhà cung cấp</th>
                                <th>Kho nhận</th>
                                <th>Thời điểm nhận</th>
                                <th>Số lượng nhận</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.RecentReceipts.Any())
                            {
                                foreach (var receipt in Model.RecentReceipts)
                                {
                                    var receivedQuantity =
                                        receipt.Details?.Sum(
                                            detail =>
                                                detail.ReceivedQuantity)
                                        ?? 0;

                                    var canReview =
                                        receipt.Status
                                            == SupplierGoodsReceipt
                                                .StatusPendingInspection
                                        || receipt.Status
                                            == SupplierGoodsReceipt
                                                .StatusInspecting
                                        || receipt.Status
                                            == SupplierGoodsReceipt
                                                .StatusPendingApproval;

                                    <tr>
                                        <td>
                                            <strong>
                                                @receipt.ReceiptCode
                                            </strong>
                                        </td>

                                        <td>
                                            @(receipt.SupplierPurchaseOrder?
                                                .OrderCode ?? "--")
                                        </td>

                                        <td>
                                            @(receipt.SupplierPurchaseOrder?
                                                .Supplier?
                                                .Name ?? "--")
                                        </td>

                                        <td>
                                            <div class="data-table__stack">
                                                <strong>
                                                    @(receipt.Warehouse?.Name
                                                        ?? "--")
                                                </strong>

                                                <span>
                                                    @(receipt.Warehouse?.Code
                                                        ?? "--")
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            @(receipt.ReceivedAt.ToString("dd/MM/yyyy HH:mm"))
                                        </td>

                                        <td>
                                            @receivedQuantity.ToString("N0")
                                        </td>

                                        <td>
                                            @if (receipt.Status
                                                == SupplierGoodsReceipt
                                                    .StatusPendingInspection)
                                            {
                                                <span class="status-chip status-chip--warning">
                                                    Chờ kiểm tra
                                                </span>
                                            }
                                            else if (receipt.Status
                                                == SupplierGoodsReceipt
                                                    .StatusApproved)
                                            {
                                                <span class="status-chip status-chip--success">
                                                    Đã duyệt nhập kho
                                                </span>
                                            }
                                            else if (receipt.Status
                                                == SupplierGoodsReceipt
                                                    .StatusPartiallyApproved)
                                            {
                                                <span class="status-chip status-chip--info">
                                                    Đạt một phần
                                                </span>
                                            }
                                            else if (receipt.Status
                                                == SupplierGoodsReceipt
                                                    .StatusRejected)
                                            {
                                                <span class="status-chip status-chip--danger">
                                                    Không đạt
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-chip status-chip--info">
                                                    @receipt.Status
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <div class="admin-action-group">
                                                <button type="button"
                                                        class="admin-button admin-button--secondary"
                                                        data-open-modal="supplierGoodsReceiptDetailModal-@receipt.Id">
                                                    Chi tiết
                                                </button>

                                                @if (canReview)
                                                {
                                                    <button type="button"
                                                            class="admin-button admin-button--primary"
                                                            data-toggle-receipt-review="receiptReviewRow-@receipt.Id">
                                                        Kiểm hàng
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    @*
                                        Dòng kiểm hàng nằm trực tiếp dưới phiếu.
                                        Đây vẫn là một thẻ tr hợp lệ trong tbody,
                                        nên không làm vỡ bố cục bảng.
                                    *@
                                    @if (canReview)
                                    {
                                        <tr id="receiptReviewRow-@receipt.Id"
                                            hidden>

                                            <td colspan="8">
                                                <form asp-action="ApproveSupplierGoodsReceipt"
                                                    asp-controller="Admin"
                                                    method="post"
                                                    class="supplier-receipt-review-form">

                                                    <input type="hidden"
                                                        name="ReceiptId"
                                                        value="@receipt.Id" />

                                                    <div class="admin-section__header">
                                                        <div>
                                                            <p class="admin-section__eyebrow">
                                                                Ghi nhận kết quả kiểm hàng
                                                            </p>

                                                            <h3>
                                                                @receipt.ReceiptCode
                                                            </h3>
                                                        </div>
                                                    </div>

                                                    <div class="admin-alert admin-alert--success">
                                                        Mỗi dòng hàng được đánh giá toàn bộ:
                                                        hoặc toàn bộ đạt, hoặc toàn bộ không đạt.
                                                    </div>

                                                    <div class="table-shell">
                                                        <table class="data-table supplier-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Hàng hóa</th>
                                                                    <th>Số lượng nhận</th>
                                                                    <th>Thông tin thực nhận</th>
                                                                    <th>Kết quả</th>
                                                                    <th>Lý do không đạt</th>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                @foreach (var detail
                                                                    in receipt.Details)
                                                                {
                                                                    <tr class="js-simple-quality-row">
                                                                        <td>
                                                                            <div class="data-table__stack">
                                                                                <strong>
                                                                                    @(detail
                                                                                        .SupplierPurchaseOrderDetail?
                                                                                        .ProductName
                                                                                        ?? "--")
                                                                                </strong>

                                                                                <span>
                                                                                    @(detail
                                                                                        .SupplierPurchaseOrderDetail?
                                                                                        .ProductLine
                                                                                        ?? "--")
                                                                                    ·
                                                                                    @(detail
                                                                                        .SupplierPurchaseOrderDetail?
                                                                                        .Category
                                                                                        ?? "--")
                                                                                    ·
                                                                                    @(detail
                                                                                        .SupplierPurchaseOrderDetail?
                                                                                        .GoldType
                                                                                        ?? "--")
                                                                                </span>
                                                                            </div>
                                                                        </td>

                                                                        <td>
                                                                            <strong>
                                                                                @(detail.ReceivedQuantity.ToString("N0"))
                                                                            </strong>
                                                                        </td>

                                                                        <td>
                                                                            <div class="data-table__stack">
                                                                                @if (detail.ActualWeight > 0)
                                                                                {
                                                                                    <span>
                                                                                        Trọng lượng:
                                                                                        @(detail.ActualWeight.ToString("N2")) g
                                                                                    </span>
                                                                                }

                                                                                @if (detail
                                                                                    .ActualDiamondCarat
                                                                                    .HasValue)
                                                                                {
                                                                                    <span>
                                                                                        Carat:
                                                                                        @detail
                                                                                            .ActualDiamondCarat
                                                                                            .Value
                                                                                            .ToString("N2")
                                                                                    </span>
                                                                                }

                                                                                @if (!string.IsNullOrWhiteSpace(
                                                                                    detail
                                                                                        .ActualDiamondCertificate))
                                                                                {
                                                                                    <span>
                                                                                        Kiểm định:
                                                                                        @detail
                                                                                            .ActualDiamondCertificate
                                                                                    </span>
                                                                                }

                                                                                @if (detail.ActualWeight <= 0
                                                                                    && !detail
                                                                                        .ActualDiamondCarat
                                                                                        .HasValue)
                                                                                {
                                                                                    <span>--</span>
                                                                                }
                                                                            </div>
                                                                        </td>

                                                                        <td>
                                                                            <div class="admin-action-group">
                                                                                <label>
                                                                                    <input type="radio"
                                                                                        name="QualityResults[@detail.Id]"
                                                                                        value="@SupplierGoodsReceiptDetail.QualityPassed"
                                                                                        class="js-quality-result"
                                                                                        checked
                                                                                        required />

                                                                                    Đạt
                                                                                </label>

                                                                                <label>
                                                                                    <input type="radio"
                                                                                        name="QualityResults[@detail.Id]"
                                                                                        value="@SupplierGoodsReceiptDetail.QualityFailed"
                                                                                        class="js-quality-result" />

                                                                                    Không đạt
                                                                                </label>
                                                                            </div>
                                                                        </td>

                                                                        <td>
                                                                            <textarea name="RejectionReasons[@detail.Id]"
                                                                                    class="js-rejection-reason"
                                                                                    rows="2"
                                                                                    maxlength="500"
                                                                                    placeholder="Chỉ nhập khi hàng không đạt"
                                                                                    disabled>@detail.RejectionReason</textarea>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div class="admin-form-actions">
