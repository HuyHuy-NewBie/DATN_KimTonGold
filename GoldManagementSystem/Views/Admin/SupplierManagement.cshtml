                                                            }
                                                            else
                                                            {
                                                                <option value="@term">@(term == 0 ? "Thanh toán ngay" : $"{term} ngày")</option>
                                                            }
                                                        }
                                                    </select>
                                                </label>

                                                <div class="admin-field admin-field--wide">
                                                    <span>Nhóm cung ứng *</span>

                                                    <div class="supplier-checkbox-grid">
                                                        @foreach (var type in new[] { "Vàng", "Bạc", "Kim cương", "Đá quý", "Phụ kiện / hộp đựng", "Gia công / sửa chữa" })
                                                        {
                                                            var isChecked = (supplier.SupplierType ?? "")
                                                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                                .Select(item => item.Trim())
                                                                .Any(item => string.Equals(item, type, StringComparison.OrdinalIgnoreCase));

                                                            <label>
