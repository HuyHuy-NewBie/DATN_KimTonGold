            if (!selectedResult
                || !rejectionReason) {
                return;
            }

            const isFailed =
                selectedResult.value === "Không đạt";

            rejectionReason.disabled =
                !isFailed;

            rejectionReason.required =
                isFailed;

            if (!isFailed) {
                rejectionReason.value = "";
            }
        }

        document
            .querySelectorAll(".js-simple-quality-row")
            .forEach(function (row) {
                row
                    .querySelectorAll(".js-quality-result")
                    .forEach(function (radio) {
                        radio.addEventListener(
                            "change",
                            function () {
                                updateSimpleQualityRow(row);
                            }
                        );
                    });

                updateSimpleQualityRow(row);
            });
    </script>
}
