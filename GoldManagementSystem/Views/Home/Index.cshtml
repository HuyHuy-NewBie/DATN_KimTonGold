            <p data-i18n data-i18n-vi="Khám phá những thiết kế vừa cập nhật, mang tinh thần thanh lịch hiện đại và dễ dàng trở thành món quà hoàn hảo." data-i18n-en="Discover newly updated designs, featuring a modern elegant spirit, easily becoming the perfect gift.">Khám phá những thiết kế vừa cập nhật, mang tinh thần thanh lịch hiện đại và dễ dàng trở thành món quà hoàn hảo.</p>
        </div>

        @if (newestProducts.Any())
        {
            <div class="collection-grid">
                @foreach (var product in newestProducts)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
    </div>
</section>

