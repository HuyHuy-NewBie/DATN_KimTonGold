@model IEnumerable<GoldManagementSystem.Models.Product>
@using System
@using GoldManagementSystem.Models
@using System.Linq
@{
    ViewData["Title"] = "Trang chủ";
    var heroFallbackImage = "data:image/svg+xml," + Uri.EscapeDataString("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 780'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#f8dbe1'/><stop offset='100%' stop-color='#efe9df'/></linearGradient></defs><rect width='1600' height='780' fill='url(#g)'/><circle cx='260' cy='180' r='170' fill='rgba(255,255,255,0.5)'/><circle cx='1340' cy='540' r='220' fill='rgba(255,255,255,0.42)'/><circle cx='980' cy='170' r='90' fill='rgba(255,255,255,0.3)'/></svg>");
    var heroFallbackScript = $"this.onerror=null;const picture=this.closest('picture');if(picture){{picture.querySelectorAll('source').forEach(source => source.remove());}}this.src='{heroFallbackImage}';";

    var homeProducts = (Model ?? Enumerable.Empty<Product>()).ToList();
    var giftForLove = homeProducts.Take(5).ToList();
    var giftForMom = homeProducts.Skip(5).Take(5).ToList();
    if (!giftForMom.Any())
    {
        giftForMom = homeProducts.Take(5).ToList();
    }

    var newestProducts = homeProducts.Take(10).ToList();

    var stageSlides = new[]
    {
        new
        {
            Eyebrow = "Bộ sưu tập mới",
            Title = "Khoảnh khắc yêu thương",
            Description = "Khám phá những thiết kế mới nhất mang vẻ đẹp tinh tế, mềm mại và đầy cảm xúc cho mỗi dịp đặc biệt.",
            Image = "https://cdn.hstatic.net/files/200000103143/file/2880x1040_ab05f545eadc4e18b5adba948f40a5b0.jpg",
            MobileImage = "https://cdn.hstatic.net/files/200000103143/file/1000x600_71cb8eb81e8646f49921feeb7fe1b8cb.jpg",
            PrimaryLink = "/Products",
            SecondaryLink = "/Products?category=Nhẫn Cưới"
        },
        new
        {
            Eyebrow = "Sắc Việt",
            Title = "Tự hào vẻ đẹp riêng",
            Description = "Những thiết kế được chọn lọc để tôn vinh cá tính và dấu ấn riêng, từ ánh nhìn đầu tiên đến từng chi tiết hoàn thiện.",
            Image = "https://cdn.hstatic.net/files/200000103143/file/2880x1040_a6969acbfde44c41871ee40477d79747.jpg",
            MobileImage = "https://cdn.hstatic.net/files/200000103143/file/banner_mobile_1000x600_f9d26181efe04625b479c45cf057f5b9.jpg",
            PrimaryLink = "/Products/Gold",
            SecondaryLink = "/Products/Silver"
        },
        new
        {
            Eyebrow = "Cá nhân hoá",
            Title = "Khắc dấu ấn riêng",
            Description = "Lưu giữ cảm xúc bằng những món trang sức có thể kể câu chuyện của riêng bạn theo cách thật tinh tế.",
            Image = "https://cdn.hstatic.net/files/200000103143/file/banner_revise.jpg",
            MobileImage = "https://cdn.hstatic.net/files/200000103143/file/banner_mobile_revise.jpg",
            PrimaryLink = "/Products?searchString=Khắc",
            SecondaryLink = "/Account/Register"
        }
    };

    var categoryHighlights = new[]
    {
        new { Title = "Sản phẩm mới", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_764487c01_rgb.jpg", Link = "/Products/New" },
        new { Title = "Charms", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_764453c01_rgb.jpg", Link = "/Products?searchString=Charm" },
        new { Title = "Vòng tay", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_598827c01_rgb.jpg", Link = "/Products?category=Lắc Tay" },
        new { Title = "Nhẫn", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_164399c01_rgb.jpg", Link = "/Products?category=Nhẫn Cưới" },
        new { Title = "Hoa tai", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_264559c01_rgb.jpg", Link = "/Products?category=Bông Tai" },
        new { Title = "Dây chuyền", Image = "https://cdn.hstatic.net/files/200000103143/file/high_rgb_364503c01_rgb.jpg", Link = "/Products?category=Dây Chuyền" }
    };

    var storyHighlights = new[]
    {
        new { Title = "Khu vườn ký ức", Image = "https://cdn.hstatic.net/files/200000103143/file/block_1_069771b5dc7049e6821f8a79a9ef052f.jpg", Link = "/Products" },
        new { Title = "Mở khoá yêu thương", Image = "https://cdn.hstatic.net/files/200000103143/file/block_2_.jpg", Link = "/Products?searchString=Yêu" },
        new { Title = "Trân trọng chính mình", Image = "https://cdn.hstatic.net/files/200000103143/file/block_3_26be9d815db54390bda72cfb91a0293d.jpg", Link = "/Products/Silver" },
        new { Title = "Tự hào sắc Việt", Image = "https://cdn.hstatic.net/files/200000103143/file/770x770_ebda813edcee4251836ee2023c85d477.jpg", Link = "/Products/Gold" },
        new { Title = "Lưu giữ khoảnh khắc", Image = "https://cdn.hstatic.net/files/200000103143/file/block_5_330ec2a729cb42d9bac846232176faae.jpg", Link = "/Products?searchString=Khắc" },
        new { Title = "Gửi trọn tâm tình", Image = "https://cdn.hstatic.net/files/200000103143/file/block_6_120a217e90a943d18f53b16c2c8d52bd.jpg", Link = "/Products?searchString=Quà" }
    };

    var discoverCollections = new[]
    {
        new { Title = "Trang sức nâng tầm", Action = "Mua ngay", Image = "https://cdn.hstatic.net/files/200000103143/file/block_7.jpg", Link = "/Products/Gold" },
        new { Title = "Chuẩn gu thanh lịch", Action = "Xem ngay", Image = "https://cdn.hstatic.net/files/200000103143/file/block_8.jpg", Link = "/Products/Silver" },
        new { Title = "Thay lời yêu thương", Action = "Xem ngay", Image = "https://cdn.hstatic.net/files/200000103143/file/block_10.jpg", Link = "/Products?searchString=Quà" },
        new { Title = "Mảnh nhớ nhiệm màu", Action = "Xem ngay", Image = "https://cdn.hstatic.net/files/200000103143/file/block_9.jpg", Link = "/Products/Gold" }
    };
}

<section class="home-stage">
    <div class="home-stage__inner">
        <div class="home-stage__frame" data-carousel="home-stage">
            <div class="home-stage__rail">
                @for (var i = 0; i < stageSlides.Length; i++)
                {
                    var slide = stageSlides[i];
                    <article class="home-stage__slide @(i == 0 ? "is-active" : "")">
                        <picture>
                            <source srcset="@slide.MobileImage" media="(max-width: 767px)" />
                            <img src="@slide.Image" alt="@slide.Title" loading="eager" fetchpriority="high" onerror="@heroFallbackScript" />
                        </picture>
                        <a href="@slide.PrimaryLink" class="home-stage__clickzone" aria-label="@slide.Title"></a>
                    </article>
                }
            </div>

            <div class="home-stage__bullets">
                @for (var i = 0; i < stageSlides.Length; i++)
                {
                    <button type="button" class="@(i == 0 ? "is-active" : "")" data-carousel-bullet aria-label="Chuyển slide @(i + 1)"></button>
                }
            </div>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="home-section__inner">
        <div class="section-heading">
            <p class="section-heading__eyebrow" data-i18n data-i18n-vi="Khám phá" data-i18n-en="Explore">Khám phá</p>
            <h2 data-i18n data-i18n-vi="Danh mục nổi bật" data-i18n-en="Featured Categories">Danh mục nổi bật</h2>
            <p data-i18n data-i18n-vi="Từ nhẫn, dây chuyền đến charm và quà tặng, mỗi danh mục đều mở ra một câu chuyện trang sức đầy cảm hứng." data-i18n-en="From rings and necklaces to charms and gifts, each category opens up an inspiring jewelry story.">Từ nhẫn, dây chuyền đến charm và quà tặng, mỗi danh mục đều mở ra một câu chuyện trang sức đầy cảm hứng.</p>
        </div>

        <div class="home-category__grid">
            @foreach (var category in categoryHighlights)
            {
                <a href="@category.Link" class="home-category-card">
                    <div class="home-category-card__thumb">
                        <img src="@category.Image" alt="@category.Title" />
                    </div>
                    <span data-auto-i18n>@category.Title</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="home-section">
    <div class="home-section__inner">
        <div class="home-video">
            <video autoplay muted loop playsinline poster="https://cdn.hstatic.net/files/200000103143/file/2880x1040_ab05f545eadc4e18b5adba948f40a5b0.jpg">
                <source src="https://cdn.hstatic.net/files/200000103143/file/2026q2c_collection_moments_go_pur_ic_pna_04_10sec_16x9_clean.mp4" type="video/mp4" />
            </video>
            <div class="home-video__caption">
                <span data-i18n data-i18n-vi="Dẫn lối yêu thương" data-i18n-en="Guiding love">Dẫn lối yêu thương</span>
                <strong>Moments & Stories</strong>
            </div>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="home-section__inner">
        <div class="section-heading">
            <p class="section-heading__eyebrow" data-i18n data-i18n-vi="Biên tập nội dung" data-i18n-en="Editorial">Biên tập nội dung</p>
            <h2 data-i18n data-i18n-vi="Dẫn lối yêu thương" data-i18n-en="Guiding love">Dẫn lối yêu thương</h2>
            <p data-i18n data-i18n-vi="Khám phá những thông điệp dịu dàng, những khoảnh khắc đáng nhớ và những bộ sưu tập được tuyển chọn cho từng cảm xúc." data-i18n-en="Discover gentle messages, memorable moments and curated collections for every emotion.">Khám phá những thông điệp dịu dàng, những khoảnh khắc đáng nhớ và những bộ sưu tập được tuyển chọn cho từng cảm xúc.</p>
        </div>

        <div class="editorial-grid">
            @foreach (var story in storyHighlights)
            {
                <a href="@story.Link" class="editorial-card editorial-card--wide">
                    <img src="@story.Image" alt="@story.Title" />
                    <div class="editorial-card__content">
                        <h3 data-auto-i18n>@story.Title</h3>
                        <span data-i18n data-i18n-vi="Xem ngay" data-i18n-en="Shop now">Xem ngay</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<span id="gift-zone" class="section-anchor" aria-hidden="true"></span>

<section class="home-section">
    <div class="home-section__inner">
        <div class="section-heading">
            <p class="section-heading__eyebrow">Gift Edit</p>
            <h2 data-i18n data-i18n-vi="Quà cho người yêu" data-i18n-en="Gifts for loved ones">Quà cho người yêu</h2>
            <p data-i18n data-i18n-vi="Những món quà tinh tế giúp thay lời yêu thương, dành cho khoảnh khắc ngọt ngào và những kỷ niệm đáng nhớ." data-i18n-en="Exquisite gifts that substitute words of love, for sweet moments and unforgettable memories.">Những món quà tinh tế giúp thay lời yêu thương, dành cho khoảnh khắc ngọt ngào và những kỷ niệm đáng nhớ.</p>
        </div>

        @if (giftForLove.Any())
        {
            <div class="gift-grid">
                @foreach (var product in giftForLove)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
    </div>
</section>

<section class="home-section">
    <div class="home-section__inner">
        <div class="section-heading">
            <p class="section-heading__eyebrow">Gift Edit</p>
            <h2 data-i18n data-i18n-vi="Quà cho mẹ" data-i18n-en="Gifts for mom">Quà cho mẹ</h2>
            <p data-i18n data-i18n-vi="Chọn một món trang sức ý nghĩa để gửi lời cảm ơn chân thành tới người phụ nữ luôn dịu dàng và yêu thương nhất." data-i18n-en="Choose a meaningful piece of jewelry to express sincere gratitude to the most gentle and loving woman.">Chọn một món trang sức ý nghĩa để gửi lời cảm ơn chân thành tới người phụ nữ luôn dịu dàng và yêu thương nhất.</p>
        </div>

        @if (giftForMom.Any())
        {
            <div class="gift-grid">
                @foreach (var product in giftForMom)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
    </div>
</section>

