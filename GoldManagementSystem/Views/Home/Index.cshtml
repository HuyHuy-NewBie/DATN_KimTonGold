                    </div>
                    <div class="section-heading__actions">
                        <a href="/Products?searchString=Khắc" class="btn-solid" data-i18n data-i18n-vi="Khám phá ngay" data-i18n-en="Discover now">Khám phá ngay</a>
                        <a href="/Products?searchString=Charm" class="btn-outline" data-i18n data-i18n-vi="Xem charm" data-i18n-en="View charms">Xem charm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="home-section__inner">
        <div class="section-heading">
            <p class="section-heading__eyebrow" data-i18n data-i18n-vi="Khám phá" data-i18n-en="Explore">Khám phá</p>
            <h2 data-i18n data-i18n-vi="Bộ sưu tập nổi bật" data-i18n-en="Featured collections">Bộ sưu tập nổi bật</h2>
            <p data-i18n data-i18n-vi="Những bộ sưu tập được yêu thích nhất, mang vẻ đẹp thanh lịch, hiện đại và giàu cảm xúc cho nhiều phong cách khác nhau." data-i18n-en="The most loved collections, featuring elegant, modern, and emotional designs for various styles.">Những bộ sưu tập được yêu thích nhất, mang vẻ đẹp thanh lịch, hiện đại và giàu cảm xúc cho nhiều phong cách khác nhau.</p>
        </div>

        <div class="discover-grid">
            @foreach (var collection in discoverCollections)
            {
                <a href="@collection.Link" class="discover-card">
                    <div class="discover-card__thumb">
                        <img src="@collection.Image" alt="@collection.Title" />
                    </div>
                    <div class="discover-card__detail">
                        <h3 data-auto-i18n>@collection.Title</h3>
                        <span class="btn-inline" data-auto-i18n>@collection.Action</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

