@model GoldManagementSystem.Models.Product
@using System.Collections.Generic
@using System.Linq
@{
    const string fallbackImageUrl = "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=900&q=80";
    var galleryImages = Model.GalleryImages.Any()
        ? Model.GalleryImages.Take(3).ToList()
        : new List<string>
        {
            fallbackImageUrl
        };
    var badge = Model.Status == "Mới" || Model.Status == "Bán chạy" ? Model.Status : null;
    var badgeEn = badge == "Mới" ? "New" : badge == "Bán chạy" ? "Best seller" : badge;
    var isDiamond = Model.IsDiamondProduct || (!string.IsNullOrWhiteSpace(Model.DiamondShape) && Model.DiamondCarat.HasValue);
    var specLabel = isDiamond
        ? $"{Model.DiamondShape} • {(Model.DiamondCarat.HasValue ? $"{Model.DiamondCarat:0.##} ct" : $"{Model.DiamondSize:0.#} ly")}"
        : $"{Model.Category} • {Model.Weight:0.#} chỉ";
}

<article class="product-card-shell">
    <a href="/Products/Details/@Model.Id" class="product-card-shell__image">
        <div class="product-card-shell__gallery"
             data-rotating-gallery="@(galleryImages.Count > 1 ? "true" : "false")"
             data-rotation-interval="3800">
            @for (var index = 0; index < galleryImages.Count; index++)
            {
                var image = galleryImages[index];
                <img src="@image"
                     alt="@Model.Name"
                     class="@(index == 0 ? "is-active" : string.Empty)"
                     onerror="this.onerror=null;this.src='@fallbackImageUrl';"
                     loading="lazy" />
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(badge))
        {
            <span class="product-card-shell__badge"
                  data-i18n
                  data-i18n-vi="@badge"
                  data-i18n-en="@badgeEn">
                @badge
            </span>
        }

    </a>

    <div class="product-card-shell__body">
        <p class="product-card-shell__meta" data-auto-i18n>@Model.GoldType</p>
        <h3 class="product-card-shell__title">
            <a href="/Products/Details/@Model.Id" data-auto-i18n>@Model.Name</a>
        </h3>
        <div class="product-card-shell__facts">
            <span>@specLabel</span>
            @if (isDiamond && !string.IsNullOrWhiteSpace(Model.DiamondCut))
            {
                <span>@Model.DiamondCut / @Model.DiamondColor / @Model.DiamondClarity</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="product-card-shell__summary">@Model.Description</p>
        }
        <p class="product-card-shell__price">@Model.SellPrice.ToString("N0") ₫</p>
    </div>
</article>
