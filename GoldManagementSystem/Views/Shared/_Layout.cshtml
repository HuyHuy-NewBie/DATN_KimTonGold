    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const trigger = document.getElementById("notificationBellTrigger");
                const dropdown = document.getElementById("notificationDropdown");
                const badge = document.getElementById("notificationBadge");
                const list = document.getElementById("notificationList");
                const clearBtn = document.getElementById("clearNotifications");

                // Check authorization role to see if user is staff/admin
                const isStaff = @(isStaffArea ? "true" : "false");

                // Initialize local notifications from localStorage
                let notifications = JSON.parse(localStorage.getItem("notifications_v1") || "[]");
                const escapeHtml = value => String(value ?? "").replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));

                function saveNotifications() {
                    localStorage.setItem("notifications_v1", JSON.stringify(notifications));
                }

                function renderNotifications() {
                    if (!list) return;
                    if (notifications.length === 0) {
                        list.innerHTML = '<div class="notification-dropdown__empty">Chưa có thông báo nào</div>';
                        badge.style.display = "none";
                        return;
                    }

                    const unreadCount = notifications.filter(n => !n.isRead).length;
                    if (unreadCount > 0) {
                        badge.textContent = unreadCount;
                        badge.style.display = "inline-flex";
                    } else {
                        badge.style.display = "none";
                    }

                    list.innerHTML = notifications.map(n => `
                        <a href="${escapeHtml(n.link || '#')}" class="notification-item ${n.isRead ? '' : 'is-unread'}" data-id="${escapeHtml(n.id)}" data-server-id="${n.serverId || ''}">
                            <span class="notification-item__title">${escapeHtml(n.title)}</span>
                            <span class="notification-item__body">${escapeHtml(n.body)}</span>
                            <span class="notification-item__time">${escapeHtml(n.time)}</span>
                        </a>
                    `).join('');

                    // Add click handlers to mark as read
                    document.querySelectorAll(".notification-item").forEach(item => {
                        item.addEventListener("click", function (e) {
                            const id = this.getAttribute("data-id");
                            const index = notifications.findIndex(n => String(n.id) === id);
                            if (index !== -1) {
                                notifications[index].isRead = true;
                                saveNotifications();
                            }
                            const serverId = this.dataset.serverId;
                            if (serverId) {
                                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                                fetch('/Notifications/Read', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token || '' }, body: `id=${encodeURIComponent(serverId)}&__RequestVerificationToken=${encodeURIComponent(token || '')}` });
                            }
                        });
                    });
                }

                if (trigger && dropdown) {
                    trigger.addEventListener("click", function (e) {
                        e.stopPropagation();
                        dropdown.classList.toggle("is-active");
                    });
                    document.addEventListener("click", function () {
                        dropdown.classList.remove("is-active");
                    });
                    dropdown.addEventListener("click", function (e) {
                        e.stopPropagation();
                    });
                }

                if (clearBtn) {
                    clearBtn.addEventListener("click", function () {
                        notifications = [];
                        saveNotifications();
                        renderNotifications();
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (token) fetch('/Notifications/ReadAll', { method: 'POST', headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' }, body: `__RequestVerificationToken=${encodeURIComponent(token)}` });
                    });
                }

                // Show visual toast notification in bottom right corner
                function showToast(title, body) {
                    const toast = document.createElement("div");
                    toast.className = "toast-notification";
                    toast.innerHTML = `
                        <div class="toast-notification__title">${title}</div>
                        <div class="toast-notification__body">${body}</div>
                    `;
                    document.body.appendChild(toast);
                    
                    setTimeout(() => {
                        toast.classList.add("is-visible");
                    }, 100);

                    // Auto hide after 5 seconds
                    setTimeout(() => {
                        toast.classList.remove("is-visible");
                        setTimeout(() => {
                            toast.remove();
                        }, 500);
                    }, 5000);
                }

                function addNotification(title, body, link, time) {
                    const newNotif = {
                        id: Date.now().toString(),
                        title: title,
                        body: body,
                        link: link || "#",
                        time: time || new Date().toLocaleTimeString("vi-VN", {hour: '2-digit', minute:'2-digit'}),
                        isRead: false
                    };
                    notifications.unshift(newNotif);
                    // limit to 30 notifications max
                    if (notifications.length > 30) notifications.pop();
                    saveNotifications();
                    renderNotifications();
                    showToast(title, body);
                }

                renderNotifications();
                fetch('/Notifications/List', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.ok ? response.json() : [])
                    .then(items => {
                        const serverItems = items.map(item => ({ id: `db-${item.id}`, serverId: item.id, title: item.title, body: item.body, link: item.link || '#', time: new Date(item.createdAt).toLocaleString('vi-VN'), isRead: item.isRead }));
                        const localOnly = notifications.filter(item => !item.serverId);
                        notifications = [...serverItems, ...localOnly].slice(0, 50);
                        saveNotifications();
                        renderNotifications();
                    }).catch(() => {});

                // Setup SignalR connection
                if (typeof signalR !== "undefined") {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect()
                        .build();

                    // 1. Staff/Admin: new pending confirmation order
                    connection.on("ReceiveOrderNotification", function (data) {
                        if (isStaff) {
                            const title = "🔔 Đơn Hàng Chờ Xác Nhận Mới";
                            const body = `Mã đơn: #${data.orderNumber} | Khách: ${data.customerName} | Tổng: ${data.totalAmount.toLocaleString('vi-VN')} ₫`;
                            const link = `/Admin/OrderManagement?orderId=${data.orderId}`;
                            addNotification(title, body, link, data.time);
                        }
                    });

                    // 2. Customer: order confirmed
                    connection.on("ReceiveOrderConfirmedNotification", function (data) {
                        const title = "✅ Đơn Hàng Đã Xác Nhận";
                        const body = `Chúc mừng! Đơn hàng #${data.orderNumber} của bạn đã được duyệt thành công.`;
                        const link = `/User/Orders`;
                        addNotification(title, body, link, data.time);
                    });

                    // 3. Customer: order cancelled due to no deposit
                    connection.on("ReceiveOrderCancelledNotification", function (data) {
                        const title = "❌ Đơn Hàng Đã Bị Hủy";
                        const body = `Đơn hàng #${data.orderNumber} đã bị tự động hủy do chưa nhận được thanh toán cọc.`;
                        const link = `/User/Orders`;
                        addNotification(title, body, link, data.time);
                    });

                    // 4. Customer: order rejected/cancelled by staff
                    connection.on("ReceiveOrderRejectedNotification", function (data) {
                        const title = "❌ Đơn Hàng Bị Từ Chối";
                        const body = `Đơn hàng #${data.orderNumber} đã bị từ chối/hủy. Lý do: ${data.message.indexOf("Lý do: ") !== -1 ? data.message.split("Lý do: ")[1] : "Không xác định"}`;
                        const link = `/User/Orders`;
                        addNotification(title, body, link, data.time);
                    });

                    connection.on("ReceiveSystemNotification", function (data) {
                        const item = { id: `db-${data.id}`, serverId: data.id, title: data.title, body: data.body, link: data.link || '#', time: new Date(data.time).toLocaleString('vi-VN'), isRead: false };
                        notifications.unshift(item);
                        notifications = notifications.slice(0, 50);
                        saveNotifications();
                        renderNotifications();
                        showToast(data.title, data.body);
                    });

                    connection.start().then(function () {
                        console.log("SignalR Connected to /notificationHub");
                    }).catch(function (err) {
                        console.error("SignalR Connection Error: ", err.toString());
                    });
                }

                const attendanceForm = document.getElementById('attendanceMenuForm');
                if (attendanceForm) {
                    const refreshAttendance = () => fetch('/Management/AttendanceStatus', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(response => response.ok ? response.json() : { available: false })
                        .then(state => {
                            attendanceForm.hidden = !state.available;
                            if (!state.available) return;
                            attendanceForm.querySelector('[name="assignmentId"]').value = state.assignmentId;
                            const button = attendanceForm.querySelector('[data-attendance-button]');
                            button.textContent = state.label;
                            button.disabled = !state.canSubmit;
                            attendanceForm.querySelector('[data-attendance-context]').textContent = `${state.branch} · ${state.shift}`;
                        }).catch(() => { attendanceForm.hidden = true; });
                    attendanceForm.addEventListener('submit', event => {
                        event.preventDefault();
                        fetch(attendanceForm.action, { method: 'POST', body: new FormData(attendanceForm), headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                            .then(async response => { if (!response.ok) throw new Error(await response.text()); return response.json(); })
                            .then(result => { showToast('Điểm danh thành công', result.note || result.status); refreshAttendance(); })
                            .catch(error => showToast('Không thể điểm danh', error.message));
                    });
                    refreshAttendance();
                    window.setInterval(refreshAttendance, 30000);
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    <div id="floatingChatLauncher">
        <button type="button" id="chatToggleButton" aria-label="Mở hỗ trợ khách hàng">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.5c4.69 0 8.5 3.81 8.5 8.5 0 4.12-2.98 7.53-6.9 8.33l-1.14.27a1.51 1.51 0 0 1-1.1-.23l-2.56-1.87A8.46 8.46 0 0 1 3.5 11C3.5 6.31 7.31 2.5 12 2.5Z" fill="currentColor" opacity="0.95"/>
                <path d="M8.5 10.5h7M8.5 13.5h4" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    <aside id="supportWidgetPanel" aria-hidden="true">
        <div id="supportWidgetHeader">
            <div>
                <p class="support-label">HỖ TRỢ KHÁCH HÀNG</p>
                <p class="support-heading">KimTon tư vấn 24/7</p>
            </div>
            <button type="button" id="supportCloseButton" aria-label="Đóng hỗ trợ">✕</button>
        </div>
        <div id="supportWidgetBody">
            <div class="support-contact-row">
                <button type="button" class="support-pill support-messenger" data-url="https://www.facebook.com/tuan.anh.78948?locale=vi_VN">
                    <span class="pill-icon">💬</span>
                    Messenger
                </button>
                <button type="button" class="support-pill support-zalo" data-url="https://zalo.me/0961137407">
                    <span class="pill-icon">📱</span>
                    Zalo
                </button>
            </div>
            <div class="support-chat">
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-bubble ai">Xin chào anh/chị! 👋 Em là trợ lý ảo KimTon. Anh/chị có thể hỏi em về giá sản phẩm, chọn size, bảo hành, thu đổi hoặc đặt hàng nhé!</div>
                </div>
                <div class="quick-chips" id="quickChips">
                    <button type="button" class="quick-chip">Giá sản phẩm</button>
                    <button type="button" class="quick-chip">Chọn size</button>
                    <button type="button" class="quick-chip">Bảo hành</button>
                    <button type="button" class="quick-chip">Đặt hàng</button>
                    <button type="button" class="quick-chip">Chính sách thu đổi</button>
                </div>
                <div class="chat-actions">
                    <input type="text" id="chatInput" class="chat-input" placeholder="Nhập câu hỏi của bạn..." aria-label="Nhập tin nhắn" />
                    <button type="button" class="send-button" id="sendChatButton" aria-label="Gửi tin nhắn">Gửi</button>
                </div>
            </div>
        </div>
    </aside>

    <script>
        (function() {
            const chatToggleButton = document.getElementById('chatToggleButton');
            const floatingChatLauncher = document.getElementById('floatingChatLauncher');
            const supportWidgetPanel = document.getElementById('supportWidgetPanel');
            const supportCloseButton = document.getElementById('supportCloseButton');
            const supportOptions = document.querySelectorAll('.support-pill');
            const chatMessages = document.getElementById('chatMessages');
            const quickChips = document.getElementById('quickChips');
            const chatInput = document.getElementById('chatInput');
            const sendChatButton = document.getElementById('sendChatButton');

            function setPanelOpen(open) {
                if (open) {
                    supportWidgetPanel.classList.add('active');
                    supportWidgetPanel.setAttribute('aria-hidden', 'false');
                    if (floatingChatLauncher) {
                        floatingChatLauncher.style.display = 'none';
                    }
                    if (quickChips) {
                        quickChips.style.display = 'flex';
                    }
                } else {
                    supportWidgetPanel.classList.remove('active');
                    supportWidgetPanel.setAttribute('aria-hidden', 'true');
                    if (floatingChatLauncher) {
                        floatingChatLauncher.style.display = 'block';
                    }
                }
            }

            function addMessage(text, sender) {
                const bubble = document.createElement('div');
                bubble.className = 'chat-bubble ' + sender;
                bubble.textContent = text;
                chatMessages.appendChild(bubble);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            // Lịch sử hội thoại cho multi-turn AI
            const chatHistory = [];

            function handleQuickChip(event) {
                const chip = event.target.closest('.quick-chip');
                if (!chip) return;
                // Gửi ngay khi click chip, không chỉ điền vào input
                sendMessage(chip.textContent.trim());
                if (quickChips) {
                    quickChips.style.display = 'none';
                }
            }

            async function handleSend() {
                const value = chatInput.value.trim();
                if (!value) return;
                chatInput.value = '';
                await sendMessage(value);
            }

            async function sendMessage(text) {
                if (!text) return;

                addMessage(text, 'user');
                sendChatButton.disabled = true;
                sendChatButton.textContent = '⏳';

                const loadingBubble = document.createElement('div');
                loadingBubble.className = 'chat-bubble ai loading';
                loadingBubble.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
                chatMessages.appendChild(loadingBubble);
                chatMessages.scrollTop = chatMessages.scrollHeight;

                try {
                    const response = await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            history: chatHistory.slice(),   // gửi toàn bộ lịch sử
                            userMessage: text
                        })
                    });

                    const result = await response.json();
                    const reply = result.reply || 'Em xin lỗi, hệ thống đang bận. Anh/chị vui lòng thử lại sau ạ.';

                    loadingBubble.remove();
                    addMessage(reply, 'ai');

                    // Cập nhật lịch sử (giữ tối đa 10 lượt)
                    chatHistory.push({ role: 'user', text: text });
                    chatHistory.push({ role: 'model', text: reply });
                    if (chatHistory.length > 20) chatHistory.splice(0, 2);

                } catch (error) {
                    loadingBubble.remove();
                    addMessage('Em xin lỗi, kết nối gặp sự cố. Anh/chị vui lòng thử lại sau hoặc gọi Hotline nhé!', 'ai');
                    console.error('[ChatBot]', error);
                } finally {
                    sendChatButton.disabled = false;
                    sendChatButton.textContent = '→';
                }
            }

            chatToggleButton.addEventListener('click', function() {
                setPanelOpen(!supportWidgetPanel.classList.contains('active'));
            });

            supportCloseButton.addEventListener('click', function() {
                setPanelOpen(false);
            });

            supportOptions.forEach(button => {
                button.addEventListener('click', function() {
                    const url = this.getAttribute('data-url');
                    if (!url) return;
                    if (url.startsWith('tel:')) {
                        window.location.href = url;
                    } else {
                        window.open(url, '_blank');
                    }
                });
            });

            quickChips.addEventListener('click', handleQuickChip);
            sendChatButton.addEventListener('click', handleSend);
            chatInput.addEventListener('keydown', function(event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    handleSend();
                }
            });

            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && supportWidgetPanel.classList.contains('active')) {
                    setPanelOpen(false);
                }
            });
        })();
    </script>
    <script>
        // Không giữ màn tải quá 5 giây cho một trang; nội dung hiện ngay khi DOM sẵn sàng.
        (function () {
            var hide = function () { document.getElementById('pageLoading')?.classList.add('page-loading--done'); };
            document.addEventListener('DOMContentLoaded', function () { setTimeout(hide, 260); });
            setTimeout(hide, 4800);
        })();
    </script>
</body>
