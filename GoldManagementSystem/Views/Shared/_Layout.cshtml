@using GoldManagementSystem.Data
@using GoldManagementSystem.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IManagementPermissionService PermissionService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KimTon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4BZmM8cw5lB0G1gka3idjF0A2/3+hHh5jzQ9J2KLL4jh00A1H4CuN+SBHEWmyX0x" crossorigin="anonymous">
    <script>
        (function() {
            var lang = localStorage.getItem("preferredLanguage") || "vi";
            document.documentElement.lang = lang;
            if (lang === "en") {
                document.documentElement.classList.add("lang-loading");
            }
        })();

    </script>
    <style>
        html.lang-loading [data-i18n], 
        html.lang-loading [data-auto-i18n],
        html.lang-loading .data-table td,
        html.lang-loading .status-chip,
        html.lang-loading option {
            opacity: 0 !important;
        }  

        /* Notification Bell Styles */
        .notification-bell {
            position: relative;
            display: inline-block;
        }
        .notification-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            width: 320px;
            background: #fff;
            border: 1px solid rgba(39, 37, 31, 0.1);
            border-radius: 20px;
            box-shadow: 0 12px 36px rgba(17, 17, 17, 0.15);
            display: none;
            z-index: 1000;
            margin-top: 0.75rem;
            overflow: hidden;
        }
        .notification-dropdown.is-active {
            display: block;
        }
        .notification-dropdown__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.85rem 1.1rem;
            border-bottom: 1px solid rgba(39, 37, 31, 0.06);
            background: #fff8fa;
        } 
        .notification-dropdown__header span {
            font-weight: 700;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--brand-ink, #111);
        }
        .notification-dropdown__header button {
            background: none;
            border: none;
            color: #cb3a6a;
            font-size: 0.74rem;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .notification-dropdown__list {
            max-height: 280px;
            overflow-y: auto;
        }
        .notification-item {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid rgba(39, 37, 31, 0.05);
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            text-decoration: none;
            color: #111;
            transition: background 0.2s ease;
        }
        .notification-item:hover {
            background: #fff8fa;
        }
        .notification-item.is-unread {
            background: #fff3f6;
        }
        .notification-item__title {
            font-weight: 700;
            font-size: 0.82rem;
            color: #111;
        }
        .notification-item__body {
            font-size: 0.78rem;
            color: var(--brand-muted, #555);
            line-height: 1.4;
        }
        .notification-item__time {
            font-size: 0.7rem;
            color: #999;
            align-self: flex-end;
            margin-top: 0.1rem;
        }
        .notification-dropdown__empty {
            padding: 2.5rem 1.1rem;
            text-align: center;
            color: #999;
            font-size: 0.82rem;
        }
        /* Toast notification at corner */
        .toast-notification {
            position: fixed;
            bottom: 96px;
            right: 24px;
            background: #fff;
            border-left: 4px solid #ef7a9d;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            padding: 1rem 1.25rem;
            z-index: 9999;
            max-width: 320px;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .toast-notification.is-visible {
            transform: translateY(0);
            opacity: 1;
        }
        .toast-notification__title {
            font-weight: 700;
            font-size: 0.84rem;
            color: #ef7a9d;
        }
        .toast-notification__body {
            font-size: 0.8rem;
            color: #333;
            line-height: 1.4;
        }

        /* Floating Chat Widget */
        #floatingChatLauncher {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 1100;
        }
        #chatToggleButton {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #ff6eb4, #ffadd6);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 28px rgba(255,110,180,0.45);
            cursor: pointer;
            transition: transform 0.22s ease, box-shadow 0.22s ease;
        }
        #chatToggleButton:hover {
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 14px 36px rgba(255,110,180,0.50);
        }
        #supportWidgetPanel {
            position: fixed;
            right: 20px;
            bottom: 24px;
            width: 390px;
            max-width: calc(100vw - 32px);
            max-height: min(92vh, 650px);
            border-radius: 22px;
            overflow: hidden;
            background: #ffffff;
            border: 1.5px solid #fce4f0;
            box-shadow: 0 16px 56px rgba(255,100,180,0.18), 0 2px 12px rgba(0,0,0,0.06);
            display: none;
            flex-direction: column;
            animation: panelFadeIn 0.28s ease both;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            z-index: 1101;
        }
        #supportWidgetPanel.active {
            display: flex;
        }
        #supportWidgetHeader {
            padding: 16px 18px 14px;
            background: #ffffff;
            border-bottom: 1.5px solid #fce4f0;
            color: #1a1a2e;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }
        #supportWidgetHeader .support-label {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: #ff6eb4;
            text-transform: uppercase;
            margin: 0 0 3px;
        }
        #supportWidgetHeader .support-heading {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
            color: #1a1a2e;
        }
        #supportCloseButton {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: #f5f5f5;
            color: #888;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            transition: background 0.2s ease, color 0.2s ease;
            flex-shrink: 0;
        }
        #supportCloseButton:hover {
            background: #fce4f0;
            color: #ff6eb4;
        }
        #supportWidgetBody {
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: #ffffff;
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }
        .support-contact-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .support-pill {
            min-height: 46px;
            border: 1.5px solid #f0e0ea;
            border-radius: 14px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            background: #fff9fc;
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }
        .support-pill:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(255,110,180,0.15);
        }
        .support-pill .pill-icon {
            font-size: 1.1rem;
        }
        .support-pill.support-messenger {
            color: #1877f2;
            border-color: #ddeeff;
            background: #f0f6ff;
        }
        .support-pill.support-zalo {
            color: #0068ff;
            border-color: #cce0ff;
            background: #f0f6ff;
        }
        .support-pill.support-hotline {
            color: #ff4488;
            border-color: #ffd6eb;
            background: #fff0f7;
        }
        .support-chat {
            background: #fff8fc;
            border: 1.5px solid #fce4f0;
            border-radius: 18px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1 1 auto;
            min-height: 220px;
            overflow: hidden;
        }
        .chat-messages {
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow-y: auto;
            padding-right: 2px;
            flex: 1 1 auto;
            min-height: 0;
            /* Firefox */
            scrollbar-width: thin;
            scrollbar-color: transparent transparent;
            transition: scrollbar-color 0.3s;
        }
        .chat-messages:hover,
        .chat-messages:focus-within {
            scrollbar-color: rgba(139,92,246,0.5) transparent;
        }
    
        /* Chrome / Edge 2*/
        .chat-messages::-webkit-scrollbar {
            width: 4px;
        }
        .chat-messages::-webkit-scrollbar-track {
            background: transparent;
        }
        .chat-messages::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 4px;
            transition: background 0.3s;
        }
        .chat-messages:hover::-webkit-scrollbar-thumb,
        .chat-messages:focus-within::-webkit-scrollbar-thumb {
            background: rgba(139,92,246,0.5);
        }
        .quick-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-height: 104px;
            overflow-y: auto;
            scrollbar-width: none; /* Firefox: ẩn hoàn toàn */
        }
        .quick-chips::-webkit-scrollbar {
            display: none; /* Chrome/Edge: ẩn hoàn toàn */
        }

        .chat-bubble {
            max-width: 84%;
            padding: 11px 14px;
            border-radius: 18px;
            line-height: 1.55;
            font-size: 0.88rem;
        }
        .chat-bubble.ai {
            align-self: flex-start;
            background: #ffffff;
            color: #333333;
            border: 1.5px solid #fce4f0;
            border-bottom-left-radius: 5px;
            box-shadow: 0 2px 8px rgba(255,100,180,0.08);
        }
        .chat-bubble.user {
            align-self: flex-end;
            background: linear-gradient(135deg, #ff6eb4, #ffadd6);
            color: #fff;
            border-bottom-right-radius: 5px;
            box-shadow: 0 4px 14px rgba(255,110,180,0.35);
        }
        .quick-chip {
            border: 1.5px solid #f0d0e8;
            background: #ffffff;
            border-radius: 999px;
            color: #cc4488;
            padding: 7px 14px;
            font-size: 0.79rem;
            cursor: pointer;
            transition: background 0.18s ease, transform 0.18s ease;
            white-space: nowrap;
        }
        .quick-chip:hover {
            background: #fff0f7;
            border-color: #ff9cd6;
            transform: translateY(-1px);
        }
        .chat-actions {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-top: auto;
        }
        .chat-input {
            flex: 1;
            min-height: 42px;
            border-radius: 999px;
            border: 1.5px solid #f0d0e8;
            background: #ffffff;
            color: #333;
            padding: 0 16px;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s ease;
        }
        .chat-input::placeholder {
            color: #c0a0b8;
        }
        .chat-input:focus {
            border-color: #ff9cd6;
        }
        .send-button {
            height: 42px;
            padding: 0 18px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #ff6eb4, #ffadd6);
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(255,110,180,0.35);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
            white-space: nowrap;
        }
        .send-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(255,110,180,0.45);
        }
        @@keyframes panelFadeIn {
            from { opacity: 0; transform: translateY(20px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        /* Loading dots animation */
        @@keyframes chatDotBounce {
            0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
            40%            { transform: translateY(-5px); opacity: 1; }
        }
        .chat-bubble.loading {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 14px 18px;
        }
        .chat-bubble.loading .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(200, 200, 255, 0.8);
            animation: chatDotBounce 1.2s infinite ease-in-out;
        }
        .chat-bubble.loading .dot:nth-child(2) { animation-delay: 0.2s; }
        .chat-bubble.loading .dot:nth-child(3) { animation-delay: 0.4s; }
        @@media (max-width: 600px) {
            #floatingChatLauncher {
                right: 16px;
                bottom: 16px;
            }
            #chatToggleButton {
                width: 54px;
                height: 54px;
            }
            #supportWidgetPanel {
                right: 12px;
                bottom: 16px;
                width: min(100vw - 24px, 100%);
                border-radius: 22px;
            }
            #supportWidgetHeader {
                padding: 16px 16px 12px;
            }
            #supportWidgetBody {
                padding: 16px;
            }
        }
    </style>
</head>
<body class="pandora-shell">
    <div id="pageLoading" class="page-loading" aria-label="Đang tải">
        <div class="page-loading__brand"><img src="~/images/logo/diamond-mark.png" alt="KimTon" /><span>KIMTON</span></div>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="globalAntiforgery" hidden>@Html.AntiForgeryToken()</form>
    }
    @{
        var activeBranches = await DbContext.Branches
            .Where(branch => branch.IsActive)
            .OrderBy(branch => branch.BranchName)
            .ToListAsync();
        var roles = User.Claims
            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
            .Select(c => c.Value)
            .ToList();
        var isStaffArea = RoleCatalog.IsPrivilegedPersistentRole(roles);
        var isSystemAdmin = roles.Contains("Admin");
        var signedInUser = User.Identity?.IsAuthenticated == true
            ? await DbContext.Users.FirstOrDefaultAsync(user => user.UserName == User.Identity.Name)
            : null;
        var managementBranches = isStaffArea
            ? await PermissionService.GetAccessibleBranchesAsync(User)
            : new List<GoldManagementSystem.Models.Branch>();
        var managementGrants = new Dictionary<int, HashSet<string>>();
        foreach (var branch in managementBranches)
        {
            managementGrants[branch.Id] = await PermissionService.GetGrantedKeysAsync(User, branch.Id);
        }
        var hasManagementAccess = isSystemAdmin || managementBranches.Any();
        var requestPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        var requestCategory = Context.Request.Query["category"].ToString();

        bool pathMatches(params string[] candidates) =>
            candidates.Any(candidate => string.Equals(requestPath, candidate.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase));

        bool categoryMatches(string category) =>
            string.Equals(requestCategory, category, StringComparison.OrdinalIgnoreCase) &&
            pathMatches("/products", "/products/index");

        string navClass(bool isActive) => isActive ? "is-active" : string.Empty;
        var isSupplierPurchaseOrdersPage =
            pathMatches("/admin/supplierpurchaseorders");
        var isDashboardPath = requestPath.StartsWith("/user/")
            || requestPath.StartsWith("/management")
            || requestPath.StartsWith("/admin/")
            || requestPath.StartsWith("/products/admin");
        var isManagementArea = requestPath.StartsWith("/management")
            || requestPath.StartsWith("/admin/")
            || requestPath.StartsWith("/products/admin");
        int? selectedBranchId = int.TryParse(Context.Request.Query["branchId"], out var branchIdValue)
            ? branchIdValue
            : null;
        var requestManagementTab = Context.Request.Query["tab"].ToString().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(requestManagementTab)) requestManagementTab = "overview";
        var selectedManagementBranch = managementBranches.FirstOrDefault(branch => branch.Id == selectedBranchId)
            ?? managementBranches.FirstOrDefault();
    }


    <header class="site-header">
        <div class="site-header__utility">
            <div class="site-header__container">
                <div class="site-header__utility-group site-header__utility-group--left">
                    <div class="site-header__utility-cluster">
                        <button class="header-icon header-icon--search show-desktop-flex"
                                type="button"
                                aria-label="Tìm kiếm"
                                data-toggle-search>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
                            </svg>
                            <span data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</span>
                        </button>
                    </div>

                    <button class="header-icon show-mobile-flex" type="button" aria-label="Mở menu" data-toggle-menu>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                </div>

                <div class="site-header__brand">
                    <a href="/" aria-label="KimTon">
                        <span class="site-header__logo-mark" aria-hidden="true">
                            <img src="~/images/logo/diamond-mark.png" alt="KimTon diamond logo" asp-append-version="true" />
                        </span>
                        <span class="site-header__logo-text">KIMTON</span>
                    </a>
                </div>

                <div class="site-header__actions">
                    <button class="header-icon show-mobile-flex" type="button" aria-label="Tìm kiếm" data-toggle-search>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
                        </svg>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/User/Favorites" class="header-icon show-desktop-flex" aria-label="Yêu thích">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.2-.9-.82C5.2 14.03 2 11.11 2 7.53 2 4.61 4.28 2.4 7.2 2.4c1.65 0 3.24.76 4.3 1.96A5.83 5.83 0 0 1 15.8 2.4C18.72 2.4 21 4.61 21 7.53c0 3.58-3.2 6.5-9.1 11.84l-.9.83Z" />
                            </svg>
                        </a>

                        <!-- Notification Bell Dropdown -->
                        <div class="notification-bell" id="notificationBellContainer">
                            <button type="button" class="header-icon" id="notificationBellTrigger" aria-label="Thông báo">
                                <svg class="notification-bell-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path class="notification-bell-icon__body" d="M12 4a4.5 4.5 0 0 0-4.5 4.5v3.15c0 1.68-.55 3.31-1.56 4.65l-.75.99a1 1 0 0 0 .8 1.61h12.02a1 1 0 0 0 .8-1.61l-.75-.99a7.75 7.75 0 0 1-1.56-4.65V8.5A4.5 4.5 0 0 0 12 4Z" />
                                    <path class="notification-bell-icon__body" d="M9.65 20.05h4.7a2.35 2.35 0 0 1-4.7 0Z" />
                                    <path class="notification-bell-icon__ring" d="M5.25 5.65A8.35 8.35 0 0 0 3.3 11.1M18.75 5.65a8.35 8.35 0 0 1 1.95 5.45" />
                                </svg>
                                <span class="header-badge" id="notificationBadge" style="display: none; background: #b42318;">0</span>
                            </button>
                            <div class="notification-dropdown" id="notificationDropdown">
                                <div class="notification-dropdown__header">
                                    <span data-i18n data-i18n-vi="Thông báo" data-i18n-en="Notifications">Thông báo</span>
                                    <button type="button" id="clearNotifications" data-i18n data-i18n-vi="Xóa tất cả" data-i18n-en="Clear all">Xóa tất cả</button>
                                </div>
                                <div class="notification-dropdown__list" id="notificationList">
                                    <div class="notification-dropdown__empty" data-i18n data-i18n-vi="Chưa có thông báo nào" data-i18n-en="No notifications yet">Chưa có thông báo nào</div>
                                </div>
                            </div>
                        </div>
                    }

                    <a href="@(User.Identity?.IsAuthenticated == true ? "/User/Orders" : "/Account/Login")"
                       class="header-icon"
                       aria-label="Giỏ hàng">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h2l2.5 10.4a1 1 0 0 0 1 .78h8.94a1 1 0 0 0 .97-.76L21 8H7" />
                            <circle cx="10" cy="20" r="1.6" />
                            <circle cx="18" cy="20" r="1.6" />
                        </svg>
                        <span class="header-badge">0</span>
                    </a>

                    <div class="account-menu">
                        <button class="header-icon account-menu__trigger" type="button" aria-label="Tài khoản">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                            </svg>
                        </button>
                        <div class="account-menu__panel">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="account-menu__welcome">
                        <span data-i18n data-i18n-vi="Xin chào" data-i18n-en="Hello">Xin chào</span>
                                    <strong>@User.Identity.Name</strong>
                                </div>
                                <a href="/User/Profile" data-i18n data-i18n-vi="Thông tin cá nhân" data-i18n-en="Profile">Thông tin cá nhân</a>
                                <a href="/User/Orders" data-i18n data-i18n-vi="Đơn hàng của tôi" data-i18n-en="My orders">Đơn hàng của tôi</a>
