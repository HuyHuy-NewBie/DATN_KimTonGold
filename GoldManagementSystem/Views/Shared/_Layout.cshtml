@using GoldManagementSystem.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KimTon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            var lang = localStorage.getItem("preferredLanguage") || "vi";
            document.documentElement.lang = lang;
            if (lang === "en") {
                document.documentElement.classList.add("lang-loading");
            }
        })();
    </script>
    <style>
        html.lang-loading [data-i18n], 
        html.lang-loading [data-auto-i18n],
        html.lang-loading .data-table td,
        html.lang-loading .status-chip,
        html.lang-loading option {
            opacity: 0 !important;
        }

        /* Notification Bell Styles */
        .notification-bell {
            position: relative;
            display: inline-block;
        }
        .notification-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            width: 330px;
            background: #fff;
            border: 1px solid rgba(39, 37, 31, 0.1);
            border-radius: 20px;
            box-shadow: 0 12px 36px rgba(17, 17, 17, 0.15);
            display: none;
            z-index: 1000;
            margin-top: 0.75rem;
            overflow: hidden;
        }
        .notification-dropdown.is-active {
            display: block;
        }
        .notification-dropdown__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.85rem 1.1rem;
            border-bottom: 1px solid rgba(39, 37, 31, 0.06);
            background: #fff8fa;
        }
        .notification-dropdown__header span {
            font-weight: 700;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--brand-ink, #111);
        }
        .notification-dropdown__header button {
            background: none;
            border: none;
            color: #cb3a6a;
            font-size: 0.74rem;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .notification-dropdown__list {
            max-height: 280px;
            overflow-y: auto;
        }
        .notification-item {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid rgba(39, 37, 31, 0.05);
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            text-decoration: none;
            color: #111;
            transition: background 0.2s ease;
        }
        .notification-item:hover {
            background: #fff8fa;
        }
        .notification-item.is-unread {
            background: #fff3f6;
        }
        .notification-item__title {
            font-weight: 700;
            font-size: 0.82rem;
            color: #111;
        }
        .notification-item__body {
            font-size: 0.78rem;
            color: var(--brand-muted, #555);
            line-height: 1.4;
        }
        .notification-item__time {
            font-size: 0.7rem;
            color: #999;
            align-self: flex-end;
            margin-top: 0.1rem;
        }
        .notification-dropdown__empty {
            padding: 2.5rem 1.1rem;
            text-align: center;
            color: #999;
            font-size: 0.82rem;
        }
        /* Toast notification at corner */
        .toast-notification {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #fff;
            border-left: 4px solid #ef7a9d;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            padding: 1rem 1.25rem;
            z-index: 9999;
            max-width: 320px;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .toast-notification.is-visible {
            transform: translateY(0);
            opacity: 1;
        }
        .toast-notification__title {
            font-weight: 700;
            font-size: 0.84rem;
            color: #ef7a9d;
        }
        .toast-notification__body {
            font-size: 0.8rem;
            color: #333;
            line-height: 1.4;
        }
    </style>
</head>
<body class="pandora-shell">
    @{
        var activeBranches = await DbContext.Branches
            .Where(branch => branch.IsActive)
            .OrderBy(branch => branch.BranchName)
            .ToListAsync();
        var roles = User.Claims
            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
            .Select(c => c.Value)
            .ToList();
        var isStaffArea = roles.Contains("Admin") || roles.Contains("Manager") || roles.Contains("Staff") || roles.Contains("Branch Owner");
        var requestPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        var requestCategory = Context.Request.Query["category"].ToString();

        bool pathMatches(params string[] candidates) =>
            candidates.Any(candidate => string.Equals(requestPath, candidate.ToLowerInvariant(), StringComparison.OrdinalIgnoreCase));

        bool categoryMatches(string category) =>
            string.Equals(requestCategory, category, StringComparison.OrdinalIgnoreCase) &&
            pathMatches("/products", "/products/index");

        string navClass(bool isActive) => isActive ? "is-active" : string.Empty;

        var isDashboardPath = requestPath.StartsWith("/user/")
            || requestPath.StartsWith("/admin/")
            || requestPath.StartsWith("/products/admin");
        int? selectedBranchId = int.TryParse(Context.Request.Query["branchId"], out var branchIdValue)
            ? branchIdValue
            : null;
    }


    <header class="site-header">
        <div class="site-header__utility">
            <div class="site-header__container">
                <div class="site-header__utility-group site-header__utility-group--left">
                    <div class="site-header__utility-cluster">
                        <form method="get" action="/Products" class="branch-switcher">
                            <label class="branch-switcher__label" for="headerBranchId" data-i18n data-i18n-vi="Chọn chi nhánh" data-i18n-en="Choose branch">Chọn chi nhánh</label>
                            <div class="branch-switcher__controls">
                                <select id="headerBranchId"
                                        name="branchId"
                                        class="branch-switcher__select"
                                        onchange="this.form.requestSubmit();">
                                    <option value="" data-i18n data-i18n-vi="Tất cả chi nhánh" data-i18n-en="All branches">Tất cả chi nhánh</option>
                                    @foreach (var branch in activeBranches)
                                    {
                                        if (selectedBranchId == branch.Id)
                                        {
                                            <option value="@branch.Id" selected>@branch.BranchName</option>
                                        }
                                        else
                                        {
                                            <option value="@branch.Id">@branch.BranchName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </form>

                        <button class="header-icon header-icon--search show-desktop-flex"
                                type="button"
                                aria-label="Tìm kiếm"
                                data-toggle-search>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
                            </svg>
                            <span data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</span>
                        </button>
                    </div>

                    <button class="header-icon show-mobile-flex" type="button" aria-label="Mở menu" data-toggle-menu>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                </div>

                <div class="site-header__brand">
                    <a href="/" aria-label="KimTon">
                        <span class="site-header__logo-mark" aria-hidden="true">
                            <img src="~/images/logo/diamond-mark.png" alt="KimTon diamond logo" asp-append-version="true" />
                        </span>
                        <span class="site-header__logo-text">KIMTON</span>
                    </a>
                </div>

                <div class="site-header__actions">
                    <button class="header-icon show-mobile-flex" type="button" aria-label="Tìm kiếm" data-toggle-search>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
                        </svg>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/User/Favorites" class="header-icon show-desktop-flex" aria-label="Yêu thích">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.2-.9-.82C5.2 14.03 2 11.11 2 7.53 2 4.61 4.28 2.4 7.2 2.4c1.65 0 3.24.76 4.3 1.96A5.83 5.83 0 0 1 15.8 2.4C18.72 2.4 21 4.61 21 7.53c0 3.58-3.2 6.5-9.1 11.84l-.9.83Z" />
                            </svg>
                        </a>

                        <!-- Notification Bell Dropdown -->
                        <div class="notification-bell" id="notificationBellContainer">
                            <button type="button" class="header-icon" id="notificationBellTrigger" aria-label="Thông báo">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9a6 6 0 00-6-9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                                </svg>
                                <span class="header-badge" id="notificationBadge" style="display: none; background: #b42318;">0</span>
                            </button>
                            <div class="notification-dropdown" id="notificationDropdown">
                                <div class="notification-dropdown__header">
                                    <span data-i18n data-i18n-vi="Thông báo" data-i18n-en="Notifications">Thông báo</span>
                                    <button type="button" id="clearNotifications" data-i18n data-i18n-vi="Xóa tất cả" data-i18n-en="Clear all">Xóa tất cả</button>
                                </div>
                                <div class="notification-dropdown__list" id="notificationList">
                                    <div class="notification-dropdown__empty" data-i18n data-i18n-vi="Chưa có thông báo nào" data-i18n-en="No notifications yet">Chưa có thông báo nào</div>
                                </div>
                            </div>
                        </div>
                    }

                    <a href="@(User.Identity?.IsAuthenticated == true ? "/User/Orders" : "/Account/Login")"
                       class="header-icon"
                       aria-label="Giỏ hàng">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h2l2.5 10.4a1 1 0 0 0 1 .78h8.94a1 1 0 0 0 .97-.76L21 8H7" />
                            <circle cx="10" cy="20" r="1.6" />
                            <circle cx="18" cy="20" r="1.6" />
                        </svg>
                        <span class="header-badge">0</span>
                    </a>

                    <button type="button"
                            class="language-toggle"
                            data-language-toggle
                            title="Chuyển đổi ngôn ngữ"
                            aria-label="Chuyển đổi ngôn ngữ">
                        <span class="language-toggle__option is-active" data-lang-code="vi">VI</span>
                        <span class="language-toggle__divider">/</span>
                        <span class="language-toggle__option" data-lang-code="en">EN</span>
                        <span class="language-toggle__tooltip" data-i18n data-i18n-vi="Chuyển đổi ngôn ngữ" data-i18n-en="Switch language">Chuyển đổi ngôn ngữ</span>
                    </button>
                    <div class="account-menu">
                        <button class="header-icon account-menu__trigger" type="button" aria-label="Tài khoản">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 1 0-16 0M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                            </svg>
                        </button>
                        <div class="account-menu__panel">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="account-menu__welcome">
                        <span data-i18n data-i18n-vi="Xin chào" data-i18n-en="Hello">Xin chào</span>
                                    <strong>@User.Identity.Name</strong>
                                </div>
                                <a href="/User/Profile" data-i18n data-i18n-vi="Thông tin cá nhân" data-i18n-en="Profile">Thông tin cá nhân</a>
                                <a href="/User/Orders" data-i18n data-i18n-vi="Đơn hàng của tôi" data-i18n-en="My orders">Đơn hàng của tôi</a>
                                <a href="/User/Favorites" data-i18n data-i18n-vi="Sản phẩm yêu thích" data-i18n-en="Favorites">Sản phẩm yêu thích</a>
                                @if (isStaffArea)
                                {
                                    <span class="account-menu__divider" data-i18n data-i18n-vi="Khu vực quản trị" data-i18n-en="Admin area">Khu vực quản trị</span>
                                    <a href="/Admin/Dashboard" data-i18n data-i18n-vi="Dashboard quản lý" data-i18n-en="Admin dashboard">Dashboard quản lý</a>
                                    <a href="/Products/AdminGold" data-i18n data-i18n-vi="Quản lý vàng" data-i18n-en="Manage gold products">Quản lý vàng</a>
                                    <a href="/Products/AdminSilver" data-i18n data-i18n-vi="Quản lý bạc" data-i18n-en="Manage silver products">Quản lý bạc</a>
                                    <a href="/Products/AdminDiamond" data-i18n data-i18n-vi="Quản lý kim cương" data-i18n-en="Manage diamond products">Quản lý kim cương</a>
                                    <a href="/Admin/BranchManagement" data-i18n data-i18n-vi="Quản lý chi nhánh" data-i18n-en="Manage branches">Quản lý chi nhánh</a>
                                    <a href="/Admin/OrderManagement" data-i18n data-i18n-vi="Quản lý đơn hàng" data-i18n-en="Manage orders">Quản lý đơn hàng</a>
                                    <a href="/Admin/UserManagement" data-i18n data-i18n-vi="Quản lý người dùng" data-i18n-en="Manage users">Quản lý người dùng</a>
                                }
                                <a href="/Account/Logout" class="account-menu__logout" data-i18n data-i18n-vi="Đăng xuất" data-i18n-en="Log out">Đăng xuất</a>
                            }
                            else
                            {
                                <div class="account-menu__welcome">
                                    <span data-i18n data-i18n-vi="Tài khoản thành viên" data-i18n-en="Member account">Tài khoản thành viên</span>
                                    <strong data-i18n data-i18n-vi="Tận hưởng ưu đãi riêng và theo dõi đơn hàng dễ dàng." data-i18n-en="Enjoy exclusive benefits and track your orders with ease.">Tận hưởng ưu đãi riêng và theo dõi đơn hàng dễ dàng.</strong>
                                </div>
                                <a href="/Account/Login" data-i18n data-i18n-vi="Đăng nhập" data-i18n-en="Log in">Đăng nhập</a>
                                <a href="/Account/Register" data-i18n data-i18n-vi="Đăng ký thành viên" data-i18n-en="Create account">Đăng ký thành viên</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="site-header__nav">
            <div class="site-header__container">
                <nav class="main-nav">
                    <a href="/" class="@navClass(pathMatches("/"))" data-i18n data-i18n-vi="Trang chủ" data-i18n-en="Home">Trang chủ</a>
                    <a href="/Products" class="@navClass(pathMatches("/products", "/products/index") && string.IsNullOrWhiteSpace(requestCategory))" data-i18n data-i18n-vi="Tất cả sản phẩm" data-i18n-en="All products">Tất cả sản phẩm</a>
                    <a href="/Home/Market" class="@navClass(pathMatches("/home/market"))" data-i18n data-i18n-vi="Thị trường" data-i18n-en="Market">Thị trường</a>
                    <a href="/Products/Gold" class="@navClass(pathMatches("/products/gold"))" data-i18n data-i18n-vi="Trang sức vàng" data-i18n-en="Gold jewelry">Trang sức vàng</a>
                    <a href="/Products/Silver" class="@navClass(pathMatches("/products/silver"))" data-i18n data-i18n-vi="Trang sức bạc" data-i18n-en="Silver jewelry">Trang sức bạc</a>
                    <a href="/Products/Diamond" class="@navClass(pathMatches("/products/diamond"))" data-i18n data-i18n-vi="Kim Cương" data-i18n-en="Diamonds">Kim Cương</a>
                    <a href="/Products?category=Nhẫn Cưới" class="@navClass(categoryMatches("Nhẫn Cưới"))" data-i18n data-i18n-vi="Nhẫn cưới" data-i18n-en="Wedding rings">Nhẫn cưới</a>
                    <a href="/Products?category=Dây Chuyền" class="@navClass(categoryMatches("Dây Chuyền"))" data-i18n data-i18n-vi="Dây chuyền" data-i18n-en="Necklaces">Dây chuyền</a>
                    <a href="/Products?category=Bông Tai" class="@navClass(categoryMatches("Bông Tai"))" data-i18n data-i18n-vi="Hoa tai" data-i18n-en="Earrings">Hoa tai</a>
                    <a href="/#gift-zone" data-i18n data-i18n-vi="Quà tặng" data-i18n-en="Gifts">Quà tặng</a>
                </nav>
            </div>
        </div>

        <div class="search-sheet" data-search-panel>
            <div class="search-sheet__backdrop" data-close-search></div>
            <div class="search-sheet__dialog">
                <button type="button" class="search-sheet__close" aria-label="Đóng tìm kiếm" data-close-search>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6 18 18M6 18 18 6" />
                    </svg>
                </button>
                <div class="search-sheet__content">
                    <div class="search-sheet__intro">
                        <p class="search-sheet__eyebrow" data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</p>
                        <h2 data-i18n data-i18n-vi="Khám phá món trang sức dành riêng cho bạn" data-i18n-en="Discover jewelry selected just for you">Khám phá món trang sức dành riêng cho bạn</h2>
                    </div>
                    <form method="get" action="/Products" class="search-sheet__form">
                        <label class="search-sheet__field">
                            <span class="search-sheet__field-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
                                </svg>
                            </span>
                            <input type="text"
                                   name="searchString"
                                   placeholder="Bạn cần tìm gì?"
                                   data-i18n
                                   data-i18n-attr="placeholder"
                                   data-i18n-vi="Bạn cần tìm gì?"
                                   data-i18n-en="What are you looking for?" />
                        </label>
                        <button type="submit" data-i18n data-i18n-vi="Tìm kiếm" data-i18n-en="Search">Tìm kiếm</button>
                    </form>
                    <div class="search-sheet__columns">
                        <div>
                            <p class="search-sheet__eyebrow" data-i18n data-i18n-vi="Được tìm kiếm nhiều" data-i18n-en="Trending searches">Được tìm kiếm nhiều</p>
                            <div class="search-sheet__suggestions">
                                <a href="/Products?searchString=hoa tai" data-i18n data-i18n-vi="hoa tai" data-i18n-en="earrings">hoa tai</a>
                                <a href="/Products?searchString=vòng charm" data-i18n data-i18n-vi="vòng charm" data-i18n-en="charm bracelet">vòng charm</a>
                                <a href="/Products?searchString=vòng tay bạc" data-i18n data-i18n-vi="vòng tay bạc" data-i18n-en="silver bracelet">vòng tay bạc</a>
                                <a href="/Products?searchString=lắc tay" data-i18n data-i18n-vi="lắc tay" data-i18n-en="bangle">lắc tay</a>
                                <a href="/Products?searchString=quà tặng" data-i18n data-i18n-vi="quà tặng" data-i18n-en="gift ideas">quà tặng</a>
                            </div>
                        </div>
                        <div>
                            <p class="search-sheet__eyebrow" data-i18n data-i18n-vi="Gợi ý bộ sưu tập" data-i18n-en="Collection picks">Gợi ý bộ sưu tập</p>
                            <div class="search-sheet__suggestions">
                                <a href="/Products/Gold" data-i18n data-i18n-vi="Trang sức vàng" data-i18n-en="Gold jewelry">Trang sức vàng</a>
                                <a href="/Products/Silver" data-i18n data-i18n-vi="Trang sức bạc" data-i18n-en="Silver jewelry">Trang sức bạc</a>
                                <a href="/Products/Diamond" data-i18n data-i18n-vi="Kim cương" data-i18n-en="Diamonds">Kim cương</a>
                                <a href="/Products?category=Nhẫn Cưới" data-i18n data-i18n-vi="Nhẫn cưới" data-i18n-en="Wedding rings">Nhẫn cưới</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mobile-menu" data-menu-panel>
            <div class="mobile-menu__backdrop" data-close-menu></div>
            <div class="mobile-menu__drawer">
                <div class="mobile-menu__head">
                    <span data-i18n data-i18n-vi="Khám phá" data-i18n-en="Explore">Khám phá</span>
                    <button type="button" aria-label="Đóng menu" data-close-menu>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6 18 18M6 18 18 6" />
                        </svg>
                    </button>
                </div>

                <nav class="mobile-menu__nav">
                    <a href="/" class="@navClass(pathMatches("/"))" data-i18n data-i18n-vi="Trang chủ" data-i18n-en="Home">Trang chủ</a>
