    <main class="site-main">
        @if (isDashboardPath && User.Identity?.IsAuthenticated == true)
        {
            <div class="dashboard-shell">
                <aside class="dashboard-sidebar">
                    @if (!isManagementArea)
                    {
                        <div class="dashboard-sidebar__group">
                            <span class="dashboard-sidebar__label" data-i18n data-i18n-vi="Tài khoản của tôi" data-i18n-en="My account">Tài khoản của tôi</span>
                            <nav class="dashboard-sidebar__nav">
                                <a href="/User/Profile" class="dashboard-sidebar__link @navClass(pathMatches("/user/profile"))" data-i18n data-i18n-vi="Thông tin cá nhân" data-i18n-en="Profile">Thông tin cá nhân</a>
                                <a href="/User/Orders" class="dashboard-sidebar__link @navClass(pathMatches("/user/orders"))" data-i18n data-i18n-vi="Đơn hàng của tôi" data-i18n-en="My orders">Đơn hàng của tôi</a>
                                <a href="/User/Favorites" class="dashboard-sidebar__link @navClass(pathMatches("/user/favorites"))" data-i18n data-i18n-vi="Sản phẩm yêu thích" data-i18n-en="Favorites">Sản phẩm yêu thích</a>
                            </nav>
                        </div>
                    }

                    @if (hasManagementAccess && isManagementArea)
                    {
                        <div class="dashboard-sidebar__group">
                            <span class="dashboard-sidebar__label">Khu vực quản lí</span>
                            <nav class="dashboard-sidebar__nav" data-management-tree>
                                <a href="/Management?tab=overview&branchId=@selectedManagementBranch?.Id" class="dashboard-sidebar__link" data-dashboard-link>Tổng quan</a>
                                @foreach (var branch in managementBranches)
                                {
                                    var branchGrants = managementGrants[branch.Id];

                                    var canManageSuppliers =
                                        branchGrants.Contains(
                                            ManagementFeatureCatalog.WarehouseSuppliers);

                                    var hasWarehouse =
                                        branchGrants.Overlaps(new[]
                                        {
                                            ManagementFeatureCatalog.WarehouseReceipts,
                                            ManagementFeatureCatalog.WarehouseApproval
                                        });

                                    var hasPeople =
                                        branchGrants.Overlaps(new[]
                                        {
                                            ManagementFeatureCatalog.PeopleView,
                                            ManagementFeatureCatalog.PeopleShifts,
                                            ManagementFeatureCatalog.PeoplePayroll
                                        });
                                    var hasProducts = branchGrants.Overlaps(new[] { ManagementFeatureCatalog.ProductsView, ManagementFeatureCatalog.ProductsEdit });
                                    var isActiveManagementBranch = selectedManagementBranch?.Id == branch.Id;
                                    var isWarehousePurchasingPage =
                                        pathMatches("/admin/warehousemanagement");

                                    var isInventoryManagementPage =
                                        pathMatches("/admin/inventorymanagement");

                                    var isInventoryIssuePage =
                                        pathMatches("/admin/inventoryissues");

                                    var isInventoryHistoryPage =
                                        pathMatches("/admin/inventoryhistory");
                                    <details class="management-menu @(isActiveManagementBranch ? "management-menu--active" : string.Empty)" @(isActiveManagementBranch ? "open" : null)>
                                        <summary>@branch.BranchName</summary>
                                        
                                        @if (canManageSuppliers)
                                        {
                                            <a class="@(pathMatches("/admin/suppliermanagement")
                                                        && isActiveManagementBranch
                                                            ? "is-active"
                                                            : string.Empty)"
                                            href="/Admin/SupplierManagement?branchId=@branch.Id">
                                                Quản lí nhà cung cấp
                                            </a>
                                        }

                                        @if (hasWarehouse)
                                        {
                                            <details class="management-menu__nested"
                                                    @(
                                                        isActiveManagementBranch
                                                        && (
                                                            requestManagementTab == "warehouse"
                                                            || isWarehousePurchasingPage
                                                            || isSupplierPurchaseOrdersPage
                                                            || isInventoryManagementPage
                                                            || isInventoryIssuePage
                                                            || isInventoryHistoryPage
                                                        )
                                                            ? "open"
                                                            : null
                                                    )>

                                                <summary>Quản lí kho</summary>

                                                @if (branchGrants.Contains(
                                                    ManagementFeatureCatalog.WarehouseReceipts))
                                                {
                                                    <a class="@(
                                                            isSupplierPurchaseOrdersPage
                                                            && isActiveManagementBranch
                                                                ? "is-active"
                                                                : string.Empty)"
                                                        href="/Admin/SupplierPurchaseOrders?branchId=@branch.Id">
                                                        Đặt hàng từ nhà cung cấp
                                                    </a>

                                                    <a class="@(
                                                            isWarehousePurchasingPage
                                                            && isActiveManagementBranch
                                                                ? "is-active"
                                                                : string.Empty)"
                                                        href="/Admin/WarehouseManagement?branchId=@branch.Id&warehouseTab=orders">
                                                        Phiếu nhập kho
                                                    </a>

                                                    <a class="@(
                                                            isInventoryIssuePage
                                                            && isActiveManagementBranch
                                                                ? "is-active"
                                                                : string.Empty)"
                                                    href="/Admin/InventoryIssues?branchId=@branch.Id">
                                                        Phiếu xuất kho
                                                    </a>

                                                    <a class="@(
                                                            isInventoryManagementPage
                                                            && isActiveManagementBranch
                                                                ? "is-active"
                                                                : string.Empty)"
                                                    href="/Admin/InventoryManagement?branchId=@branch.Id">
                                                        Danh sách tồn kho
                                                    </a>

                                                    <span>
                                                        Kiểm kê kho · đang phát triển
                                                    </span>

                                                    <a class="@(
                                                            isInventoryHistoryPage
                                                            && isActiveManagementBranch
                                                                ? "is-active"
                                                                : string.Empty)"
                                                    href="/Admin/InventoryHistory?branchId=@branch.Id">
                                                        Lịch sử nhập - xuất
                                                    </a>
                                                }

                                                @if (branchGrants.Contains(
                                                    ManagementFeatureCatalog.WarehouseApproval))
                                                {
                                                    @*
                                                        Sau này khi tách quyền duyệt riêng,
                                                        có thể đặt menu duyệt phiếu tại đây.
                                                    *@
                                                }
                                            </details>
                                        }
                                        @if (hasPeople)
                                        {
                                            <a class="@(requestManagementTab == "people" && isActiveManagementBranch ? "is-active" : string.Empty)" href="/Management?tab=people&branchId=@branch.Id" data-dashboard-link data-management-branch-name="@branch.BranchName">Quản lí nhân sự</a>
                                        }
                                        @if (hasProducts)
                                        {
                                            <a class="@(requestManagementTab == "products" && isActiveManagementBranch ? "is-active" : string.Empty)" href="/Management?tab=products&branchId=@branch.Id" data-dashboard-link data-management-branch-name="@branch.BranchName">Quản lí sản phẩm</a>
                                        }
                                        @if (branchGrants.Contains(ManagementFeatureCatalog.RevenueView))
                                        {
                                            <a class="@(requestManagementTab == "revenue" && isActiveManagementBranch ? "is-active" : string.Empty)" href="/Management?tab=revenue&branchId=@branch.Id" data-dashboard-link data-management-branch-name="@branch.BranchName">Doanh thu</a>
                                        }
                                    </details>
                                }
                                @if (isSystemAdmin)
                                {
                                    <details class="management-menu management-menu--system" @(requestManagementTab is "users" or "permissions" or "branches" or "audit" ? "open" : null)>
                                        <summary>Hệ thống</summary>
                                        <details class="management-menu__nested" @(requestManagementTab is "users" or "permissions" ? "open" : null)>
                                            <summary>User</summary>
                                            <a class="@(requestManagementTab == "users" ? "is-active" : string.Empty)" href="/Management?tab=users" data-dashboard-link data-management-system-link>Người dùng</a>
                                            <a class="@(requestManagementTab == "permissions" ? "is-active" : string.Empty)" href="/Management?tab=permissions" data-dashboard-link data-management-system-link>Phân quyền</a>
                                        </details>
                                        <a class="@(requestManagementTab == "branches" ? "is-active" : string.Empty)" href="/Management?tab=branches" data-dashboard-link data-management-system-link>Chi nhánh</a>
                                        <a class="@(requestManagementTab == "audit" ? "is-active" : string.Empty)" href="/Management?tab=audit" data-dashboard-link data-management-system-link>Lịch sử</a>
                                    </details>
                                }
                            </nav>
                        </div>
                    }

                    <div class="dashboard-sidebar__group">
                        <nav class="dashboard-sidebar__nav">
                            <a href="/Account/Logout" class="dashboard-sidebar__link dashboard-sidebar__link--logout" data-i18n data-i18n-vi="Đăng xuất" data-i18n-en="Log out">Đăng xuất</a>
                        </nav>
                    </div>
                </aside>

                <div class="dashboard-content">
                    @RenderBody()
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="site-footer">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="site-footer__newsletter">
                <div class="site-footer__container site-footer__newsletter-wrap">
                    <div>
                        <p class="site-footer__label" data-i18n data-i18n-vi="Nhận ưu đãi 10% cho khách hàng mới" data-i18n-en="Get 10% off for new customers">Nhận ưu đãi 10% cho khách hàng mới</p>
                        <h2 data-i18n data-i18n-vi="Gia nhập KimTon để nhận khuyến mãi và bộ sưu tập mới sớm nhất." data-i18n-en="Join KimTon to receive promotions and preview new collections first.">Gia nhập KimTon để nhận khuyến mãi và bộ sưu tập mới sớm nhất.</h2>
                    </div>
                    <a href="/Account/Register" class="site-footer__cta" data-i18n data-i18n-vi="Đăng ký ngay" data-i18n-en="Sign up now">Đăng ký ngay</a>
                </div>
            </div>
        }

        <div class="site-footer__content">
            <div class="site-footer__container site-footer__grid">
                <div>
                    <a href="/" class="site-footer__brand">KIMTON</a>
                    <p class="site-footer__text" data-i18n data-i18n-vi="Trang sức được tuyển chọn để lưu giữ khoảnh khắc, tôn vinh dấu ấn cá nhân và những mối gắn kết đặc biệt." data-i18n-en="Curated jewelry designed to preserve memories, celebrate individuality, and honor meaningful connections.">Trang sức được tuyển chọn để lưu giữ khoảnh khắc, tôn vinh dấu ấn cá nhân và những mối gắn kết đặc biệt.</p>
                    <div class="site-footer__social">
                        <a href="javascript:void(0)" aria-label="Facebook">
