@model IReadOnlyList<GoldManagementSystem.Models.GoldBarSerial>
@using GoldManagementSystem.Models
@{ ViewData["Title"] = "Vàng miếng - Tuân thủ"; var locations = ViewBag.Locations as IEnumerable<BusinessLocation> ?? Array.Empty<BusinessLocation>(); var branches = ViewBag.Branches as IEnumerable<Branch> ?? Array.Empty<Branch>(); var products = ViewBag.GoldBarProducts as IEnumerable<Product> ?? Array.Empty<Product>(); }
<div class="dashboard-card admin-panel">
    <section class="admin-hero"><p class="admin-hero__eyebrow">P2 · Tuân thủ</p><h1>Vàng miếng</h1><p class="admin-hero__text">Quản lý địa điểm, giấy phép, serial và dữ liệu KYC lưu tối thiểu 10 năm.</p></section>
    <div class="admin-panel__body">
        <div class="admin-filter-grid">
            <form asp-action="CreateLocation" method="post" class="admin-field"><strong>Thêm địa điểm</strong><select name="BranchId" required><option value="">Chi nhánh</option>@foreach (var branch in branches) { <option value="@branch.Id">@branch.BranchName</option> }</select><input name="Code" placeholder="Mã địa điểm" required /><input name="Name" placeholder="Tên địa điểm" required /><input name="Address" placeholder="Địa chỉ" required /><button class="admin-button admin-button--primary">Lưu địa điểm</button></form>
            <form asp-action="AddLicense" method="post" class="admin-field"><strong>Thêm giấy phép</strong><select name="BusinessLocationId" required><option value="">Địa điểm</option>@foreach (var location in locations) { <option value="@location.Id">@location.Name</option> }</select><input name="Number" placeholder="Số giấy phép" required /><input name="ValidFrom" type="date" required /><input name="ValidTo" type="date" /><button class="admin-button admin-button--primary">Lưu chờ xác minh</button></form>
            <form asp-action="AddSerial" method="post" class="admin-field"><strong>Nhập serial vàng miếng</strong><select name="ProductId" required><option value="">Sản phẩm</option>@foreach (var product in products) { <option value="@product.Id">@product.Name</option> }</select><select name="BusinessLocationId" required><option value="">Địa điểm</option>@foreach (var location in locations) { <option value="@location.Id">@location.Name</option> }</select><input name="SerialNumber" placeholder="Serial" required /><input name="PurityCode" placeholder="Mã hàm lượng" required /><input name="GrossWeight" type="number" step="0.0001" min="0.0001" placeholder="Khối lượng tổng" required /><input name="FineWeight" type="number" step="0.0001" min="0.0001" placeholder="Khối lượng tinh" required /><button class="admin-button admin-button--primary">Lưu serial</button></form>
        </div>
        <h2>Địa điểm và giấy phép</h2>
        @foreach (var location in locations) { <div class="admin-section"><strong>@location.Name</strong> · @location.Branch?.BranchName · @location.Address @foreach (var license in location.Licenses) { <span class="status-chip">@license.Number · @(license.IsVerified ? "Đã xác minh" : "Chờ xác minh")</span>@if (!license.IsVerified) { <form asp-action="VerifyLicense" method="post" style="display:inline"><input type="hidden" name="id" value="@license.Id" /><button class="admin-button admin-button--secondary">Xác minh</button></form> } }</div> }
        <h2>Serial gần đây</h2><table class="data-table"><thead><tr><th>Serial</th><th>Sản phẩm</th><th>Địa điểm</th><th>Khối lượng tinh</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var serial in Model) { <tr><td>@serial.SerialNumber</td><td>@serial.Product?.Name</td><td>@serial.BusinessLocation?.Name</td><td>@serial.FineWeight.ToString("N4")</td><td>@serial.Status</td></tr> }</tbody></table>
        <p><a class="admin-button admin-button--secondary" asp-action="NhnnReport">Xuất báo cáo giao dịch NHNN</a></p>
    </div>
</div>
