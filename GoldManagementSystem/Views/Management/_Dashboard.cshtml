        </style>

        <script>
            var cskhCurrentTab = 'waiting';
            var cskhActiveSessionCode = null;
            var cskhActiveSessionId = null;
            var cskhHubConnection = null;
            var cskhPollingTimer = null;

            // ===== Khởi động ngay (không cần DOMContentLoaded) =====
            (function cskhInit() {
                // Load danh sách ngay khi trang mở, tự chọn session đầu tiên
                cskhLoadSessions(function(sessions) {
                    if (sessions && sessions.length > 0) {
                        cskhSelectSession(sessions[0].sessionCode, sessions[0].id, sessions[0].customerName, sessions[0].status);
                    }
                });

                // Polling 3 giây: đảm bảo luôn thấy tin nhắn dù SignalR có lỗi
                cskhPollingTimer = setInterval(function() {
                    cskhLoadSessions(function(sessions) {
                        if (cskhActiveSessionCode) {
                            cskhRefreshMessages();
                        } else if (sessions && sessions.length > 0) {
                            cskhSelectSession(sessions[0].sessionCode, sessions[0].id, sessions[0].customerName, sessions[0].status);
                        }
                    });
                }, 3000);

                // Setup SignalR cho realtime tức thì (polling là backup)
                function trySetupSignalR() {
                    if (typeof signalR === 'undefined') { setTimeout(trySetupSignalR, 300); return; }
                    try {
                        cskhHubConnection = new signalR.HubConnectionBuilder()
                            .withUrl('/supportChatHub').withAutomaticReconnect().build();

                        cskhHubConnection.on('NewWaitingSession', function() {
                            cskhCurrentTab = 'waiting';
                            var el = document.getElementById('cskhTabWaiting');
                            var el2 = document.getElementById('cskhTabMy');
                            if (el) el.classList.add('is-active');
                            if (el2) el2.classList.remove('is-active');
                            cskhLoadSessions(function(sessions) {
                                if (!cskhActiveSessionCode && sessions && sessions.length > 0)
                                    cskhSelectSession(sessions[0].sessionCode, sessions[0].id, sessions[0].customerName, sessions[0].status);
                            });
                        });
                        cskhHubConnection.on('StaffSessionUpdated', function(data) {
                            cskhLoadSessions(function(sessions) {
                                if (cskhActiveSessionCode && data.sessionCode === cskhActiveSessionCode) {
                                    cskhRefreshMessages();
                                } else if (!cskhActiveSessionCode && sessions && sessions.length > 0) {
                                    cskhSelectSession(sessions[0].sessionCode, sessions[0].id, sessions[0].customerName, sessions[0].status);
                                }
                            });
                        });
                        cskhHubConnection.on('ReceiveMessage', function(msg) {
                            if (cskhActiveSessionCode && msg.sessionCode === cskhActiveSessionCode)
                                cskhAppendMessage(msg);
                            cskhLoadSessions(null);
                        });
                        cskhHubConnection.on('SessionStatusChanged', function() { cskhLoadSessions(null); });
                        cskhHubConnection.start().then(function() {
                            cskhHubConnection.invoke('JoinStaffGroup').catch(function(){});
                        }).catch(function(e) { console.warn('SignalR CSKH admin:', e); });
                    } catch(e) { console.warn('SignalR init error:', e); }
                }
                trySetupSignalR();
            })();



            function cskhSwitchTab(tab) {
                cskhCurrentTab = tab;
                document.getElementById('cskhTabWaiting').classList.toggle('is-active', tab === 'waiting');
                document.getElementById('cskhTabMy').classList.toggle('is-active', tab === 'my');
                cskhLoadSessions(null);
            }

            function cskhLoadSessions(callback) {
                return fetch('/api/customercare/admin/sessions?type=' + cskhCurrentTab)
                    .then(res => {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(data => {
                        if (!data.success) {
                            console.warn('[CSKH] API success=false');
                            if (callback) callback([]);
                            return;
                        }
                        var badgeW = document.getElementById('cskhWaitingBadge');
                        var badgeM = document.getElementById('cskhMyBadge');
                        if (badgeW) badgeW.textContent = data.waitingCount || 0;
                        if (badgeM) badgeM.textContent = data.myCount || 0;

                        var listContainer = document.getElementById('cskhSessionList');
                        if (!listContainer) { if (callback) callback([]); return; }

                        if (!data.sessions || data.sessions.length === 0) {
                            listContainer.innerHTML = '<div class="cskh-empty-list" style="padding: 20px; text-align: center; color: #999; font-size: 0.88rem;">Không có cuộc trò chuyện nào</div>';
                            if (callback) callback([]);
                            return;
                        }

                        var html = '';
                        data.sessions.forEach(function(s) {
                            var initial = (s.customerName || 'K').charAt(0).toUpperCase();
                            var isSelected = (cskhActiveSessionCode === s.sessionCode) ? 'is-selected' : '';
                            html += '<div class="cskh-session-item ' + isSelected + '" onclick="cskhSelectSession(\'' + s.sessionCode + '\', ' + s.id + ', \'' + escapeJsString(s.customerName) + '\', \'' + s.status + '\')">';
                            html += '  <div class="cskh-avatar-circle">' + initial + '</div>';
                            html += '  <div class="cskh-session-info">';
                            html += '    <h4 class="cskh-session-name">' + (s.customerEmail || s.customerName) + '</h4>';
                            html += '    <p class="cskh-session-msg">' + (s.lastMessage || 'Vừa bắt đầu phiên chat') + '</p>';
                            html += '  </div>';
                            html += '  <div class="cskh-session-meta">';
                            html += '    <span class="cskh-session-time">' + s.updatedAtTime + '</span>';
                            if (s.unreadByStaff > 0) {
                                html += '    <span class="cskh-unread-badge">' + s.unreadByStaff + '</span>';
                            }
                            html += '  </div>';
                            html += '</div>';
                        });
                        listContainer.innerHTML = html;
                        cskhFilterSessions();
                        if (callback) callback(data.sessions);
                    })
                    .catch(function(err) {
                        console.error('[CSKH] cskhLoadSessions error:', err);
                        var listContainer = document.getElementById('cskhSessionList');
                        if (listContainer && (!listContainer.children || listContainer.children.length === 0 || listContainer.querySelector('.cskh-empty-list'))) {
                            listContainer.innerHTML = '<div class="cskh-empty-list" style="padding: 20px; text-align: center; color: #d32f2f; font-size: 0.88rem;">Khung trò chuyện trống hoặc lỗi kết nối.</div>';
                        }
                        if (callback) callback([]);
                    });
            }

            function cskhFilterSessions() {
                var query = (document.getElementById('cskhSearchInput')?.value || '').toLowerCase().trim();
                var items = document.querySelectorAll('#cskhSessionList .cskh-session-item');
                items.forEach(function(item) {
                    var text = item.textContent.toLowerCase();
                    item.style.display = text.indexOf(query) !== -1 ? 'flex' : 'none';
                });
            }

            function escapeJsString(str) {
                return (str || '').replace(/'/g, "\\'");
            }

            function cskhSelectSession(code, id, name, status) {
                // Rời session group cũ nếu có
                if (cskhHubConnection && cskhActiveSessionCode && cskhActiveSessionCode !== code) {
                    cskhHubConnection.invoke("LeaveSessionGroup", cskhActiveSessionCode).catch(function() {});
                }

                cskhActiveSessionCode = code;
                cskhActiveSessionId = id;

                // Tham gia session group để nhận tin nhắn real-time
                if (cskhHubConnection) {
                    cskhHubConnection.invoke("JoinSessionGroup", code).catch(function(err) { console.error(err); });
                }

                document.getElementById('cskhEmptyState').style.display = 'none';
                document.getElementById('cskhActiveChat').style.display = 'flex';
                document.getElementById('chatHeaderAvatar').textContent = (name || 'K').charAt(0).toUpperCase();
                document.getElementById('chatHeaderName').textContent = name || 'Khách hàng';
                document.getElementById('chatHeaderSub').textContent = 'Mã phiên: ' + code;

                var btnAccept = document.getElementById('btnAcceptSession');
                var btnClose = document.getElementById('btnCloseSession');
                if (status === 'Waiting') {
                    btnAccept.style.display = 'inline-block';
                    btnClose.style.display = 'none';
                } else {
                    btnAccept.style.display = 'none';
                    btnClose.style.display = 'inline-block';
                }

                cskhLoadMessages(code);
            }

            function cskhLoadMessages(code) {
                fetch('/api/customercare/session/' + code + '/messages')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) return;
                        var msgContainer = document.getElementById('cskhChatMessages');
                        msgContainer.innerHTML = '';
                        data.messages.forEach(function(m) {
                            cskhAppendMessage(m);
                        });
                        msgContainer.scrollTop = msgContainer.scrollHeight;
                    });
            }

            // Refresh tin nhắn không làm mất vị trí scroll (dùng cho polling)
            function cskhRefreshMessages() {
                if (!cskhActiveSessionCode) return;
                fetch('/api/customercare/session/' + cskhActiveSessionCode + '/messages')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) return;
                        var msgContainer = document.getElementById('cskhChatMessages');
                        var currentCount = msgContainer.querySelectorAll('.cskh-msg-bubble').length;
                        if (data.messages.length > currentCount) {
                            msgContainer.innerHTML = '';
                            data.messages.forEach(function(m) { cskhAppendMessage(m); });
                            msgContainer.scrollTop = msgContainer.scrollHeight;
                        }
                    });
            }

            function cskhAppendMessage(m) {
                var msgContainer = document.getElementById('cskhChatMessages');
                if (!msgContainer) return;
                if (m.id && msgContainer.querySelector('[data-msg-id="' + m.id + '"]')) return;

                var div = document.createElement('div');
                if (m.id) div.setAttribute('data-msg-id', m.id);
                var roleClass = m.senderRole === 'Customer' ? 'customer' : (m.senderRole === 'Staff' ? 'staff' : 'system');
                div.className = 'cskh-msg-bubble ' + roleClass;
                div.innerHTML = '<div>' + escapeHtml(m.message) + '</div><div class="cskh-msg-meta">' + escapeHtml(m.senderName) + ' • ' + escapeHtml(m.createdAt) + '</div>';
                msgContainer.appendChild(div);
                msgContainer.scrollTop = msgContainer.scrollHeight;
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            function cskhSendStaffMessage() {
                var input = document.getElementById('cskhMessageInput');
                var msg = input.value.trim();
                if (!msg || !cskhActiveSessionCode) return;

                input.value = '';
                fetch('/api/customercare/admin/send-message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId: cskhActiveSessionId, sessionCode: cskhActiveSessionCode, message: msg })
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        cskhAppendMessage(data.data);
                    }
                });
            }

            function cskhAcceptCurrentSession() {
                if (!cskhActiveSessionCode) return;
                fetch('/api/customercare/admin/accept-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId: cskhActiveSessionId, sessionCode: cskhActiveSessionCode })
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        document.getElementById('btnAcceptSession').style.display = 'none';
                        document.getElementById('btnCloseSession').style.display = 'inline-block';
                        cskhSwitchTab('my');
                    }
                });
            }

            function cskhCloseCurrentSession() {
                if (!cskhActiveSessionCode) return;
                if (!confirm('Bạn có chắc chắn muốn kết thúc cuộc trò chuyện này?')) return;
                fetch('/api/customercare/admin/close-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId: cskhActiveSessionId, sessionCode: cskhActiveSessionCode })
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        document.getElementById('cskhActiveChat').style.display = 'none';
                        document.getElementById('cskhEmptyState').style.display = 'flex';
                        cskhActiveSessionCode = null;
                        cskhSwitchTab('waiting');
                    }
                });
            }
        </script>
    }
    else if (Model.Tab == "feedback")
    {
        <article class="management-card management-card--wide" style="margin-top: 15px;">
            <div class="management-section-heading">
                <div>
                    <p>CHĂM SÓC KHÁCH HÀNG</p>
                    <h2>Feedback & Đánh giá của khách hàng</h2>
                </div>
                <div class="cskh-feedback-summary" style="display: flex; gap: 14px; font-size: 0.92rem; background: #fff5f8; padding: 10px 18px; border-radius: 12px; border: 1px solid #f8bbd0;">
                    <span>Tổng: <strong id="fbTotal" style="color: #333;">0</strong></span> |
                    <span>Chờ xử lý: <strong id="fbPending" style="color: #e91e63;">0</strong></span> |
                    <span>Đã xử lý: <strong id="fbProcessed" style="color: #2e7d32;">0</strong></span> |
                    <span>Điểm TB: <strong id="fbAvg" style="color: #ff9800;">5.0 ⭐</strong></span>
                </div>
            </div>

            <div class="feedback-filter-bar" style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; align-items: center;">
                <div style="flex: 1; min-width: 220px; position: relative;">
                    <input type="text" id="fbSearchInput" oninput="loadAdminFeedbacks()" placeholder="🔍 Tìm theo tên khách, SĐT, Email hoặc nội dung..." style="width: 100%; padding: 9px 14px; border-radius: 10px; border: 1px solid #ddd; outline: none; font-size: 0.88rem;" />
                </div>
                <select id="fbRatingFilter" onchange="loadAdminFeedbacks()" style="padding: 9px 14px; border-radius: 10px; border: 1px solid #ddd; font-size: 0.88rem; outline: none;">
                    <option value="">Tất cả số sao ⭐</option>
                    <option value="5">5 Sao ⭐⭐⭐⭐⭐</option>
                    <option value="4">4 Sao ⭐⭐⭐⭐</option>
                    <option value="3">3 Sao ⭐⭐⭐</option>
                    <option value="2">2 Sao ⭐⭐</option>
                    <option value="1">1 Sao ⭐</option>
                </select>
                <select id="fbStatusFilter" onchange="loadAdminFeedbacks()" style="padding: 9px 14px; border-radius: 10px; border: 1px solid #ddd; font-size: 0.88rem; outline: none;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Chờ xử lý">Chờ xử lý</option>
                    <option value="Đã xử lý">Đã xử lý</option>
                </select>
            </div>

            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Đánh giá ⭐</th>
                            <th>Danh mục</th>
                            <th>Sản phẩm</th>
                            <th>Nội dung nhận xét</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="fbTableBody">
                        <tr><td colspan="8" style="text-align: center; padding: 20px;">Đang tải danh sách đánh giá...</td></tr>
                    </tbody>
                </table>
            </div>
        </article>

        <!-- Modal Phản hồi Feedback -->
        <div id="fbReplyModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
            <div style="background: #fff; border-radius: 18px; width: 480px; max-width: 90%; padding: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
                <h3 style="margin-top: 0; font-size: 1.15rem; font-weight: 800; color: #880e4f;">💬 Phản hồi đánh giá khách hàng</h3>
                <input type="hidden" id="fbReplyId" />
                <p id="fbReplyCustomer" style="font-size: 0.9rem; color: #555; margin-bottom: 12px;"></p>
                <textarea id="fbReplyContent" rows="4" style="width: 100%; border: 1px solid #ccc; border-radius: 12px; padding: 12px; font-size: 0.9rem; outline: none;" placeholder="Nhập câu trả lời phản hồi cho khách hàng..."></textarea>
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px;">
                    <button type="button" onclick="closeFbModal()" style="padding: 8px 18px; border-radius: 10px; border: 1px solid #ccc; background: #fff; cursor: pointer;">Hủy</button>
                    <button type="button" onclick="submitFbReply()" style="padding: 8px 20px; border-radius: 10px; border: none; background: #d81b60; color: #fff; font-weight: 700; cursor: pointer;">Lưu phản hồi</button>
                </div>
            </div>
        </div>

        <script>
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function escapeJsString(str) {
                if (!str) return '';
                return String(str)
                    .replace(/\\/g, '\\\\')
                    .replace(/'/g, "\\'")
                    .replace(/"/g, '\\"')
                    .replace(/\n/g, '\\n')
                    .replace(/\r/g, '\\r');
            }

            (function initFeedbacks() {
                loadAdminFeedbacks();

                // Đăng ký SignalR lắng nghe khi có feedback mới gửi về
                if (typeof signalR !== 'undefined') {
                    try {
                        var fbHub = new signalR.HubConnectionBuilder().withUrl('/supportChatHub').withAutomaticReconnect().build();
                        fbHub.on('NewFeedbackSubmitted', function() {
                            loadAdminFeedbacks();
                        });
                        fbHub.start().then(function() {
                            fbHub.invoke('JoinStaffGroup');
                        }).catch(function(e) {});
                    } catch(e) {}
                }
            })();

            function loadAdminFeedbacks() {
                var ratingEl = document.getElementById('fbRatingFilter');
                var statusEl = document.getElementById('fbStatusFilter');
                var searchEl = document.getElementById('fbSearchInput');
                var rating = ratingEl ? ratingEl.value : '';
                var status = statusEl ? statusEl.value : '';
                var search = searchEl ? searchEl.value.trim() : '';

                var urlParams = new URLSearchParams(window.location.search);
                var branchId = urlParams.get('branchId') || '';

                var url = '/api/customercare/admin/feedbacks?rating=' + rating + '&status=' + encodeURIComponent(status) + '&search=' + encodeURIComponent(search) + '&branchId=' + branchId;

                fetch(url)
                    .then(res => {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(data => {
                        if (!data.success) return;
                        var elTotal = document.getElementById('fbTotal');
                        var elPending = document.getElementById('fbPending');
                        var elProcessed = document.getElementById('fbProcessed');
                        var elAvg = document.getElementById('fbAvg');

                        if (elTotal) elTotal.textContent = data.totalCount || 0;
                        if (elPending) elPending.textContent = data.pendingCount || 0;
                        if (elProcessed) elProcessed.textContent = data.processedCount || 0;
                        if (elAvg) elAvg.textContent = (data.avgRating || 5.0) + ' ⭐';

                        var tbody = document.getElementById('fbTableBody');
                        if (!tbody) return;

                        if (!data.feedbacks || data.feedbacks.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 24px; color: #888;">Chưa có đánh giá nào phù hợp với bộ lọc</td></tr>';
                            return;
                        }

                        var html = '';
                        data.feedbacks.forEach(function(f) {
                            var stars = '⭐'.repeat(f.rating || 5);
                            var statusBadge = f.status === 'Chờ xử lý' 
                                ? '<span class="status-dot" style="background: #e91e63; color: #fff; padding: 4px 10px; border-radius: 8px; font-size: 0.78rem; font-weight: 700;">Chờ xử lý</span>'
                                : '<span class="status-dot" style="background: #2e7d32; color: #fff; padding: 4px 10px; border-radius: 8px; font-size: 0.78rem; font-weight: 700;">Đã xử lý</span>';

                            var contactInfo = f.phoneOrEmail ? ('<small style="color:#666;">' + escapeHtml(f.phoneOrEmail) + '</small>') : '';

                            html += '<tr>';
                            html += '<td><strong>' + escapeHtml(f.customerName) + '</strong><br/>' + contactInfo + '</td>';
                            html += '<td><span style="color: #ff9800; font-weight: 700;">' + stars + '</span></td>';
                            html += '<td><span style="background:#f5f5f5; padding:3px 8px; border-radius:6px; font-size:0.82rem;">' + escapeHtml(f.category) + '</span></td>';
                            html += '<td>' + (f.productName ? escapeHtml(f.productName) : '—') + '</td>';
                            html += '<td><div style="font-weight: 500;">' + escapeHtml(f.content) + '</div>' + (f.adminResponse ? '<div style="margin-top:6px; background:#f9edf3; padding:6px 10px; border-radius:8px; font-size:0.82rem; color:#880e4f;">💬 <strong>Phản hồi:</strong> ' + escapeHtml(f.adminResponse) + '</div>' : '') + '</td>';
                            html += '<td>' + escapeHtml(f.createdAt) + '</td>';
                            html += '<td>' + statusBadge + '</td>';
                            html += '<td style="white-space: nowrap;">';
                            html += '<button type="button" style="padding: 4px 10px; margin-right: 4px; border-radius: 8px; border: 1px solid #d81b60; color: #d81b60; background: #fff; font-weight: 700; cursor: pointer; font-size:0.8rem;" onclick="openFbModal(' + f.id + ', \'' + escapeJsString(f.customerName) + '\', \'' + escapeJsString(f.adminResponse || '') + '\')">💬 Phản hồi</button>';
                            if (f.status === 'Chờ xử lý') {
                                html += '<button type="button" style="padding: 4px 10px; margin-right: 4px; border-radius: 8px; border: 1px solid #2e7d32; color: #2e7d32; background: #fff; font-weight: 700; cursor: pointer; font-size:0.8rem;" onclick="markFbProcessed(' + f.id + ')">✅ Đã xử lý</button>';
                            }
                            html += '<button type="button" style="padding: 4px 10px; border-radius: 8px; border: 1px solid #c62828; color: #c62828; background: #fff; font-weight: 700; cursor: pointer; font-size:0.8rem;" onclick="deleteFb(' + f.id + ')">🗑️ Xóa</button>';
                            html += '</td>';
                            html += '</tr>';
                        });
                        tbody.innerHTML = html;
                    })
                    .catch(function(err) {
                        console.error('[Feedback] error:', err);
                        var tbody = document.getElementById('fbTableBody');
                        if (tbody) {
                            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px; color: #888;">Chưa có đánh giá nào hoặc lỗi kết nối.</td></tr>';
                        }
                    });
            }

            function openFbModal(id, name, prevResponse) {
                document.getElementById('fbReplyId').value = id;
                document.getElementById('fbReplyCustomer').textContent = 'Đánh giá từ: ' + name;
                document.getElementById('fbReplyContent').value = prevResponse || '';
                document.getElementById('fbReplyModal').style.display = 'flex';
            }

            function closeFbModal() {
                document.getElementById('fbReplyModal').style.display = 'none';
            }

            function submitFbReply() {
                var id = document.getElementById('fbReplyId').value;
                var content = document.getElementById('fbReplyContent').value.trim();
                if (!content) { alert('Vui lòng nhập nội dung phản hồi'); return; }

                fetch('/api/customercare/admin/reply-feedback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ feedbackId: parseInt(id), response: content })
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        closeFbModal();
                        loadAdminFeedbacks();
                    }
                });
            }

            function markFbProcessed(id) {
                if (!confirm('Bạn có chắc muốn đánh dấu đánh giá này là Đã xử lý?')) return;
                fetch('/api/customercare/admin/mark-feedback-processed', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ feedbackId: parseInt(id) })
                }).then(res => res.json()).then(data => {
                    if (data.success) loadAdminFeedbacks();
                });
            }

            function deleteFb(id) {
                if (!confirm('Bạn có chắc chắn muốn XÓA đánh giá này?')) return;
                fetch('/api/customercare/admin/delete-feedback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ feedbackId: parseInt(id) })
                }).then(res => res.json()).then(data => {
                    if (data.success) loadAdminFeedbacks();
                });
            }
        </script>
    }
</section>
