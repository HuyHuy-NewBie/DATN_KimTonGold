@model IReadOnlyList<GoldManagementSystem.Models.ShiftAssignment>
@{
    ViewData["Title"] = "Ca làm của tôi";
}
<section class="management-page">
    <header class="management-hero"><div><p>HỘP THƯ CA LÀM</p><h1>Ca làm của tôi</h1><span>Lịch mới và mọi thay đổi đều được lưu tại đây.</span></div><a class="management-back" href="/">← Về bán hàng</a></header>
    <article class="management-card management-card--wide">
        <div class="management-table-wrap"><table class="management-table"><thead><tr><th>Ngày</th><th>Chi nhánh</th><th>Ca</th><th>In</th><th>Out</th><th>Trạng thái / ghi chú</th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.WorkShift.ShiftDate.ToString("dd/MM/yyyy")</td><td>@item.WorkShift.Branch.BranchName</td><td>@(item.WorkShift.ShiftType == "Morning" ? "08:00–16:00" : "16:00–00:00")</td><td>@(item.CheckedInAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td><td>@(item.CheckedOutAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td><td><strong>@item.AttendanceStatus?.Replace("|", " · ")</strong><small>@item.SystemNote</small></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6">Bạn chưa có ca làm nào.</td></tr> }
        </tbody></table></div>
    </article>
</section>
