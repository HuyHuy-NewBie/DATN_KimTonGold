@model GoldManagementSystem.Models.ViewModels.ProductionReportViewModel
@using GoldManagementSystem.Models
@{
    ViewData["Title"] = "Báo cáo chế tác";
}
<main class="production-page">
    <header class="production-hero"><div><p class="production-section__eyebrow">P2 · Báo cáo quản trị</p><h1>Hao hụt, WIP và giá vốn</h1></div><a class="production-button" asp-action="Index">Quay lại điều hành</a></header>
    <form method="get" class="production-filter"><input type="hidden" name="branchId" value="@Model.BranchId" /><label>Từ ngày <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></label><label>Đến ngày <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></label><button class="production-button production-button--primary" type="submit">Lọc báo cáo</button><a class="production-button" asp-action="ExportExcel" asp-route-branchId="@Model.BranchId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Excel</a><a class="production-button" asp-action="ExportPdf" asp-route-branchId="@Model.BranchId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">PDF</a></form>
    <section class="production-grid production-grid--kpis"><article class="production-kpi"><span>Số lệnh</span><strong>@Model.WorkOrderCount</strong></article><article class="production-kpi"><span>Đã đóng</span><strong>@Model.ClosedWorkOrderCount</strong></article><article class="production-kpi"><span>Đã xuất / đầu ra</span><strong>@Model.IssuedWeight.ToString("N4") / @Model.OutputWeight.ToString("N4") g</strong></article><article class="production-kpi"><span>Hao hụt / WIP</span><strong>@Model.LossWeight.ToString("N4") / @Model.WipWeight.ToString("N4") g</strong></article></section>
    <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Chi phí sản xuất</p><h2>Tổng hợp theo kỳ</h2></div></div><div class="production-grid production-grid--kpis"><article class="production-kpi"><span>Vật tư</span><strong>@Model.MaterialCost.ToString("N0") ₫</strong></article><article class="production-kpi"><span>Nhân công</span><strong>@Model.LaborCost.ToString("N0") ₫</strong></article><article class="production-kpi"><span>Overhead</span><strong>@Model.OverheadCost.ToString("N0") ₫</strong></article><article class="production-kpi"><span>Tổng giá vốn</span><strong>@Model.TotalCost.ToString("N0") ₫</strong></article></div></section>
    <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Chi tiết đối soát</p><h2>Theo từng lệnh sản xuất</h2></div></div><div class="production-table-wrap"><table class="production-table production-table--wide"><thead><tr><th>Lệnh / sản phẩm</th><th>Trạng thái</th><th>Đã xuất</th><th>Đầu ra</th><th>Hao hụt</th><th>WIP</th><th>Giá vốn</th></tr></thead><tbody>@foreach (var row in Model.Rows) { <tr><td><a asp-action="Trace" asp-route-id="@row.WorkOrderId">@row.WorkOrderCode</a><br /><small>@row.ProductName</small></td><td>@row.Status</td><td>@row.IssuedWeight.ToString("N4") g</td><td>@row.OutputWeight.ToString("N4") g</td><td>@row.LossWeight.ToString("N4") g</td><td>@row.WipWeight.ToString("N4") g</td><td>@row.TotalCost.ToString("N0") ₫</td></tr> }</tbody></table></div></section>
    <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Audit bất biến</p><h2>Nhật ký cân, QC và phê duyệt</h2></div></div><div class="production-table-wrap"><table class="production-table production-table--wide"><thead><tr><th>Thời gian</th><th>Thao tác</th><th>Đối tượng</th><th>Người thực hiện</th><th>Dữ liệu ghi nhận</th><th>Kết quả</th></tr></thead><tbody>@foreach (var log in Model.AuditLogs) { <tr><td>@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@log.Action</td><td>@log.EntityType @(log.EntityId.HasValue ? $"#{log.EntityId}" : string.Empty)</td><td>@(log.ActorUser?.FullName ?? log.ActorUser?.UserName ?? log.ActorUserId)</td><td><code>@log.Snapshot</code></td><td>@(log.Succeeded ? "Thành công" : "Thất bại")</td></tr> }</tbody></table></div></section>
</main>
