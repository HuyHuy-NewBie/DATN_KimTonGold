@model GoldManagementSystem.Models.ViewModels.ProductionTraceViewModel
@using GoldManagementSystem.Models
@{
    ViewData["Title"] = "Truy xuất vòng đời sản phẩm";
    string Weight(decimal value) => value.ToString("N4") + " g";
}
<main class="production-page">
    <header class="production-hero"><div><p class="production-section__eyebrow">Truy xuất toàn bộ vòng đời</p><h1>@Model.WorkOrder.WorkOrderCode</h1><p>@(Model.WorkOrder.Product?.Name ?? $"Sản phẩm #{Model.WorkOrder.ProductId}") · @(Model.WorkOrder.Workshop?.Name ?? "Chưa xác định")</p></div><a class="production-button" asp-action="Index" asp-route-activeTab="work-orders">Quay lại điều hành</a></header>
    <section class="production-grid production-grid--kpis">
        <article class="production-kpi"><span>Vật tư đã xuất</span><strong>@Weight(Model.WorkOrder.IssuedMaterialWeight)</strong></article>
        <article class="production-kpi"><span>Đầu ra</span><strong>@Weight(Model.WorkOrder.ActualOutputWeight)</strong></article>
        <article class="production-kpi"><span>Hao hụt</span><strong>@Weight(Model.WorkOrder.ActualLossWeight)</strong></article>
        <article class="production-kpi"><span>Tổng giá vốn</span><strong>@Model.WorkOrder.TotalCost.ToString("N0") ₫</strong></article>
    </section>
    @if (Model.CustomerCustody != null)
    {
        <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Bằng chứng tài sản khách</p><h2>Ảnh tiếp nhận và bàn giao</h2></div></div><div class="production-split"><form asp-action="UploadEvidence" method="post" enctype="multipart/form-data" class="production-form-grid"><input type="hidden" name="entityType" value="CustomerIntake" /><input type="hidden" name="entityId" value="@Model.CustomerCustody.CustomerJobOrderId" /><label class="production-field"><span>Ảnh tiếp nhận</span><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required /></label><button class="production-button production-button--primary" type="submit">Tải ảnh tiếp nhận</button></form><form asp-action="UploadEvidence" method="post" enctype="multipart/form-data" class="production-form-grid"><input type="hidden" name="entityType" value="CustomerHandover" /><input type="hidden" name="entityId" value="@Model.CustomerCustody.CustomerJobOrderId" /><label class="production-field"><span>Ảnh bàn giao</span><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required /></label><button class="production-button production-button--primary" type="submit">Tải ảnh bàn giao</button></form></div></section>
    }
    <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Lịch sử trạng thái</p><h2>Timeline nghiệp vụ</h2></div></div><div class="production-trace">@foreach (var item in Model.StatusHistories) { <div class="production-trace__item"><time>@item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</time><p><strong>@item.FromStatus → @item.ToStatus</strong><br />@item.Reason<br /><small>@(item.ChangedByUser?.FullName ?? item.ChangedByUser?.UserName ?? item.ChangedByUserId)</small></p></div> }</div></section>
    <section class="production-split">
        <article class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Vật tư</p><h2>Giữ, xuất và hoàn</h2></div></div><div class="production-table-wrap"><table class="production-table"><thead><tr><th>Lô</th><th>Đã giữ</th><th>Đã xuất</th><th>Đã hoàn</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model.Reservations) { <tr><td>@(item.RawMaterialLot?.LotCode ?? $"Lô #{item.RawMaterialLotId}")</td><td>@Weight(item.ReservedWeight)</td><td>@Weight(item.IssuedWeight)</td><td>@Weight(item.ReturnedWeight)</td><td>@item.Status</td></tr> }</tbody></table></div></article>
        <article class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Công đoạn</p><h2>Routing thực tế</h2></div></div><div class="production-table-wrap"><table class="production-table"><thead><tr><th>Thứ tự</th><th>Công đoạn</th><th>Vào</th><th>Ra</th><th>Thợ / trạng thái</th></tr></thead><tbody>@foreach (var item in Model.Operations) { <tr><td>@item.SequenceNumber</td><td>@item.OperationCode<br /><small>@item.OperationName</small></td><td>@Weight(item.InputWeight)</td><td>@Weight(item.OutputWeight)</td><td>@(item.WorkerUser?.FullName ?? item.WorkerUser?.UserName ?? item.WorkerUserId)<br />@item.Status</td></tr> }</tbody></table></div></article>
    </section>
    <section class="production-split">
        <article class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Hao hụt</p><h2>Biên bản và phê duyệt</h2></div></div><div class="production-table-wrap"><table class="production-table"><thead><tr><th>Thời gian</th><th>Loại</th><th>Khối lượng</th><th>Tỷ lệ / ngưỡng</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model.Losses) { <tr><td>@item.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.LossType</td><td>@Weight(item.LossWeight)</td><td>@item.LossRate.ToString("N4")% / @item.AllowedLossRateSnapshot.ToString("N4")%</td><td>@item.Status<br /><small>@item.ReviewNote</small></td></tr> }</tbody></table></div></article>
        <article class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Kiểm định</p><h2>QC và nhập kho</h2></div></div><div class="production-table-wrap"><table class="production-table"><thead><tr><th>Mã QC</th><th>Gross / Fine</th><th>Hàm lượng</th><th>Kết quả</th><th>Bằng chứng</th></tr></thead><tbody>@foreach (var item in Model.Inspections) { <tr><td>@item.InspectionCode</td><td>@Weight(item.MeasuredGrossWeight)<br />@Weight(item.MeasuredFineWeight)</td><td>@item.MeasuredPurityRate.ToString("P2")</td><td>@item.Result / @item.AppearanceResult</td><td>@if (!string.IsNullOrWhiteSpace(item.EvidenceUrl)) { <a href="@item.EvidenceUrl" target="_blank" rel="noopener">Mở ảnh</a> }<form asp-action="UploadEvidence" method="post" enctype="multipart/form-data" class="production-inline-form"><input type="hidden" name="entityType" value="QualityInspection" /><input type="hidden" name="entityId" value="@item.Id" /><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required /><button class="production-button" type="submit">Gắn ảnh QC</button></form></td></tr> }</tbody></table></div>@if (Model.Receipt != null) { <p class="production-note">Phiếu nhập: <strong>@Model.Receipt.ReceiptCode</strong> · @Weight(Model.Receipt.GrossWeight) · @Model.Receipt.TotalCost.ToString("N0") ₫</p> }</article>
    </section>
    @if (Model.CustomerCustody != null) { <section class="production-section"><div class="production-section__header"><div><p class="production-section__eyebrow">Tài sản khách hàng</p><h2>Sổ bàn giao tách biệt</h2></div></div><p>Đầu vào: @Weight(Model.CustomerCustody.InputGrossWeight) · Đã giao xưởng: @Weight(Model.CustomerCustody.IssuedGrossWeight) · Đầu ra: @Weight(Model.CustomerCustody.OutputGrossWeight) · Đã trả: @Weight(Model.CustomerCustody.ReturnedGrossWeight)</p><p>Vị trí: @Model.CustomerCustody.StorageLocation · Trạng thái: @Model.CustomerCustody.Status</p></section> }
</main>
